---
import BaseLayout from '../layouts/BaseLayout.astro';

const audience = [
  ['factory','مصنع غذائي','Food Manufacturer','لديك منتج قائم وتريد مناقشة إمكانية التعامل معه في قطر.','You have an established product and want to discuss its potential in Qatar.'],
  ['package','مالك علامة غذائية','Food Brand Owner','تريد مناقشة منتج أو فئة لفرصة مناسبة في السوق القطري.','You want to discuss a product or category for a suitable Qatar opportunity.'],
  ['truck','مورد أو مُصدّر','Supplier or Exporter','لديك منتجات غذائية ومعلومات واضحة عنها وتبحث عن نقاش تجاري في قطر.','You have food products with clear information and want a commercial discussion in Qatar.'],
  ['globe-2','فريق مبيعات دولية','International Sales Team','تمثل مصنعًا أو علامة وتريد الوصول للطرف التجاري المناسب لمناقشة المنتج.','You represent a manufacturer or brand and want to reach the right commercial contact.'],
];

const prepareItems = [
  ['building-2','الشركة أو المصنع','Company / Manufacturer','اسم الشركة أو المصنع أو العلامة، والدولة التي تعمل منها.','Company, manufacturer or brand name and the country you operate from.'],
  ['package','المنتج والفئة','Product & Category','اسم المنتج أو نوعه، والفئة الغذائية التي ينتمي إليها.','Product name or type and its food category.'],
  ['messages-square','ما الذي تريد مناقشته؟','What Do You Want to Discuss?','دخول المنتج إلى قطر، الاستيراد والتجارة، البيع والتوزيع، أو نقاش تجاري آخر مرتبط بالمنتج.','Product entry into Qatar, import and trading, sales and distribution, or another product-related discussion.'],
  ['file-text','ملخص واضح','Clear Summary','حالة المنتج الحالية، ما هو متاح من معلومات، وما الذي تتوقع مناقشته في البداية.','Current product status, available information and what you expect to discuss initially.'],
];

const afterSteps = [
  ['search-check','نفهم الشركة والمنتج','Understand the Company & Product','نراجع المعلومات الأساسية عن الجهة والمنتج والفئة.','We review the basic information about the company, product and category.'],
  ['badge-check','نراجع ملاءمة الفرصة','Review the Opportunity Fit','ننظر إلى ما إذا كانت الفرصة مناسبة لنطاق عمل تارقت والسوق القطري.','We look at whether the opportunity fits TARGET’s scope and the Qatar market.'],
  ['messages-square','نناقش الخطوة التالية عند وجود ملاءمة','Discuss the Next Step Where There Is a Fit','إذا كانت هناك أرضية مناسبة للنقاش، يمكن الانتقال لتفاصيل تجارية إضافية حسب طبيعة الفرصة.','Where there is a suitable basis, we can move into further commercial details.'],
];

const clarityItems = [
  ['file-check-2','لا قبول تلقائي','No Automatic Acceptance','إرسال النموذج لا يعني قبول المنتج أو الموافقة على التعامل معه.','Submitting the form does not mean the product is accepted or approved for commercial handling.'],
  ['shield-check','لا وكالة أو حصرية تلقائية','No Automatic Agency or Exclusivity','لا تنشأ وكالة أو حصرية أو صفة تمثيل رسمي إلا باتفاق موثق وصريح.','Agency, exclusivity or official representation exists only through explicit documented agreement.'],
  ['clipboard-check','الاتفاق قبل التنفيذ','Agreement Before Execution','الأسعار والكميات والشروط ونطاق العمل تُحدد قبل أي تنفيذ فعلي.','Pricing, quantities, terms and scope are defined before any execution.'],
  ['route','لا وعود بنتائج السوق','No Guaranteed Market Outcomes','لا نعد بمبيعات أو تغطية أو منافذ أو نمو غير موثق.','We do not promise undocumented sales, coverage, listings or growth outcomes.'],
];
---
<BaseLayout active="suppliers" bodyClass="page-suppliers premium-v8-page" title="للموردين | TARGET" description="للمصنعين والموردين والعلامات الغذائية الراغبة في مناقشة فرصة منتج في السوق القطري.">
  <section class="fs-hero">
    <div class="container fs-hero-grid">
      <div class="fs-hero-copy">
        <span class="fs-eyebrow"><i data-lucide="factory"></i><span data-ar="للمصنعين والموردين والعلامات الغذائية" data-en="For Manufacturers, Suppliers & Food Brands">للمصنعين والموردين والعلامات الغذائية</span></span>
        <h1 data-ar="هل لديك منتج غذائي وتريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">هل لديك منتج غذائي وتريد مناقشة فرصته في قطر؟</h1>
        <p data-ar="شاركنا معلومات واضحة عن شركتك أو المصنع، المنتج والفئة، وما الذي تريد مناقشته في السوق القطري. نراجع المعلومات أولًا قبل أي نقاش أو التزام تجاري." data-en="Share clear information about your company or manufacturing business, the product and category, and what you want to discuss for Qatar. We review the information first before any commercial discussion or commitment.">شاركنا معلومات واضحة عن شركتك أو المصنع، المنتج والفئة، وما الذي تريد مناقشته في السوق القطري. نراجع المعلومات أولًا قبل أي نقاش أو التزام تجاري.</p>
        <div class="fs-actions">
          <a class="fs-primary" href="#product-review"><i data-lucide="send"></i><span data-ar="أرسل بيانات المنتج" data-en="Submit Product Details">أرسل بيانات المنتج</span></a>
          <a class="fs-secondary" href="qatar-market.html"><span data-ar="تعرف على السوق القطري" data-en="Explore the Qatar Market">تعرف على السوق القطري</span><i data-lucide="arrow-left"></i></a>
        </div>
      </div>
      <figure class="fs-hero-media">
        <img src="/images/home-food-trade-hero-v1.png" alt="تجهيز وتعبئة منتجات غذائية" data-ar-alt="تجهيز وتعبئة منتجات غذائية" data-en-alt="Food products being prepared and packaged" width="1400" height="1120" loading="eager" decoding="async" />
        <figcaption>
          <span><i data-lucide="factory"></i><b data-ar="مصنع أو مورد" data-en="Manufacturer or Supplier">مصنع أو مورد</b></span>
          <span><i data-lucide="package"></i><b data-ar="منتج واضح" data-en="Clear Product">منتج واضح</b></span>
          <span><i data-lucide="map-pinned"></i><b data-ar="فرصة في قطر" data-en="Qatar Opportunity">فرصة في قطر</b></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="fs-section fs-audience">
    <div class="container">
      <header class="fs-section-head">
        <span class="fs-kicker" data-ar="هل هذه الصفحة مناسبة لك؟" data-en="Is This the Right Page for You?">هل هذه الصفحة مناسبة لك؟</span>
        <h2 data-ar="هذه الصفحة للجهات التي تريد مناقشة منتج أو فرصة تجارية مرتبطة بمنتج غذائي في قطر." data-en="This page is for businesses that want to discuss a food product or product-related commercial opportunity in Qatar.">هذه الصفحة للجهات التي تريد مناقشة منتج أو فرصة تجارية مرتبطة بمنتج غذائي في قطر.</h2>
      </header>
      <div class="fs-audience-grid">
        {audience.map(([icon,ar,en,arBody,enBody],index) => <article><span class="fs-index">0{index+1}</span><span class="fs-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div></article>)}
      </div>
      <div class="fs-general-note"><i data-lucide="circle-help"></i><p><span data-ar="إذا كان استفسارك عامًا، أو متعلقًا بالمبيعات المحلية أو المستندات أو موضوع غير متعلق بعرض منتج، استخدم صفحة " data-en="For general enquiries, local sales, documents or matters unrelated to submitting a product, use ">إذا كان استفسارك عامًا، أو متعلقًا بالمبيعات المحلية أو المستندات أو موضوع غير متعلق بعرض منتج، استخدم صفحة </span><a href="contact.html" data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</a>.</p></div>
    </div>
  </section>

  <section class="fs-section fs-prepare">
    <div class="container fs-prepare-grid">
      <div class="fs-prepare-copy">
        <span class="fs-kicker" data-ar="قبل إرسال الطلب" data-en="Before You Submit">قبل إرسال الطلب</span>
        <h2 data-ar="جهّز المعلومات الأساسية التي تساعدنا على فهم المنتج والفرصة." data-en="Prepare the basic information that helps us understand the product and opportunity.">جهّز المعلومات الأساسية التي تساعدنا على فهم المنتج والفرصة.</h2>
        <div class="fs-checklist">
          {prepareItems.map(([icon,ar,en,arBody,enBody],index) => <article><span class="fs-index">0{index+1}</span><span class="fs-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div></article>)}
        </div>
        <p class="fs-support-note" data-ar="لا نطلب في هذه المرحلة ملفًا قانونيًا كاملًا أو تعهدات أو مستندات غير ضرورية. إذا احتاج النقاش معلومات إضافية، تُطلب لاحقًا حسب طبيعة الفرصة." data-en="We do not require a full legal file or unnecessary documentation at this initial stage. Additional information may be requested later depending on the opportunity.">لا نطلب في هذه المرحلة ملفًا قانونيًا كاملًا أو تعهدات أو مستندات غير ضرورية. إذا احتاج النقاش معلومات إضافية، تُطلب لاحقًا حسب طبيعة الفرصة.</p>
      </div>
      <figure class="fs-prepare-media">
        <img src="/images/home-food-trade-editorial-v1.png" alt="منتجات غذائية وتعبئة جاهزة للمراجعة" data-ar-alt="منتجات غذائية وتعبئة جاهزة للمراجعة" data-en-alt="Packaged food products prepared for review" width="1200" height="900" loading="lazy" decoding="async" />
        <figcaption><i data-lucide="clipboard-list"></i><span data-ar="ابدأ بمعلومات أساسية واضحة — والتفاصيل الإضافية تأتي عند الحاجة." data-en="Start with clear basic information — additional detail can follow when needed.">ابدأ بمعلومات أساسية واضحة — والتفاصيل الإضافية تأتي عند الحاجة.</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="fs-section fs-form-section" id="product-review">
    <div class="container fs-form-layout">
      <form class="contact-form fs-form" data-target-form novalidate>
        <div class="fs-form-head">
          <div>
            <span class="fs-kicker" data-ar="طلب مراجعة منتج" data-en="Product Review Request">طلب مراجعة منتج</span>
            <h2 data-ar="عرّفنا بالشركة والمنتج والفرصة التي تريد مناقشتها." data-en="Tell us about the company, product and opportunity you want to discuss.">عرّفنا بالشركة والمنتج والفرصة التي تريد مناقشتها.</h2>
            <p data-ar="الحقول التالية تساعدنا على فهم الطلب قبل أي متابعة. إرسال النموذج لا يعني قبول المنتج أو الموافقة على الاستيراد أو التوزيع." data-en="These fields help us understand the enquiry before any follow-up. Submitting the form does not mean product acceptance or approval for import or distribution.">الحقول التالية تساعدنا على فهم الطلب قبل أي متابعة. إرسال النموذج لا يعني قبول المنتج أو الموافقة على الاستيراد أو التوزيع.</p>
          </div>
          <span class="fs-form-icon"><i data-lucide="clipboard-list"></i></span>
        </div>
        <div class="validation-summary" data-validation-summary role="alert" aria-live="assertive" data-ar="يرجى مراجعة الحقول المحددة أدناه." data-en="Please review the highlighted fields below.">يرجى مراجعة الحقول المحددة أدناه.</div>
        <div class="fs-form-grid">
          <div class="fs-field"><label for="supplier-name" data-ar="الاسم *" data-en="Name *">الاسم *</label><input class="form-control" id="supplier-name" name="name" autocomplete="name" required data-ar-placeholder="الاسم الكامل" data-en-placeholder="Full name" placeholder="الاسم الكامل" /></div>
          <div class="fs-field"><label for="supplier-company" data-ar="الشركة أو العلامة *" data-en="Company or Brand *">الشركة أو العلامة *</label><input class="form-control" id="supplier-company" name="company" autocomplete="organization" required data-ar-placeholder="اسم الشركة أو العلامة" data-en-placeholder="Company or brand name" placeholder="اسم الشركة أو العلامة" /></div>
          <div class="fs-field"><label for="supplier-country" data-ar="الدولة *" data-en="Country *">الدولة *</label><input class="form-control" id="supplier-country" name="country" autocomplete="country-name" required data-ar-placeholder="الدولة" data-en-placeholder="Country" placeholder="الدولة" /></div>
          <div class="fs-field"><label for="supplier-email" data-ar="البريد التجاري *" data-en="Business Email *">البريد التجاري *</label><input class="form-control" type="email" id="supplier-email" name="email" autocomplete="email" required placeholder="name@company.com" /></div>
          <div class="fs-field"><label for="supplier-phone" data-ar="الهاتف أو WhatsApp — اختياري" data-en="Phone or WhatsApp — Optional">الهاتف أو WhatsApp — اختياري</label><input class="form-control" type="tel" id="supplier-phone" name="phone" autocomplete="tel" data-ar-placeholder="اختياري" data-en-placeholder="Optional" placeholder="اختياري" /></div>
          <div class="fs-field"><label for="supplier-category" data-ar="المنتج أو الفئة *" data-en="Product or Category *">المنتج أو الفئة *</label><input class="form-control" id="supplier-category" name="product" required data-ar-placeholder="مثال: شاي، عصائر، عسل أو أغذية مجمدة" data-en-placeholder="e.g. Tea, juices, honey or frozen food" placeholder="مثال: شاي، عصائر، عسل أو أغذية مجمدة" /></div>
          <div class="fs-field fs-field-wide"><label for="supplier-opportunity" data-ar="موضوع النقاش *" data-en="Discussion Type *">موضوع النقاش *</label><select class="form-select" id="supplier-opportunity" name="opportunity" required><option value="" selected disabled data-ar="اختر موضوع النقاش" data-en="Select discussion type">اختر موضوع النقاش</option><option value="product-entry-qatar" data-ar="دخول المنتج إلى السوق القطري" data-en="Product Entry into Qatar">دخول المنتج إلى السوق القطري</option><option value="import-trading" data-ar="الاستيراد والتجارة" data-en="Import & Trading">الاستيراد والتجارة</option><option value="sales-distribution" data-ar="البيع والتوزيع" data-en="Sales & Distribution">البيع والتوزيع</option><option value="other-product-commercial" data-ar="مناقشة تجارية أخرى مرتبطة بالمنتج" data-en="Other Product-Related Commercial Discussion">مناقشة تجارية أخرى مرتبطة بالمنتج</option></select></div>
          <div class="fs-field fs-field-wide"><label for="supplier-summary" data-ar="ملخص المنتج والفرصة *" data-en="Product & Opportunity Summary *">ملخص المنتج والفرصة *</label><textarea class="form-control" id="supplier-summary" name="summary" required minlength="30" maxlength="700" data-ar-placeholder="اذكر المنتج، الفئة، وضعه الحالي وما الذي تريد مناقشته في قطر." data-en-placeholder="Describe the product, category, current status and what you want to discuss in Qatar." placeholder="اذكر المنتج، الفئة، وضعه الحالي وما الذي تريد مناقشته في قطر."></textarea><small data-ar="30–700 حرف تقريبًا. ركز على المنتج والفرصة التي تريد مناقشتها." data-en="Approximately 30–700 characters. Focus on the product and the opportunity you want to discuss.">30–700 حرف تقريبًا. ركز على المنتج والفرصة التي تريد مناقشتها.</small></div>
          <div class="fs-field-wide privacy-check"><input class="form-check-input" type="checkbox" id="supplier-privacy" required /><label for="supplier-privacy"><span data-ar="أوافق على استخدام هذه المعلومات لمراجعة الطلب وفق " data-en="I agree to the use of this information to review the request in accordance with the ">أوافق على استخدام هذه المعلومات لمراجعة الطلب وفق </span><a href="privacy.html" data-ar="سياسة الخصوصية" data-en="Privacy Policy">سياسة الخصوصية</a>.</label></div>
          <div class="fs-field-wide"><button class="fs-submit" type="submit"><i data-lucide="send"></i><span data-ar="إرسال طلب المراجعة" data-en="Submit for Review">إرسال طلب المراجعة</span></button></div>
        </div>
        <div class="form-success" data-form-success tabindex="-1" role="status" aria-live="polite"><span class="icon-inline"><i data-lucide="circle-check-big"></i><span data-ar="تم استلام طلبك للمراجعة. إذا كانت المعلومات مناسبة لمناقشة إضافية، قد يتواصل فريق تارقت معك عبر بيانات التواصل التي أرسلتها." data-en="Your request has been received for review. If the information is suitable for further discussion, TARGET may contact you using the details submitted.">تم استلام طلبك للمراجعة. إذا كانت المعلومات مناسبة لمناقشة إضافية، قد يتواصل فريق تارقت معك عبر بيانات التواصل التي أرسلتها.</span></span></div>
      </form>

      <aside class="fs-after" aria-labelledby="after-title">
        <span class="fs-kicker" data-ar="بعد الإرسال" data-en="After You Submit">بعد الإرسال</span>
        <h2 id="after-title" data-ar="نراجع المعلومات قبل أن ننتقل لأي نقاش تجاري." data-en="We review the information before moving into any commercial discussion.">نراجع المعلومات قبل أن ننتقل لأي نقاش تجاري.</h2>
        <div class="fs-after-steps">
          {afterSteps.map(([icon,ar,en,arBody,enBody],index) => <article><span class="fs-step-number">0{index+1}</span><span class="fs-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div></article>)}
        </div>
        <div class="fs-after-note"><i data-lucide="shield-check"></i><strong data-ar="الإرسال يبدأ المراجعة — ولا ينشئ التزامًا تجاريًا." data-en="Submission starts a review — it does not create a commercial commitment.">الإرسال يبدأ المراجعة — ولا ينشئ التزامًا تجاريًا.</strong></div>
      </aside>
    </div>
  </section>

  <section class="fs-section fs-clarity">
    <div class="container">
      <div class="fs-clarity-panel">
        <header>
          <span class="fs-kicker" data-ar="وضوح قبل الالتزام" data-en="Clarity Before Commitment">وضوح قبل الالتزام</span>
          <h2 data-ar="إرسال المنتج يفتح باب المراجعة — ولا ينشئ التزامًا تجاريًا." data-en="Submitting a product starts a review — it does not create a commercial commitment.">إرسال المنتج يفتح باب المراجعة — ولا ينشئ التزامًا تجاريًا.</h2>
        </header>
        <div class="fs-clarity-list">
          {clarityItems.map(([icon,ar,en,arBody,enBody]) => <article><span class="fs-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div></article>)}
        </div>
      </div>
    </div>
  </section>

  <section class="fs-final">
    <div class="container">
      <div class="fs-final-panel">
        <div><span class="fs-kicker" data-ar="الخطوة التالية" data-en="Next Step">الخطوة التالية</span><h2 data-ar="جاهز لمناقشة المنتج؟" data-en="Ready to discuss the product?">جاهز لمناقشة المنتج؟</h2><p data-ar="ابدأ بإرسال بيانات المنتج. وإذا كان استفسارك عامًا، استخدم قناة الاتصال المناسبة." data-en="Start by submitting the product details. For a general enquiry, use the appropriate contact route.">ابدأ بإرسال بيانات المنتج. وإذا كان استفسارك عامًا، استخدم قناة الاتصال المناسبة.</p></div>
        <div class="fs-final-actions"><a class="fs-final-primary" href="#product-review"><i data-lucide="send"></i><span data-ar="إرسال بيانات المنتج" data-en="Submit Product Details">إرسال بيانات المنتج</span></a><a class="fs-final-secondary" href="contact.html"><span data-ar="لديك استفسار عام؟ تواصل معنا" data-en="Have a general enquiry? Contact Us">لديك استفسار عام؟ تواصل معنا</span></a></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
.page-suppliers{background:var(--target-cream,#F4EDE4)}
.fs-hero{position:relative;overflow:hidden;padding-block:88px 96px;background:radial-gradient(circle at 8% 18%,rgba(12,73,49,.055),transparent 24%),linear-gradient(135deg,rgba(192,149,82,.045) 25%,transparent 25%) 0 0/56px 56px,var(--target-cream)}
