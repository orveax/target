---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout active="suppliers" bodyClass="page-suppliers premium-v8-page" title="للموردين | TARGET">
  <section class="premium-page-hero portfolio-hero">
    <div class="premium-page-hero-overlay"></div>
    <div class="container premium-page-hero-content">
      <div class="hero-kicker"><i data-lucide="factory"></i><span data-ar="للموردين والمصنعين" data-en="For Suppliers & Manufacturers">للموردين والمصنعين</span></div>
      <h1 data-ar="اعرض منتجك للسوق القطري بطريقة منظمة" data-en="Present your product to the Qatar market with clarity">اعرض منتجك للسوق القطري بطريقة منظمة</h1>
      <p data-ar="أرسل ملخصًا واضحًا عن شركتك ومنتجك وفرصة التعاون. نراجع المعلومات قبل أي نقاش تجاري، ولا يعني الإرسال قبولًا أو توزيعًا أو التزامًا تلقائيًا." data-en="Share a clear summary of your company, product and opportunity. We review the information before any commercial discussion; submission does not mean acceptance, distribution or an automatic commitment.">أرسل ملخصًا واضحًا عن شركتك ومنتجك وفرصة التعاون. نراجع المعلومات قبل أي نقاش تجاري، ولا يعني الإرسال قبولًا أو توزيعًا أو التزامًا تلقائيًا.</p>
    </div>
  </section>
  <section class="section t5-supplier-section">
    <div class="container t5-two-column">
      <form class="contact-form t5-form" data-target-form novalidate>
        <div class="t5-form-head"><div><div class="kicker" data-ar="طلب مراجعة منتج" data-en="Product Review Request">طلب مراجعة منتج</div><h2 data-ar="عرّفنا بالفرصة" data-en="Tell us about the opportunity">عرّفنا بالفرصة</h2><p data-ar="الحقول المطلوبة تساعدنا على فهم المنتج والجهة قبل المتابعة." data-en="The required fields help us understand the product and company before any follow-up.">الحقول المطلوبة تساعدنا على فهم المنتج والجهة قبل المتابعة.</p></div><span class="icon-tile"><i data-lucide="clipboard-pen-line"></i></span></div>
        <div class="validation-summary" data-validation-summary role="alert" aria-live="assertive" data-ar="يرجى مراجعة الحقول المحددة أدناه." data-en="Please review the highlighted fields below.">يرجى مراجعة الحقول المحددة أدناه.</div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="supplier-name" data-ar="الاسم *" data-en="Name *">الاسم *</label><input class="form-control" id="supplier-name" name="name" autocomplete="name" required data-ar-placeholder="الاسم الكامل" data-en-placeholder="Full name" placeholder="الاسم الكامل"></div>
          <div class="col-md-6"><label class="form-label" for="supplier-company" data-ar="الشركة أو العلامة *" data-en="Company or Brand *">الشركة أو العلامة *</label><input class="form-control" id="supplier-company" name="company" autocomplete="organization" required data-ar-placeholder="اسم الشركة أو العلامة" data-en-placeholder="Company or brand name" placeholder="اسم الشركة أو العلامة"></div>
          <div class="col-md-6"><label class="form-label" for="supplier-country" data-ar="الدولة *" data-en="Country *">الدولة *</label><input class="form-control" id="supplier-country" name="country" autocomplete="country-name" required data-ar-placeholder="الدولة" data-en-placeholder="Country" placeholder="الدولة"></div>
          <div class="col-md-6"><label class="form-label" for="supplier-email" data-ar="البريد التجاري *" data-en="Business email *">البريد التجاري *</label><input class="form-control" type="email" id="supplier-email" name="email" autocomplete="email" required placeholder="name@company.com"></div>
          <div class="col-md-6"><label class="form-label" for="supplier-phone" data-ar="الهاتف أو WhatsApp" data-en="Phone or WhatsApp">الهاتف أو WhatsApp</label><input class="form-control" type="tel" id="supplier-phone" name="phone" autocomplete="tel" data-ar-placeholder="اختياري" data-en-placeholder="Optional" placeholder="اختياري"></div>
          <div class="col-md-6"><label class="form-label" for="supplier-category" data-ar="المنتج أو الفئة *" data-en="Product or category *">المنتج أو الفئة *</label><input class="form-control" id="supplier-category" name="product" required data-ar-placeholder="مثال: شاي، عصائر أو أغذية مجمدة" data-en-placeholder="e.g. Tea, juices or frozen food" placeholder="مثال: شاي، عصائر أو أغذية مجمدة"></div>
          <div class="col-md-6"><label class="form-label" for="supplier-opportunity" data-ar="نوع الفرصة *" data-en="Opportunity type *">نوع الفرصة *</label><select class="form-select" id="supplier-opportunity" name="opportunity" required><option value="" selected disabled data-ar="اختر نوع الفرصة" data-en="Select opportunity type">اختر نوع الفرصة</option><option value="market-entry" data-ar="دخول السوق القطري" data-en="Qatar market entry">دخول السوق القطري</option><option value="distribution" data-ar="تطوير توزيع" data-en="Distribution development">تطوير توزيع</option><option value="partnership" data-ar="شراكة تجارية" data-en="Commercial partnership">شراكة تجارية</option><option value="other" data-ar="أخرى" data-en="Other">أخرى</option></select></div>
          <div class="col-12"><label class="form-label" for="supplier-summary" data-ar="ملخص المنتج والفرصة *" data-en="Product and opportunity summary *">ملخص المنتج والفرصة *</label><textarea class="form-control" id="supplier-summary" name="summary" required minlength="30" maxlength="700" data-ar-placeholder="اذكر المنتج، الفئة، وضعه الحالي وما الذي تبحث عنه في السوق القطري." data-en-placeholder="Describe the product, category, current status and what you seek in the Qatar market." placeholder="اذكر المنتج، الفئة، وضعه الحالي وما الذي تبحث عنه في السوق القطري."></textarea></div>
          <div class="col-12"><div class="privacy-check"><input class="form-check-input" type="checkbox" id="supplier-privacy" required><label for="supplier-privacy" class="small"><span data-ar="أوافق على استخدام البيانات لمراجعة هذا الطلب وفق " data-en="I agree to the use of this information to review this request under the ">أوافق على استخدام البيانات لمراجعة هذا الطلب وفق </span><a href="privacy.html" data-ar="سياسة الخصوصية" data-en="Privacy Policy">سياسة الخصوصية</a>.</label></div></div>
          <div class="col-12"><button class="btn-premium btn-primary-premium" type="submit"><i data-lucide="send"></i><span data-ar="إرسال طلب المراجعة" data-en="Submit for Review">إرسال طلب المراجعة</span></button></div>
        </div>
        <div class="form-success" data-form-success tabindex="-1" role="status" aria-live="polite"><span class="icon-inline"><i data-lucide="circle-check-big"></i><span data-ar="تم التحقق من النموذج في نسخة الاختبار. سيُربط الإرسال النهائي بمسار partners@targetft.com في مرحلة التكامل." data-en="The form is validated in this test build. Final submission will be connected to partners@targetft.com during integration.">تم التحقق من النموذج في نسخة الاختبار. سيُربط الإرسال النهائي بمسار partners@targetft.com في مرحلة التكامل.</span></span></div>
      </form>
      <aside class="t5-route-card"><div class="kicker" data-ar="ماذا يحدث بعد الإرسال؟" data-en="What happens next?">ماذا يحدث بعد الإرسال؟</div><h2 data-ar="نراجع قبل أن نلتزم" data-en="We review before commitment">نراجع قبل أن نلتزم</h2><ol><li data-ar="نفهم الشركة والمنتج والفئة." data-en="We understand the company, product and category.">نفهم الشركة والمنتج والفئة.</li><li data-ar="نقيّم مدى ملاءمة الفرصة للسوق." data-en="We assess the opportunity’s market fit.">نقيّم مدى ملاءمة الفرصة للسوق.</li><li data-ar="نناقش نموذج التعاون المناسب عند وجود أساس واضح." data-en="We discuss the appropriate cooperation model when there is a clear basis.">نناقش نموذج التعاون المناسب عند وجود أساس واضح.</li></ol><p data-ar="لا يمثل الإرسال وكالة أو حصرية أو قبولًا للمنتج." data-en="Submission does not constitute agency, exclusivity or acceptance of the product.">لا يمثل الإرسال وكالة أو حصرية أو قبولًا للمنتج.</p></aside>
    </div>
  </section>
</BaseLayout>
