---
import BaseLayout from '../layouts/BaseLayout.astro';

const toc = [
  ['scope','01','النطاق والجهة المسؤولة','Scope & Responsible Entity'],
  ['collect','02','البيانات التي قد نجمعها','Information We May Collect'],
  ['how','03','كيفية جمع البيانات','How Information Is Collected'],
  ['use','04','أغراض الاستخدام','Purposes of Use'],
  ['consent','05','الموافقة والغرض المشروع','Consent & Lawful Purpose'],
  ['sharing','06','الوصول إلى البيانات ومقدمو الخدمات','Access, Sharing & Service Providers'],
  ['retention','07','الاحتفاظ بالبيانات','Data Retention'],
  ['security','08','أمن المعلومات','Information Security'],
  ['rights','09','حقوق الأفراد والطلبات','Individual Rights & Requests'],
  ['cookies','10','ملفات الارتباط والتحليلات والتحديثات','Cookies, Analytics & Policy Updates'],
];
---
<BaseLayout active="privacy" bodyClass="page-privacy premium-v8-page" title="سياسة الخصوصية | TARGET For Food Trading" description="توضح سياسة الخصوصية كيفية تعامل تارقت لتجارة الأغذية مع البيانات الشخصية المقدمة عبر الموقع وقنوات التواصل الرسمية.">
  <section class="privacy-hero">
    <div class="container privacy-hero-grid">
      <div class="privacy-hero-copy">
        <span class="privacy-eyebrow"><i data-lucide="shield-check"></i><span data-ar="الخصوصية والبيانات" data-en="Privacy & Data">الخصوصية والبيانات</span></span>
        <h1 data-ar="سياسة الخصوصية" data-en="Privacy Policy">سياسة الخصوصية</h1>
        <p data-ar="توضح هذه السياسة كيفية تعامل تارقت لتجارة الأغذية مع البيانات الشخصية التي يقدمها زوار الموقع أو يرسلونها عبر قنوات التواصل المعتمدة." data-en="This Policy explains how Target For Food Trading handles personal information submitted through the website or approved contact channels.">توضح هذه السياسة كيفية تعامل تارقت لتجارة الأغذية مع البيانات الشخصية التي يقدمها زوار الموقع أو يرسلونها عبر قنوات التواصل المعتمدة.</p>
        <div class="privacy-hero-utility">
          <a href="contact.html"><i data-lucide="mail"></i><span data-ar="اتصل بنا" data-en="Contact Us">اتصل بنا</span></a>
        </div>
      </div>

      <div class="privacy-visual" aria-label="Privacy information graphic">
        <article class="privacy-document">
          <div class="privacy-document-brand">
            <img src="/assets/brand/target-logo-horizontal-forest.svg" alt="TARGET — تارقت لتجارة الأغذية" width="420" height="130" />
            <span class="privacy-document-badge"><i data-lucide="file-lock"></i></span>
          </div>
          <div class="privacy-document-copy">
            <span>PRIVACY & DATA</span>
            <strong data-ar="بيانات واضحة. استخدام محدد. حماية مناسبة." data-en="Clear data. Defined use. Appropriate protection.">بيانات واضحة. استخدام محدد. حماية مناسبة.</strong>
            <p data-ar="سياسة موجهة لبيانات التواصل ومراجعة المنتجات والقنوات الرسمية المرتبطة بالموقع." data-en="A policy focused on enquiry data, product-review submissions and the website's official communication channels.">سياسة موجهة لبيانات التواصل ومراجعة المنتجات والقنوات الرسمية المرتبطة بالموقع.</p>
          </div>
          <div class="privacy-document-icons" aria-hidden="true">
            <span><i data-lucide="shield-check"></i></span>
            <span><i data-lucide="user-round-check"></i></span>
            <span><i data-lucide="file-lock-2"></i></span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="privacy-meta-strip">
    <div class="container privacy-meta-row">
      <div class="privacy-meta-item"><i data-lucide="globe-2"></i><span data-ar="الموقع" data-en="Website">الموقع</span><strong>targetft.com</strong></div>
      <div class="privacy-meta-item"><i data-lucide="mail"></i><span data-ar="طلبات الخصوصية" data-en="Privacy Requests">طلبات الخصوصية</span><strong>info@targetft.com</strong></div>
    </div>
  </section>

  <section class="privacy-main">
    <div class="container privacy-layout">
      <aside class="privacy-toc" aria-label="Privacy policy sections">
        <div class="privacy-toc-title"><i data-lucide="list"></i><span data-ar="في هذه الصفحة" data-en="On This Page">في هذه الصفحة</span></div>
        <nav>
          {toc.map(([id,num,ar,en]) => <a href={`#${id}`} data-num={num} data-ar={ar} data-en={en}>{ar}</a>)}
        </nav>
      </aside>

      <article class="privacy-reading">
        <header class="privacy-reading-intro">
          <span class="privacy-kicker" data-ar="سياسة الموقع" data-en="Website Policy">سياسة الموقع</span>
          <h2 data-ar="كيف نتعامل مع البيانات التي ترسلها إلينا." data-en="How we handle the information you send to us.">كيف نتعامل مع البيانات التي ترسلها إلينا.</h2>
          <p data-ar="تطبق هذه السياسة على المعلومات التي تُقدَّم من خلال موقع تارقت أو قنوات التواصل الرسمية المرتبطة به. لا تضيف هذه الصفحة فئات بيانات أو أدوات تتبع غير مستخدمة فعليًا." data-en="This Policy applies to information submitted through the TARGET website or its related official communication channels. It does not add data categories or tracking tools that are not actually in use.">تطبق هذه السياسة على المعلومات التي تُقدَّم من خلال موقع تارقت أو قنوات التواصل الرسمية المرتبطة به. لا تضيف هذه الصفحة فئات بيانات أو أدوات تتبع غير مستخدمة فعليًا.</p>
        </header>

        <section class="privacy-section" id="scope">
          <div class="privacy-section-head"><span class="privacy-section-num">01</span><h2 data-ar="النطاق والجهة المسؤولة" data-en="Scope & Responsible Entity">النطاق والجهة المسؤولة</h2></div>
          <p data-ar="توضح هذه السياسة كيفية تعامل Target For Food Trading / تارقت لتجارة الأغذية مع البيانات الشخصية التي يتم تقديمها من خلال موقعها الإلكتروني أو قنوات التواصل الرسمية المرتبطة به." data-en="This Policy explains how Target For Food Trading handles personal information submitted through its website or related official contact channels.">توضح هذه السياسة كيفية تعامل Target For Food Trading / تارقت لتجارة الأغذية مع البيانات الشخصية التي يتم تقديمها من خلال موقعها الإلكتروني أو قنوات التواصل الرسمية المرتبطة به.</p>
        </section>

        <section class="privacy-section" id="collect">
          <div class="privacy-section-head"><span class="privacy-section-num">02</span><h2 data-ar="البيانات التي قد نجمعها" data-en="Information We May Collect">البيانات التي قد نجمعها</h2></div>
          <p data-ar="تعتمد البيانات التي نجمعها على طريقة تواصلك معنا. قد تشمل بيانات نموذج الاتصال العام: الاسم، البريد الإلكتروني، رقم الهاتف أو WhatsApp عند تقديمه، نوع الاستفسار، الموضوع ومحتوى الرسالة." data-en="The information we collect depends on how you contact us. General Contact form data may include name, email, phone or WhatsApp if provided, inquiry type, subject and message.">تعتمد البيانات التي نجمعها على طريقة تواصلك معنا. قد تشمل بيانات نموذج الاتصال العام: الاسم، البريد الإلكتروني، رقم الهاتف أو WhatsApp عند تقديمه، نوع الاستفسار، الموضوع ومحتوى الرسالة.</p>
          <p data-ar="وقد تشمل بيانات صفحة الموردين: الاسم، الشركة أو العلامة، الدولة، البريد التجاري، الهاتف أو WhatsApp عند تقديمه، المنتج أو الفئة، موضوع النقاش وملخص المنتج أو الفرصة. كما قد نتلقى أي معلومات تختار إرسالها مباشرة عبر قنوات البريد الإلكتروني المعتمدة." data-en="Supplier-page data may include name, company or brand, country, business email, phone or WhatsApp if provided, product or category, discussion topic, and a product or opportunity summary. We may also receive information you choose to send directly through approved email channels.">وقد تشمل بيانات صفحة الموردين: الاسم، الشركة أو العلامة، الدولة، البريد التجاري، الهاتف أو WhatsApp عند تقديمه، المنتج أو الفئة، موضوع النقاش وملخص المنتج أو الفرصة. كما قد نتلقى أي معلومات تختار إرسالها مباشرة عبر قنوات البريد الإلكتروني المعتمدة.</p>
        </section>

        <section class="privacy-section" id="how">
          <div class="privacy-section-head"><span class="privacy-section-num">03</span><h2 data-ar="كيفية جمع البيانات" data-en="How Information Is Collected">كيفية جمع البيانات</h2></div>
          <p data-ar="تُجمع البيانات عندما ترسل نموذجًا على الموقع أو تتواصل مع تارقت من خلال قناة رسمية. يجب أن تعكس هذه السياسة دائمًا طريقة الإرسال والمعالجة المستخدمة فعليًا في النسخة المنشورة من الموقع." data-en="Information is collected when you submit a website form or contact Target through an official channel. This Policy must always reflect the actual submission and processing methods used by the published website.">تُجمع البيانات عندما ترسل نموذجًا على الموقع أو تتواصل مع تارقت من خلال قناة رسمية. يجب أن تعكس هذه السياسة دائمًا طريقة الإرسال والمعالجة المستخدمة فعليًا في النسخة المنشورة من الموقع.</p>
        </section>

        <section class="privacy-section" id="use">
          <div class="privacy-section-head"><span class="privacy-section-num">04</span><h2 data-ar="أغراض الاستخدام" data-en="Purposes of Use">أغراض الاستخدام</h2></div>
          <p data-ar="نستخدم البيانات لفهم الاستفسار أو الطلب، والرد على المراسلات، ومراجعة المنتجات أو الفرص المقدمة، وتوجيه الطلب إلى القسم المناسب، وإدارة المتابعة التجارية أو التشغيلية ذات الصلة، وحماية الموقع وقنوات التواصل عند الحاجة." data-en="We use information to understand inquiries or requests, respond to communications, review submitted products or opportunities, route requests to the appropriate function, manage relevant commercial or operational follow-up, and protect the website and communication channels where necessary.">نستخدم البيانات لفهم الاستفسار أو الطلب، والرد على المراسلات، ومراجعة المنتجات أو الفرص المقدمة، وتوجيه الطلب إلى القسم المناسب، وإدارة المتابعة التجارية أو التشغيلية ذات الصلة، وحماية الموقع وقنوات التواصل عند الحاجة.</p>
        </section>

        <section class="privacy-section" id="consent">
          <div class="privacy-section-head"><span class="privacy-section-num">05</span><h2 data-ar="الموافقة والغرض المشروع" data-en="Consent & Lawful Purpose">الموافقة والغرض المشروع</h2></div>
          <p data-ar="تتم معالجة البيانات للأغراض التي جُمعت من أجلها وبما يتوافق مع المتطلبات القانونية المطبقة. عندما تكون الموافقة مطلوبة، يجب الحصول عليها بصورة واضحة، ويجوز التعامل مع طلبات سحبها وفق الحقوق والمتطلبات المطبقة." data-en="Personal information is processed for the purposes for which it was collected and in accordance with applicable legal requirements. Where consent is required, it must be obtained clearly, and withdrawal requests are handled in accordance with applicable rights and requirements.">تتم معالجة البيانات للأغراض التي جُمعت من أجلها وبما يتوافق مع المتطلبات القانونية المطبقة. عندما تكون الموافقة مطلوبة، يجب الحصول عليها بصورة واضحة، ويجوز التعامل مع طلبات سحبها وفق الحقوق والمتطلبات المطبقة.</p>
        </section>

        <section class="privacy-section" id="sharing">
          <div class="privacy-section-head"><span class="privacy-section-num">06</span><h2 data-ar="الوصول إلى البيانات ومقدمو الخدمات" data-en="Access, Sharing & Service Providers">الوصول إلى البيانات ومقدمو الخدمات</h2></div>
          <p data-ar="يقتصر الوصول إلى البيانات على الأشخاص والجهات التي تحتاج إليها لمعالجة الاستفسار أو تشغيل الموقع والخدمات المرتبطة به. وقد تُستخدم خدمات تقنية لازمة لتشغيل الموقع أو البريد أو معالجة النماذج. يجب توثيق أي مزود خدمة أو معالج بيانات جوهري مستخدم فعليًا قبل اعتماد النسخة المنشورة من السياسة." data-en="Access to information is limited to people and parties that need it to handle an inquiry or operate the website and related services. Technical services may be used for website, email or form operations. Any material service provider or data processor actually used must be verified before the published Policy is approved.">يقتصر الوصول إلى البيانات على الأشخاص والجهات التي تحتاج إليها لمعالجة الاستفسار أو تشغيل الموقع والخدمات المرتبطة به. وقد تُستخدم خدمات تقنية لازمة لتشغيل الموقع أو البريد أو معالجة النماذج. يجب توثيق أي مزود خدمة أو معالج بيانات جوهري مستخدم فعليًا قبل اعتماد النسخة المنشورة من السياسة.</p>
        </section>

        <section class="privacy-section" id="retention">
          <div class="privacy-section-head"><span class="privacy-section-num">07</span><h2 data-ar="الاحتفاظ بالبيانات" data-en="Data Retention">الاحتفاظ بالبيانات</h2></div>
          <p data-ar="تحتفظ تارقت بالبيانات فقط للمدة اللازمة للغرض الذي جُمعت من أجله، وللمتابعة التجارية أو التشغيلية ذات الصلة، وأي متطلبات قانونية مطبقة. وعندما لا يعود الاحتفاظ بالبيانات ضروريًا، يتم التعامل معها أو حذفها وفق الممارسة المعتمدة والمتطلبات المطبقة." data-en="Target retains information only for as long as necessary for the purpose for which it was collected, related commercial or operational follow-up, and applicable legal requirements. When retention is no longer necessary, the information is handled or deleted in accordance with approved practice and applicable requirements.">تحتفظ تارقت بالبيانات فقط للمدة اللازمة للغرض الذي جُمعت من أجله، وللمتابعة التجارية أو التشغيلية ذات الصلة، وأي متطلبات قانونية مطبقة. وعندما لا يعود الاحتفاظ بالبيانات ضروريًا، يتم التعامل معها أو حذفها وفق الممارسة المعتمدة والمتطلبات المطبقة.</p>
        </section>

        <section class="privacy-section" id="security">
          <div class="privacy-section-head"><span class="privacy-section-num">08</span><h2 data-ar="أمن المعلومات" data-en="Information Security">أمن المعلومات</h2></div>
          <p data-ar="تتخذ تارقت تدابير تنظيمية وتقنية مناسبة لحماية البيانات من الوصول أو الاستخدام أو التعديل أو الإفصاح غير المصرح به، بما يتناسب مع طبيعة البيانات والأدوات المستخدمة فعليًا." data-en="Target applies appropriate organizational and technical measures to protect information against unauthorized access, use, alteration or disclosure, taking into account the nature of the information and the tools actually used.">تتخذ تارقت تدابير تنظيمية وتقنية مناسبة لحماية البيانات من الوصول أو الاستخدام أو التعديل أو الإفصاح غير المصرح به، بما يتناسب مع طبيعة البيانات والأدوات المستخدمة فعليًا.</p>
        </section>

        <section class="privacy-section" id="rights">
          <div class="privacy-section-head"><span class="privacy-section-num">09</span><h2 data-ar="حقوق الأفراد والطلبات" data-en="Individual Rights & Requests">حقوق الأفراد والطلبات</h2></div>
          <p data-ar="وفق المتطلبات القانونية المطبقة، يمكن للأفراد تقديم طلبات تتعلق ببياناتهم، بما في ذلك طلبات الوصول أو المراجعة أو التصحيح أو الاعتراض أو سحب الموافقة أو الحذف حيثما تنطبق هذه الحقوق. يمكن إرسال طلبات الخصوصية إلى info@targetft.com." data-en="Subject to applicable legal requirements, individuals may submit requests regarding their personal information, including access or review, correction, objection, withdrawal of consent, or deletion where those rights apply. Privacy requests may be sent to info@targetft.com.">وفق المتطلبات القانونية المطبقة، يمكن للأفراد تقديم طلبات تتعلق ببياناتهم، بما في ذلك طلبات الوصول أو المراجعة أو التصحيح أو الاعتراض أو سحب الموافقة أو الحذف حيثما تنطبق هذه الحقوق. يمكن إرسال طلبات الخصوصية إلى <a href="mailto:info@targetft.com">info@targetft.com</a>.</p>
        </section>

        <section class="privacy-section" id="cookies">
          <div class="privacy-section-head"><span class="privacy-section-num">10</span><h2 data-ar="ملفات الارتباط والتحليلات والتحديثات" data-en="Cookies, Analytics & Policy Updates">ملفات الارتباط والتحليلات والتحديثات</h2></div>
          <p data-ar="يجب أن تصف النسخة المنشورة من هذه السياسة ملفات الارتباط وأدوات التحليلات المستخدمة فعليًا فقط. لا يجوز تفعيل أدوات تحليل أو تسويق غير ضرورية بصورة غير موثقة ثم ترك السياسة دون تحديث. قد يتم تحديث هذه السياسة عند تغير الموقع أو الأدوات أو الممارسات أو المتطلبات، ويظهر تاريخ السريان أو آخر تحديث عند النشر." data-en="The published Policy must describe only the cookies and analytics tools actually in use. Non-essential analytics or marketing tools must not be activated without the required documentation and corresponding policy update. This Policy may be updated when the website, tools, practices or requirements change, with the effective or last-updated date shown when published.">يجب أن تصف النسخة المنشورة من هذه السياسة ملفات الارتباط وأدوات التحليلات المستخدمة فعليًا فقط. لا يجوز تفعيل أدوات تحليل أو تسويق غير ضرورية بصورة غير موثقة ثم ترك السياسة دون تحديث. قد يتم تحديث هذه السياسة عند تغير الموقع أو الأدوات أو الممارسات أو المتطلبات، ويظهر تاريخ السريان أو آخر تحديث عند النشر.</p>
        </section>
      </article>
    </div>
  </section>

  <section class="privacy-request-wrap">
    <div class="container">
      <div class="privacy-request">
        <div>
          <span class="privacy-kicker" data-ar="طلبات الخصوصية" data-en="Privacy Requests">طلبات الخصوصية</span>
          <h2 data-ar="لديك طلب متعلق ببياناتك؟" data-en="Have a request about your personal information?">لديك طلب متعلق ببياناتك؟</h2>
          <p data-ar="يمكنك التواصل معنا بخصوص طلبات الخصوصية من خلال البريد المعتمد أدناه." data-en="You can contact us regarding privacy requests using the approved email below.">يمكنك التواصل معنا بخصوص طلبات الخصوصية من خلال البريد المعتمد أدناه.</p>
        </div>
        <a class="privacy-request-action" href="mailto:info@targetft.com"><i data-lucide="mail"></i><span>info@targetft.com</span></a>
      </div>
    </div>
  </section>

  <section class="privacy-related">
    <div class="container privacy-related-row">
      <div class="privacy-related-copy">
        <strong data-ar="روابط قانونية ومساندة" data-en="Legal & Support Links">روابط قانونية ومساندة</strong>
        <span data-ar="راجع الشروط أو تواصل معنا إذا كان لديك استفسار عام." data-en="Review the Terms or contact us if you have a general enquiry.">راجع الشروط أو تواصل معنا إذا كان لديك استفسار عام.</span>
      </div>
      <div class="privacy-related-links">
        <a href="terms.html"><i data-lucide="scroll-text"></i><span data-ar="الشروط والأحكام" data-en="Terms & Conditions">الشروط والأحكام</span></a>
        <a href="contact.html"><i data-lucide="mail"></i><span data-ar="اتصل بنا" data-en="Contact Us">اتصل بنا</span></a>
      </div>
    </div>
  </section>
</BaseLayout>