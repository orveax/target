---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout active="contact" bodyClass="page-contact premium-v8-page" title="الاتصال بنا | TARGET">
  <section class="premium-page-hero portfolio-hero">
    <div class="premium-page-hero-overlay"></div>
    <div class="container premium-page-hero-content">
      <div class="hero-kicker"><i data-lucide="messages-square"></i><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span></div>
      <h1 data-ar="تواصل مع تارقت" data-en="Contact TARGET">تواصل مع تارقت</h1>
      <p data-ar="للاستفسارات العامة والمبيعات وطلبات المعلومات والتواصل المؤسسي. لعرض منتج أو فرصة توريد، استخدم مسار الموردين المخصص." data-en="For general enquiries, sales, information requests and corporate contact. To present a product or supplier opportunity, use the dedicated supplier route.">للاستفسارات العامة والمبيعات وطلبات المعلومات والتواصل المؤسسي. لعرض منتج أو فرصة توريد، استخدم مسار الموردين المخصص.</p>
    </div>
  </section>
  <section class="section">
    <div class="container t5-contact-layout">
      <form class="contact-form t5-form" data-target-form novalidate>
        <div class="t5-form-head"><div><div class="kicker" data-ar="تواصل سريع" data-en="Quick Contact">تواصل سريع</div><h2 data-ar="كيف يمكننا مساعدتك؟" data-en="How can we help?">كيف يمكننا مساعدتك؟</h2><p data-ar="حدد نوع الاستفسار لنوجّه الطلب إلى القناة المناسبة." data-en="Select the enquiry type so the request can be directed to the right channel.">حدد نوع الاستفسار لنوجّه الطلب إلى القناة المناسبة.</p></div><span class="icon-tile"><i data-lucide="message-square-text"></i></span></div>
        <div class="validation-summary" data-validation-summary role="alert" aria-live="assertive" data-ar="يرجى مراجعة الحقول المحددة أدناه." data-en="Please review the highlighted fields below.">يرجى مراجعة الحقول المحددة أدناه.</div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="contact-name" data-ar="الاسم *" data-en="Name *">الاسم *</label><input class="form-control" id="contact-name" name="name" autocomplete="name" required data-ar-placeholder="الاسم الكامل" data-en-placeholder="Full name" placeholder="الاسم الكامل"></div>
          <div class="col-md-6"><label class="form-label" for="contact-email" data-ar="البريد الإلكتروني *" data-en="Email *">البريد الإلكتروني *</label><input class="form-control" type="email" id="contact-email" name="email" autocomplete="email" required placeholder="name@company.com"></div>
          <div class="col-md-6"><label class="form-label" for="contact-phone" data-ar="الهاتف أو WhatsApp" data-en="Phone or WhatsApp">الهاتف أو WhatsApp</label><input class="form-control" type="tel" id="contact-phone" name="phone" autocomplete="tel" data-ar-placeholder="اختياري" data-en-placeholder="Optional" placeholder="اختياري"></div>
          <div class="col-md-6"><label class="form-label" for="contact-intent" data-ar="نوع الاستفسار *" data-en="Enquiry type *">نوع الاستفسار *</label><select class="form-select" id="contact-intent" name="intent" required><option value="" selected disabled data-ar="اختر نوع الاستفسار" data-en="Select enquiry type">اختر نوع الاستفسار</option><option value="general" data-ar="استفسار عام" data-en="General Inquiry">استفسار عام</option><option value="sales" data-ar="المبيعات" data-en="Sales">المبيعات</option><option value="quote" data-ar="طلب عرض سعر" data-en="Request a Quote">طلب عرض سعر</option><option value="complaint" data-ar="شكوى" data-en="Complaint">شكوى</option><option value="suggestion" data-ar="اقتراح" data-en="Suggestion">اقتراح</option><option value="information" data-ar="طلب معلومات أو مستند" data-en="Information or Document Request">طلب معلومات أو مستند</option><option value="other" data-ar="أخرى" data-en="Other">أخرى</option></select></div>
          <div class="col-12"><label class="form-label" for="contact-subject" data-ar="الموضوع *" data-en="Subject *">الموضوع *</label><input class="form-control" id="contact-subject" name="subject" required data-ar-placeholder="عنوان مختصر للاستفسار" data-en-placeholder="A short subject line" placeholder="عنوان مختصر للاستفسار"></div>
          <div class="col-12"><label class="form-label" for="contact-message" data-ar="الرسالة *" data-en="Message *">الرسالة *</label><textarea class="form-control" id="contact-message" name="message" required minlength="20" maxlength="700" data-ar-placeholder="اكتب تفاصيل الاستفسار أو الطلب." data-en-placeholder="Write the details of your enquiry or request." placeholder="اكتب تفاصيل الاستفسار أو الطلب."></textarea></div>
          <div class="col-12"><div class="privacy-check"><input class="form-check-input" type="checkbox" id="contact-privacy" required><label for="contact-privacy" class="small"><span data-ar="أوافق على استخدام البيانات لمعالجة هذا الاستفسار وفق " data-en="I agree to the use of this information to handle this enquiry under the ">أوافق على استخدام البيانات لمعالجة هذا الاستفسار وفق </span><a href="privacy.html" data-ar="سياسة الخصوصية" data-en="Privacy Policy">سياسة الخصوصية</a>.</label></div></div>
          <div class="col-12"><button class="btn-premium btn-primary-premium" type="submit"><i data-lucide="send"></i><span data-ar="إرسال الاستفسار" data-en="Send Enquiry">إرسال الاستفسار</span></button></div>
        </div>
        <div class="form-success" data-form-success tabindex="-1" role="status" aria-live="polite"><span class="icon-inline"><i data-lucide="circle-check-big"></i><span data-ar="تم التحقق من نموذج الاختبار. سيُربط الإرسال النهائي بالقنوات المعتمدة في مرحلة التكامل." data-en="The test form is validated. Final delivery will be connected to approved channels during integration.">تم التحقق من نموذج الاختبار. سيُربط الإرسال النهائي بالقنوات المعتمدة في مرحلة التكامل.</span></span></div>
      </form>
      <aside class="t5-contact-side"><div><div class="kicker" data-ar="قنوات مباشرة" data-en="Direct channels">قنوات مباشرة</div><h2 data-ar="اختر القناة المناسبة" data-en="Choose the right channel">اختر القناة المناسبة</h2></div><a class="contact-card" href="mailto:info@targetft.com"><span class="icon-tile"><i data-lucide="mail"></i></span><span><strong data-ar="استفسار عام" data-en="General Inquiry">استفسار عام</strong><small>info@targetft.com</small></span></a><a class="contact-card" href="mailto:sales@targetft.com"><span class="icon-tile"><i data-lucide="badge-dollar-sign"></i></span><span><strong data-ar="المبيعات وطلب عرض سعر" data-en="Sales & Request a Quote">المبيعات وطلب عرض سعر</strong><small>sales@targetft.com</small></span></a><a class="contact-card" href="mailto:procurement@targetft.com"><span class="icon-tile"><i data-lucide="shopping-cart"></i></span><span><strong data-ar="المشتريات" data-en="Procurement">المشتريات</strong><small>procurement@targetft.com</small></span></a><a class="contact-card" href="suppliers.html"><span class="icon-tile"><i data-lucide="factory"></i></span><span><strong data-ar="للموردين والمصنعين" data-en="Suppliers & Manufacturers">للموردين والمصنعين</strong><small data-ar="انتقل إلى نموذج الموردين" data-en="Go to supplier form">انتقل إلى نموذج الموردين</small></span></a><a class="t5-support-link" href="faq.html"><i data-lucide="circle-help"></i><span data-ar="هل تحتاج إجابة سريعة؟ راجع الأسئلة الشائعة." data-en="Need a quick answer? Review the FAQ.">هل تحتاج إجابة سريعة؟ راجع الأسئلة الشائعة.</span></a></aside>
    </div>
  </section>
</BaseLayout>
