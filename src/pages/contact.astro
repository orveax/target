---
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = [
  ['mail','استفسارات عامة','General Enquiries','info@targetft.com','mailto:info@targetft.com','استفسارات الشركة والمعلومات والوثائق والملاحظات.','Company information, documents, general enquiries and feedback.'],
  ['badge-dollar-sign','المبيعات والتجاري','Sales & Commercial','sales@targetft.com','mailto:sales@targetft.com','للمبيعات وطلبات الأسعار والنقاشات التجارية العامة.','For sales, quotations and general commercial enquiries.'],
  ['shopping-cart','المشتريات','Procurement','procurement@targetft.com','mailto:procurement@targetft.com','للتواصل المباشر المتعلق بالمشتريات والتوريد.','For direct procurement and sourcing enquiries.'],
  ['factory','المصنعون والموردون','Manufacturers & Suppliers','partners@targetft.com','suppliers.html','لديك منتج؟ استخدم مسار الموردين المنظم لمراجعة المنتج والفرصة.','Have a product? Use the structured supplier route for product review.'],
];
---
<BaseLayout active="contact" bodyClass="page-contact premium-v8-page" title="الاتصال بنا | TARGET" description="تواصل مع تارقت للاستفسارات العامة والمبيعات والمشتريات وطلبات المعلومات. لعرض منتج، استخدم مسار الموردين المخصص.">
  <section class="ct-hero">
    <div class="container ct-hero-grid">
      <div class="ct-hero-copy">
        <span class="ct-eyebrow"><i data-lucide="mail"></i><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span></span>
        <h1 data-ar="اختر القناة المناسبة، وساعدنا على فهم طلبك من البداية." data-en="Choose the right channel and help us understand your enquiry from the start.">اختر القناة المناسبة، وساعدنا على فهم طلبك من البداية.</h1>
        <p data-ar="للاستفسارات العامة والمبيعات والمستندات والملاحظات، تواصل معنا من خلال النموذج أو القناة المناسبة. إذا كنت مصنعًا أو موردًا وتريد عرض منتج للسوق القطري، استخدم صفحة الموردين المخصصة." data-en="For general enquiries, sales, documents and feedback, use the form or the relevant contact channel. If you are a manufacturer or supplier submitting a product for Qatar, use the dedicated For Suppliers page.">للاستفسارات العامة والمبيعات والمستندات والملاحظات، تواصل معنا من خلال النموذج أو القناة المناسبة. إذا كنت مصنعًا أو موردًا وتريد عرض منتج للسوق القطري، استخدم صفحة الموردين المخصصة.</p>
        <div class="ct-actions">
          <a class="ct-primary" href="#quick-enquiry"><i data-lucide="send"></i><span data-ar="أرسل استفسارك" data-en="Send Your Enquiry">أرسل استفسارك</span></a>
          <a class="ct-secondary" href="suppliers.html"><span data-ar="لديك منتج؟ للموردين" data-en="Have a Product? For Suppliers">لديك منتج؟ للموردين</span><i data-lucide="arrow-left"></i></a>
        </div>
      </div>
      <figure class="ct-hero-media">
        <img src="/images/home-food-trade-editorial-v1.png" alt="منتجات غذائية وتواصل تجاري" data-ar-alt="منتجات غذائية وتواصل تجاري" data-en-alt="Packaged food products in a commercial trade context" width="1200" height="960" loading="eager" decoding="async" />
        <figcaption>
          <span><i data-lucide="message-square"></i><b data-ar="حدد طلبك" data-en="Define Your Enquiry">حدد طلبك</b></span>
          <span><i data-lucide="route"></i><b data-ar="اختر القناة" data-en="Choose the Channel">اختر القناة</b></span>
          <span><i data-lucide="mail-check"></i><b data-ar="أرسل بوضوح" data-en="Send Clearly">أرسل بوضوح</b></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="ct-section ct-form-section" id="quick-enquiry">
    <div class="container ct-form-layout">
      <form class="contact-form ct-form" data-target-form novalidate>
        <div class="ct-form-head">
          <div>
            <span class="ct-kicker" data-ar="استفسار سريع" data-en="Quick Enquiry">استفسار سريع</span>
            <h2 data-ar="أرسل لنا الرسالة إلى الجهة المناسبة." data-en="Send your message to the right team.">أرسل لنا الرسالة إلى الجهة المناسبة.</h2>
            <p data-ar="حدد نوع الاستفسار واكتب رسالة واضحة. مسار المنتجات والموردين منفصل حتى تصل كل رسالة للقناة الصحيحة." data-en="Choose the enquiry type and write a clear message. Product and supplier submissions use a separate route so each enquiry reaches the right channel.">حدد نوع الاستفسار واكتب رسالة واضحة. مسار المنتجات والموردين منفصل حتى تصل كل رسالة للقناة الصحيحة.</p>
          </div>
          <span class="ct-form-icon"><i data-lucide="message-square-text"></i></span>
        </div>
        <div class="validation-summary" data-validation-summary role="alert" aria-live="assertive" data-ar="يرجى مراجعة الحقول المحددة أدناه." data-en="Please review the highlighted fields below.">يرجى مراجعة الحقول المحددة أدناه.</div>
        <div class="ct-form-grid">
          <div class="ct-field"><label for="contact-name" data-ar="الاسم *" data-en="Name *">الاسم *</label><input class="form-control" id="contact-name" name="name" autocomplete="name" required data-ar-placeholder="الاسم الكامل" data-en-placeholder="Full name" placeholder="الاسم الكامل" /></div>
          <div class="ct-field"><label for="contact-email" data-ar="البريد الإلكتروني *" data-en="Email *">البريد الإلكتروني *</label><input class="form-control" type="email" id="contact-email" name="email" autocomplete="email" required placeholder="name@company.com" /></div>
          <div class="ct-field"><label for="contact-phone" data-ar="الهاتف أو WhatsApp — اختياري" data-en="Phone or WhatsApp — Optional">الهاتف أو WhatsApp — اختياري</label><input class="form-control" type="tel" id="contact-phone" name="phone" autocomplete="tel" data-ar-placeholder="اختياري" data-en-placeholder="Optional" placeholder="اختياري" /></div>
          <div class="ct-field"><label for="contact-intent" data-ar="نوع الاستفسار *" data-en="Enquiry Type *">نوع الاستفسار *</label><select class="form-select" id="contact-intent" name="intent" required><option value="" selected disabled data-ar="اختر نوع الاستفسار" data-en="Select enquiry type">اختر نوع الاستفسار</option><option value="general" data-ar="استفسار عام" data-en="General Inquiry">استفسار عام</option><option value="sales" data-ar="مبيعات" data-en="Sales">مبيعات</option><option value="quote" data-ar="طلب عرض سعر" data-en="Request a Quote">طلب عرض سعر</option><option value="complaint" data-ar="شكوى" data-en="Complaint">شكوى</option><option value="suggestion" data-ar="اقتراح" data-en="Suggestion">اقتراح</option><option value="information" data-ar="طلب معلومات أو مستند" data-en="Information or Document Request">طلب معلومات أو مستند</option><option value="other" data-ar="أخرى" data-en="Other">أخرى</option></select></div>
          <div class="ct-field ct-field-wide"><label for="contact-subject" data-ar="الموضوع *" data-en="Subject *">الموضوع *</label><input class="form-control" id="contact-subject" name="subject" required data-ar-placeholder="عنوان مختصر للاستفسار" data-en-placeholder="A short subject line" placeholder="عنوان مختصر للاستفسار" /></div>
          <div class="ct-field ct-field-wide"><label for="contact-message" data-ar="الرسالة *" data-en="Message *">الرسالة *</label><textarea class="form-control" id="contact-message" name="message" required minlength="20" maxlength="700" data-ar-placeholder="اكتب تفاصيل الاستفسار أو الطلب." data-en-placeholder="Write the details of your enquiry or request." placeholder="اكتب تفاصيل الاستفسار أو الطلب."></textarea></div>
          <div class="ct-field-wide privacy-check"><input class="form-check-input" type="checkbox" id="contact-privacy" required /><label for="contact-privacy"><span data-ar="أوافق على استخدام هذه المعلومات لمعالجة الاستفسار وفق " data-en="I agree to the use of this information to handle the enquiry in accordance with the ">أوافق على استخدام هذه المعلومات لمعالجة الاستفسار وفق </span><a href="privacy.html" data-ar="سياسة الخصوصية" data-en="Privacy Policy">سياسة الخصوصية</a>.</label></div>
          <div class="ct-field-wide"><button class="ct-submit" type="submit"><i data-lucide="send"></i><span data-ar="إرسال الاستفسار" data-en="Send Enquiry">إرسال الاستفسار</span></button></div>
        </div>
        <div class="form-success" data-form-success tabindex="-1" role="status" aria-live="polite"><span class="icon-inline"><i data-lucide="circle-check-big"></i><span data-ar="تم استلام استفسارك. قد يتواصل معك فريق تارقت عبر بيانات التواصل التي أرسلتها إذا كانت هناك حاجة لمتابعة الطلب." data-en="Your enquiry has been received. TARGET may contact you using the submitted details if follow-up is required.">تم استلام استفسارك. قد يتواصل معك فريق تارقت عبر بيانات التواصل التي أرسلتها إذا كانت هناك حاجة لمتابعة الطلب.</span></span></div>
      </form>

      <aside class="ct-route-note">
        <span class="ct-kicker" data-ar="قبل الإرسال" data-en="Before You Send">قبل الإرسال</span>
        <h2 data-ar="هل رسالتك عن منتج غذائي؟" data-en="Is your enquiry about a food product?">هل رسالتك عن منتج غذائي؟</h2>
        <p data-ar="طلبات المصنعين والموردين ومراجعة المنتجات لها نموذج منفصل حتى نطلب المعلومات الصحيحة من البداية." data-en="Manufacturer, supplier and product-review enquiries use a separate form so we collect the right information from the start.">طلبات المصنعين والموردين ومراجعة المنتجات لها نموذج منفصل حتى نطلب المعلومات الصحيحة من البداية.</p>
        <a href="suppliers.html"><i data-lucide="factory"></i><span data-ar="انتقل إلى صفحة الموردين" data-en="Go to For Suppliers">انتقل إلى صفحة الموردين</span></a>
        <div class="ct-route-meta"><span><i data-lucide="mail"></i> info@targetft.com</span><span><i data-lucide="badge-dollar-sign"></i> sales@targetft.com</span></div>
      </aside>
    </div>
  </section>

  <section class="ct-section ct-channels">
    <div class="container">
      <header class="ct-section-head"><span class="ct-kicker" data-ar="قنوات التواصل" data-en="Contact Channels">قنوات التواصل</span><h2 data-ar="تواصل مباشرة مع القسم المناسب" data-en="Contact the relevant team directly">تواصل مباشرة مع القسم المناسب</h2><p data-ar="اختر البريد أو المسار الأنسب لطبيعة طلبك. عرض المنتجات يفضل أن يبدأ من صفحة الموردين المنظمة." data-en="Choose the email or route that best matches your enquiry. Product submissions should preferably start through the structured supplier page.">اختر البريد أو المسار الأنسب لطبيعة طلبك. عرض المنتجات يفضل أن يبدأ من صفحة الموردين المنظمة.</p></header>
      <div class="ct-channel-grid">
        {channels.map(([icon,ar,en,email,href,arBody,enBody]) => <article class="ct-channel-card"><span class="ct-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p><a href={href}><span>{email}</span><i data-lucide="arrow-up-left"></i></a></div></article>)}
      </div>
    </div>
  </section>

  <section class="ct-section ct-location">
    <div class="container ct-location-grid">
      <div class="ct-location-copy"><span class="ct-kicker" data-ar="الموقع" data-en="Location">الموقع</span><h2 data-ar="نعمل من قطر." data-en="Based in Qatar.">نعمل من قطر.</h2><p data-ar="تارقت شركة تعمل من قطر. نعرض العنوان أو موقع الخريطة الدقيق فقط بعد اعتماد بيانات الموقع الرسمية للنشر." data-en="TARGET operates from Qatar. A precise office address or map pin is shown only after the official publishable location is verified.">تارقت شركة تعمل من قطر. نعرض العنوان أو موقع الخريطة الدقيق فقط بعد اعتماد بيانات الموقع الرسمية للنشر.</p><div class="ct-location-fact"><i data-lucide="map"></i><div><strong data-ar="دولة قطر" data-en="State of Qatar">دولة قطر</strong><span data-ar="سياق جغرافي عام — بدون دبوس موقع غير موثق." data-en="General geographic context — no unverified map pin.">سياق جغرافي عام — بدون دبوس موقع غير موثق.</span></div></div></div>
      <div class="ct-map-context" role="img" aria-label="Qatar geographic context without a precise office pin"><div class="ct-map-grid"></div><span class="ct-map-label"><i data-lucide="globe-2"></i><b data-ar="قطر" data-en="Qatar">قطر</b><small>targetft.com</small></span><span class="ct-map-route"></span></div>
    </div>
  </section>

  <section class="ct-support">
    <div class="container">
      <div class="ct-support-panel">
        <article><span class="ct-kicker" data-ar="لديك منتج؟" data-en="Have a Product?">لديك منتج؟</span><h2 data-ar="ناقش فرصة منتجك في قطر." data-en="Discuss your product opportunity in Qatar.">ناقش فرصة منتجك في قطر.</h2><p class="ct-support-copy" data-ar="شارك بيانات المنتج الأساسية لنراجع الفئة والملاءمة ونحدد معك الخطوة التالية." data-en="Share the essential product details so we can review category fit and define the next step with you.">شارك بيانات المنتج الأساسية لنراجع الفئة والملاءمة ونحدد معك الخطوة التالية.</p><a class="ct-support-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></article>
        <article><span class="ct-kicker" data-ar="تحتاج إجابة سريعة؟" data-en="Need a Quick Answer?">تحتاج إجابة سريعة؟</span><h2 data-ar="ابدأ من الأسئلة الشائعة." data-en="Start with the common questions.">ابدأ من الأسئلة الشائعة.</h2><p class="ct-support-copy" data-ar="إجابات مختصرة عن المنتجات، وطريقة العمل، وقنوات التواصل المناسبة." data-en="Quick answers about products, how we work and the right contact route.">إجابات مختصرة عن المنتجات، وطريقة العمل، وقنوات التواصل المناسبة.</p><a class="ct-support-secondary" href="faq.html"><i data-lucide="circle-help"></i><span data-ar="الأسئلة الشائعة" data-en="FAQ">الأسئلة الشائعة</span></a></article>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
.page-contact{background:var(--target-cream,#F4EDE4)}
.ct-hero{position:relative;overflow:hidden;padding-block:88px 96px;background:radial-gradient(circle at 8% 18%,rgba(12,73,49,.05),transparent 24%),linear-gradient(135deg,rgba(192,149,82,.04) 25%,transparent 25%) 0 0/56px 56px,var(--target-cream)}
.ct-hero-grid{display:grid;grid-template-columns:minmax(0,55fr) minmax(0,45fr);gap:50px;align-items:center}.ct-hero-copy{max-width:720px}.ct-eyebrow,.ct-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--target-forest);font-size:.875rem;font-weight:700}.ct-eyebrow{padding:8px 12px;border:1px solid rgba(12,73,49,.12);border-radius:999px;background:rgba(255,255,255,.7)}.ct-eyebrow svg{width:18px;height:18px;color:var(--target-sand)}.ct-hero h1{max-width:15ch;margin:15px 0 20px;color:var(--target-charcoal)!important;font-size:var(--target-h1-internal);font-weight:700;line-height:1.1}.ct-hero-copy>p{max-width:690px;color:rgba(38,38,38,.74)!important;font-size:var(--target-lead);line-height:1.8}.ct-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:28px}.ct-primary,.ct-submit,.ct-support-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding-inline:26px;border:1px solid var(--target-forest);border-radius:12px;background:var(--target-forest);color:var(--target-cream);font-weight:700;text-decoration:none;transition:.2s}.ct-primary:hover,.ct-submit:hover{background:#073b29;border-color:#073b29;color:#fff;transform:translateY(-1px)}.ct-secondary{display:inline-flex;align-items:center;gap:8px;min-height:52px;color:var(--target-forest);font-weight:700;text-decoration:none}.ct-secondary:hover{text-decoration:underline;text-underline-offset:4px;color:var(--target-forest)}
.ct-hero-media{position:relative;margin:0;aspect-ratio:5/4}.ct-hero-media>img{display:block;width:100%;height:100%;object-fit:cover;border:1px solid rgba(12,73,49,.12);border-radius:24px;box-shadow:0 24px 56px rgba(38,38,38,.13);filter:saturate(.9) contrast(.99)}.ct-hero-media::after{content:"";position:absolute;inset:0;border-radius:24px;background:linear-gradient(180deg,transparent 60%,rgba(12,73,49,.19));pointer-events:none}.ct-hero-media figcaption{position:absolute;z-index:2;inset-inline:18px;inset-block-end:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px;border-radius:15px;background:rgba(255,254,251,.95);box-shadow:0 14px 32px rgba(38,38,38,.14)}.ct-hero-media figcaption span{display:flex;align-items:center;gap:7px;padding:9px;border-radius:11px;background:rgba(244,237,228,.75);color:var(--target-charcoal)}.ct-hero-media figcaption svg{width:18px;height:18px;color:var(--target-forest)}.ct-hero-media figcaption b{font-size:.72rem;line-height:1.35}
.ct-section{padding-block:96px}.ct-kicker::before{content:"";width:22px;height:2px;border-radius:99px;background:var(--target-sand)}.ct-section h2,.ct-support h2{margin:10px 0 16px;color:var(--target-charcoal);font-size:var(--target-h2);font-weight:700;line-height:1.2}.ct-section-head{max-width:860px;margin-bottom:38px}.ct-section-head p{max-width:740px;color:rgba(38,38,38,.69);line-height:1.75}
.ct-form-section{background:#fff}.ct-form-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(310px,.8fr);gap:28px;align-items:start}.ct-form{padding:32px;border:1px solid rgba(12,73,49,.12);border-radius:20px;background:#fff;box-shadow:0 14px 34px rgba(38,38,38,.05)}.ct-form-head{display:grid;grid-template-columns:1fr 64px;gap:22px;align-items:start;margin-bottom:26px}.ct-form-head h2{margin-bottom:10px}.ct-form-head p{margin:0;color:rgba(38,38,38,.7);line-height:1.75}.ct-form-icon{display:grid;place-items:center;width:60px;height:60px;border-radius:16px;background:var(--target-forest);color:var(--target-cream)}.ct-form-icon svg{width:30px;height:30px}.ct-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.ct-field{display:grid;gap:7px}.ct-field-wide{grid-column:1/-1}.ct-field label,.privacy-check label{color:var(--target-charcoal);font-weight:700;font-size:.94rem}.ct-field .form-control,.ct-field .form-select{min-height:52px;border:1px solid rgba(38,38,38,.16);border-radius:12px;background:#fff;color:var(--target-charcoal);box-shadow:none}.ct-field textarea.form-control{min-height:170px;resize:vertical}.ct-field .form-control:focus,.ct-field .form-select:focus{border-color:var(--target-forest);box-shadow:0 0 0 3px rgba(12,73,49,.10)}.privacy-check{display:flex;align-items:flex-start;gap:10px;padding:14px 0}.privacy-check .form-check-input{flex:0 0 auto;margin-top:.25rem}.privacy-check a{color:var(--target-forest);font-weight:700}.ct-submit{border:0;cursor:pointer}.ct-route-note{position:sticky;top:96px;padding:30px 26px;border:1px solid rgba(12,73,49,.12);border-radius:20px;background:var(--target-cream)}.ct-route-note h2{font-size:clamp(1.65rem,2.5vw,2.2rem)!important}.ct-route-note p{color:rgba(38,38,38,.69);line-height:1.75}.ct-route-note>a{display:inline-flex;align-items:center;gap:8px;margin-top:8px;color:var(--target-forest);font-weight:700;text-decoration:none}.ct-route-note>a:hover{text-decoration:underline;text-underline-offset:4px}.ct-route-meta{display:grid;gap:8px;margin-top:24px;padding-top:18px;border-top:1px solid rgba(12,73,49,.12)}.ct-route-meta span{display:flex;align-items:center;gap:8px;color:rgba(38,38,38,.7);font-size:.9rem}.ct-route-meta svg{width:18px;height:18px;color:var(--target-forest)}
