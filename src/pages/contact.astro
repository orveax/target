---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout active="contact" bodyClass="page-contact premium-v8-page" title="الاتصال بنا | TARGET" description="تواصل مع تارقت للاستفسارات العامة والمبيعات والمشتريات وطلبات المعلومات. لعرض منتج، استخدم مسار الموردين المخصص.">
  <section class="premium-page-hero portfolio-hero">
    <div class="premium-page-hero-overlay"></div>
    <div class="container premium-page-hero-content">
      <div class="hero-kicker"><i data-lucide="mail"></i><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span></div>
      <h1 data-ar="تواصل مع تارقت عبر القناة المناسبة لطلبك." data-en="Contact TARGET through the right channel for your enquiry.">تواصل مع تارقت عبر القناة المناسبة لطلبك.</h1>
      <p data-ar="للاستفسارات العامة والمبيعات والمشتريات وطلبات المعلومات. إذا كان لديك منتج غذائي تريد مناقشة فرصته في قطر، استخدم صفحة الموردين المخصصة." data-en="For general enquiries, sales, procurement and information requests. If you have a food product you want to discuss for Qatar, use the dedicated supplier page.">للاستفسارات العامة والمبيعات والمشتريات وطلبات المعلومات. إذا كان لديك منتج غذائي تريد مناقشة فرصته في قطر، استخدم صفحة الموردين المخصصة.</p>
    </div>
  </section>

  <section class="section">
    <div class="container t5-contact-layout">
      <form class="contact-form t5-form" data-target-form novalidate>
        <div class="t5-form-head"><div><div class="kicker" data-ar="تواصل سريع" data-en="Quick Contact">تواصل سريع</div><h2 data-ar="ساعدنا على فهم طلبك من البداية." data-en="Help us understand your enquiry from the start.">ساعدنا على فهم طلبك من البداية.</h2><p data-ar="حدد نوع الاستفسار وأرسل رسالة قصيرة؛ سنستخدم البيانات فقط لمعالجة هذا الطلب وفق سياسة الخصوصية." data-en="Choose the enquiry type and send a short message. The information is used to handle this request under the Privacy Policy.">حدد نوع الاستفسار وأرسل رسالة قصيرة؛ سنستخدم البيانات فقط لمعالجة هذا الطلب وفق سياسة الخصوصية.</p></div><span class="icon-tile"><i data-lucide="message-square"></i></span></div>
        <div class="validation-summary" data-validation-summary role="alert" aria-live="assertive" data-ar="يرجى مراجعة الحقول المحددة أدناه." data-en="Please review the highlighted fields below.">يرجى مراجعة الحقول المحددة أدناه.</div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="contact-name" data-ar="الاسم *" data-en="Name *">الاسم *</label><input class="form-control" id="contact-name" name="name" autocomplete="name" required data-ar-placeholder="الاسم الكامل" data-en-placeholder="Full name" placeholder="الاسم الكامل"></div>
          <div class="col-md-6"><label class="form-label" for="contact-email" data-ar="البريد الإلكتروني *" data-en="Email *">البريد الإلكتروني *</label><input class="form-control" type="email" id="contact-email" name="email" autocomplete="email" required placeholder="name@company.com"></div>
          <div class="col-md-6"><label class="form-label" for="contact-phone" data-ar="الهاتف أو WhatsApp" data-en="Phone or WhatsApp">الهاتف أو WhatsApp</label><input class="form-control" type="tel" id="contact-phone" name="phone" autocomplete="tel" data-ar-placeholder="اختياري" data-en-placeholder="Optional" placeholder="اختياري"></div>
          <div class="col-md-6"><label class="form-label" for="contact-intent" data-ar="نوع الاستفسار *" data-en="Enquiry Type *">نوع الاستفسار *</label><select class="form-select" id="contact-intent" name="intent" required><option value="" selected disabled data-ar="اختر نوع الاستفسار" data-en="Select enquiry type">اختر نوع الاستفسار</option><option value="general" data-ar="استفسار عام" data-en="General Inquiry">استفسار عام</option><option value="sales" data-ar="المبيعات" data-en="Sales">المبيعات</option><option value="quote" data-ar="طلب عرض سعر" data-en="Request a Quote">طلب عرض سعر</option><option value="complaint" data-ar="شكوى" data-en="Complaint">شكوى</option><option value="suggestion" data-ar="اقتراح" data-en="Suggestion">اقتراح</option><option value="information" data-ar="طلب معلومات أو مستند" data-en="Information / Document Request">طلب معلومات أو مستند</option><option value="other" data-ar="أخرى" data-en="Other">أخرى</option></select></div>
          <div class="col-12"><label class="form-label" for="contact-subject" data-ar="الموضوع *" data-en="Subject *">الموضوع *</label><input class="form-control" id="contact-subject" name="subject" required data-ar-placeholder="عنوان مختصر للاستفسار" data-en-placeholder="A short subject line" placeholder="عنوان مختصر للاستفسار"></div>
          <div class="col-12"><label class="form-label" for="contact-message" data-ar="الرسالة *" data-en="Message *">الرسالة *</label><textarea class="form-control" id="contact-message" name="message" required minlength="20" maxlength="700" data-ar-placeholder="اكتب تفاصيل الاستفسار أو الطلب." data-en-placeholder="Write the details of your enquiry or request." placeholder="اكتب تفاصيل الاستفسار أو الطلب."></textarea></div>
          <div class="col-12"><div class="privacy-check"><input class="form-check-input" type="checkbox" id="contact-privacy" required><label for="contact-privacy" class="small"><span data-ar="أوافق على استخدام البيانات لمعالجة هذا الاستفسار وفق " data-en="I agree to the use of this information to handle this enquiry under the ">أوافق على استخدام البيانات لمعالجة هذا الاستفسار وفق </span><a href="privacy.html" data-ar="سياسة الخصوصية" data-en="Privacy Policy">سياسة الخصوصية</a>.</label></div></div>
          <div class="col-12"><button class="btn-premium btn-primary-premium" type="submit"><i data-lucide="send"></i><span data-ar="إرسال الاستفسار" data-en="Send Enquiry">إرسال الاستفسار</span></button></div>
        </div>
        <div class="form-success" data-form-success tabindex="-1" role="status" aria-live="polite"><span class="icon-inline"><i data-lucide="circle-check-big"></i><span data-ar="تم استلام استفسارك في نسخة الاختبار. سيُربط الإرسال النهائي بالقنوات المعتمدة قبل الإطلاق." data-en="Your enquiry has been validated in this test build. Final delivery will be connected to approved channels before launch.">تم استلام استفسارك في نسخة الاختبار. سيُربط الإرسال النهائي بالقنوات المعتمدة قبل الإطلاق.</span></span></div>
      </form>
      <aside class="t5-contact-side"><div><div class="kicker" data-ar="قنوات مباشرة" data-en="Direct Channels">قنوات مباشرة</div><h2 data-ar="اختر القناة المناسبة" data-en="Choose the right channel">اختر القناة المناسبة</h2></div><a class="contact-card" href="mailto:info@targetft.com"><span class="icon-tile"><i data-lucide="mail"></i></span><span><strong data-ar="استفسار عام" data-en="General Inquiry">استفسار عام</strong><small>info@targetft.com</small></span></a><a class="contact-card" href="mailto:sales@targetft.com"><span class="icon-tile"><i data-lucide="badge-dollar-sign"></i></span><span><strong data-ar="المبيعات وطلبات الأسعار" data-en="Sales & Quotes">المبيعات وطلبات الأسعار</strong><small>sales@targetft.com</small></span></a><a class="contact-card" href="mailto:procurement@targetft.com"><span class="icon-tile"><i data-lucide="shopping-cart"></i></span><span><strong data-ar="المشتريات" data-en="Procurement">المشتريات</strong><small>procurement@targetft.com</small></span></a><a class="contact-card" href="suppliers.html"><span class="icon-tile"><i data-lucide="factory"></i></span><span><strong data-ar="المصنعون والموردون" data-en="Manufacturers & Suppliers">المصنعون والموردون</strong><small data-ar="انتقل إلى نموذج مراجعة المنتج" data-en="Go to the product review form">انتقل إلى نموذج مراجعة المنتج</small></span></a><a class="t5-support-link" href="faq.html"><i data-lucide="circle-help"></i><span data-ar="هل تحتاج إجابة سريعة؟ راجع الأسئلة الشائعة." data-en="Need a quick answer? Review the FAQ.">هل تحتاج إجابة سريعة؟ راجع الأسئلة الشائعة.</span></a></aside>
    </div>
  </section>

  <section class="target-section target-section--subtle"><div class="container target-media-split"><div><span class="target-kicker" data-ar="الموقع" data-en="Location">الموقع</span><h2 data-ar="قطر — تفاصيل الموقع تُنشر بعد اعتماد العنوان الرسمي." data-en="Qatar — location details will be published after the official address is verified.">قطر — تفاصيل الموقع تُنشر بعد اعتماد العنوان الرسمي.</h2><p data-ar="لا نعرض عنوانًا أو دبوس خريطة غير موثق. عند اعتماد العنوان المسجل، يتم استبدال هذه المنطقة بخريطة دقيقة أو رابط موقع معتمد." data-en="We do not publish an unverified address or map pin. Once the registered address is confirmed, this area will be replaced by an accurate map or verified location link.">لا نعرض عنوانًا أو دبوس خريطة غير موثق. عند اعتماد العنوان المسجل، يتم استبدال هذه المنطقة بخريطة دقيقة أو رابط موقع معتمد.</p></div><div class="target-media-frame d-grid place-items-center" aria-label="Qatar location pending verified address"><div class="text-center p-4"><span class="target-icon-tile"><i data-lucide="map-pinned"></i></span><strong class="d-block mt-2" data-ar="دولة قطر" data-en="State of Qatar">دولة قطر</strong><small data-ar="العنوان التفصيلي قيد التحقق" data-en="Detailed address pending verification">العنوان التفصيلي قيد التحقق</small></div></div></div></section>

  <section class="target-section target-section--forest"><div class="container d-lg-flex align-items-center justify-content-between gap-4"><div class="target-section-head mb-0"><span class="target-kicker" data-ar="لديك منتج غذائي؟" data-en="Have a Food Product?">لديك منتج غذائي؟</span><h2 data-ar="استخدم مسار الموردين لمراجعة المنتج والفرصة." data-en="Use the supplier route for product and opportunity review.">استخدم مسار الموردين لمراجعة المنتج والفرصة.</h2></div><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="factory"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div></section>
</BaseLayout>