---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyPortfolio from '../components/CompanyPortfolio.vue';
---
<BaseLayout active="portfolio" bodyClass="page-food-portfolio premium-v8-page" title="المنتجات والشركات | TARGET">
  <section class="premium-page-hero portfolio-hero"><div class="premium-page-hero-overlay"></div><div class="container premium-page-hero-content"><div class="hero-kicker"><i data-lucide="package-open"></i><span data-ar="نطاق المنتجات" data-en="Food Portfolio">نطاق المنتجات</span></div><h1 data-ar="محفظة غذائية انتقائية — مبنية على فرصة السوق" data-en="A selective food portfolio — built around market opportunity">محفظة غذائية انتقائية — مبنية على فرصة السوق</h1><p data-ar="نركز على فئات غذائية مختارة تتوافق مع توجه تارقت التجاري وفرص السوق القطري، مع فصل واضح بين الفئات وبيانات الشركات والمنتجات محل الاهتمام." data-en="We focus on selected food categories aligned with Target’s commercial direction and Qatar market opportunities, with a clear separation between categories and companies/products in focus.">نركز على فئات غذائية مختارة تتوافق مع توجه تارقت التجاري وفرص السوق القطري، مع فصل واضح بين الفئات وبيانات الشركات والمنتجات محل الاهتمام.</p></div></section>

  <section class="section premium-category-section"><div class="container"><div class="section-head"><div class="kicker" data-ar="الفئات الحالية" data-en="Current Categories">الفئات الحالية</div><h2 data-ar="خمس فئات غذائية واضحة" data-en="Five clear food categories">خمس فئات غذائية واضحة</h2></div><div class="premium-category-grid">
    <article><span class="premium-category-media media-tea"></span><div><i data-lucide="leaf"></i><strong data-ar="الشاي والمشروبات العشبية" data-en="Tea & Herbal Infusions">الشاي والمشروبات العشبية</strong></div></article>
    <article><span class="premium-category-media media-juice"></span><div><i data-lucide="cup-soda"></i><strong data-ar="العصائر والمشروبات التقليدية" data-en="Juices & Traditional Beverages">العصائر والمشروبات التقليدية</strong></div></article>
    <article><span class="premium-category-media media-honey"></span><div><i data-lucide="candy"></i><strong data-ar="العسل والدبس والحلويات" data-en="Honey, Molasses & Sweets">العسل والدبس والحلويات</strong></div></article>
    <article><span class="premium-category-media media-dairy"></span><div><i data-lucide="milk"></i><strong data-ar="الألبان والمجمد والمجهز" data-en="Dairy, Frozen & Prepared">الألبان والمجمد والمجهز</strong></div></article>
    <article><span class="premium-category-media media-fmcg"></span><div><i data-lucide="shopping-basket"></i><strong data-ar="الأغذية المعبأة FMCG" data-en="Packaged Food FMCG">الأغذية المعبأة FMCG</strong></div></article>
  </div></div></section>

  <section class="section portfolio-companies-section"><div class="container"><div class="section-head portfolio-section-head"><div class="kicker" data-ar="شركات ومنتجات محل اهتمامنا" data-en="Companies & Products in Focus">شركات ومنتجات محل اهتمامنا</div><h2 data-ar="شركات ومنتجات واضحة — قابلة للتحديث من مصدر واحد" data-en="Clear company and product records — updateable from one source">شركات ومنتجات واضحة — قابلة للتحديث من مصدر واحد</h2><p data-ar="البيانات المعروضة تعرّف بالشركات والمنتجات محل الاهتمام. تُضاف صور العبوات وملفات المنتجات بعد اعتمادها، والعرض لا يعني وكالة أو تمثيلًا أو حصرية." data-en="The displayed data introduces the companies and products in focus. Packaging images and product files are added after approval, and the display does not imply agency, representation or exclusivity.">البيانات المعروضة تعرّف بالشركات والمنتجات محل الاهتمام. تُضاف صور العبوات وملفات المنتجات بعد اعتمادها، والعرض لا يعني وكالة أو تمثيلًا أو حصرية.</p></div><CompanyPortfolio client:visible /></div></section>

  <section class="section premium-evaluation-section"><div class="container premium-evaluation-grid"><div><div class="kicker" data-ar="قبل أي التزام" data-en="Before Any Commitment">قبل أي التزام</div><h2 data-ar="نبدأ بالفهم والتقييم — ثم نبني المسار" data-en="We start with understanding and evaluation — then build the route">نبدأ بالفهم والتقييم — ثم نبني المسار</h2><p data-ar="نراجع طبيعة المصنع والعلامة والمنتج وفرصة السوق قبل الانتقال إلى نموذج شراكة أو مسار تجاري." data-en="We review the manufacturer, brand, product and market opportunity before moving into a partnership model or commercial route.">نراجع طبيعة المصنع والعلامة والمنتج وفرصة السوق قبل الانتقال إلى نموذج شراكة أو مسار تجاري.</p></div><div class="premium-eval-cards"><article><i data-lucide="scan-search"></i><strong data-ar="اكتشاف" data-en="Discover">اكتشاف</strong><span data-ar="فهم المنتج والجهة والفرصة." data-en="Understand the product, company and opportunity.">فهم المنتج والجهة والفرصة.</span></article><article><i data-lucide="clipboard-check"></i><strong data-ar="تقييم" data-en="Evaluate">تقييم</strong><span data-ar="تقييم الملاءمة التجارية للسوق." data-en="Assess commercial market fit.">تقييم الملاءمة التجارية للسوق.</span></article></div></div></section>

  <section class="v7-cta-section"><div class="container"><div class="v7-cta-box"><div><h2 data-ar="لديك منتج تريد مناقشة ملاءمته؟" data-en="Have a product you want to discuss?">لديك منتج تريد مناقشة ملاءمته؟</h2><p data-ar="أرسل معلومات المنتج أو الفئة ونوع الفرصة." data-en="Send product/category information and the opportunity type.">أرسل معلومات المنتج أو الفئة ونوع الفرصة.</p></div><a class="btn-premium btn-primary-premium" href="contact.html"><i data-lucide="send"></i><span data-ar="ناقش فرصة تجارية" data-en="Discuss a Commercial Opportunity">ناقش فرصة تجارية</span></a></div></div></section>
</BaseLayout>
