---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyPortfolio from '../components/CompanyPortfolio.vue';

const principles = [
  ['package','فئات مختارة','Selected Categories','نعمل على فئات غذائية محددة وواضحة بدل عرض كتالوج مفتوح وغير مركز.','We work with defined food categories rather than an open, unfocused catalogue.'],
  ['search-check','كل منتج يُراجع على حدة','Product-by-Product Review','نراجع المنتج بحسب فئته ومعلوماته والفرصة المتاحة قبل الانتقال لأي نقاش تجاري أوسع.','Each product is reviewed according to its category, information and opportunity before broader commercial discussion.'],
  ['file-check-2','بيانات دقيقة وواضحة','Accurate Product Information','لا نعرض بلد منشأ، وكالة، حصرية، تمثيلًا أو حقوق توزيع إلا إذا كانت المعلومة موثقة ومصرحًا بعرضها.','Origin, agency, exclusivity, representation or distribution rights are shown only when documented and approved for publication.'],
];

const categories = [
  ['leaf','الشاي والمشروبات العشبية','Tea & Herbal Infusions','https://images.pexels.com/photos/8330390/pexels-photo-8330390.jpeg?auto=compress&cs=tinysrgb&w=1200','شاي وأعشاب ضمن الفئات محل الاهتمام','Tea and herbal products within the current focus'],
  ['cup-soda','العصائر والمشروبات التقليدية','Juices & Traditional Beverages','https://images.pexels.com/photos/8679342/pexels-photo-8679342.jpeg?auto=compress&cs=tinysrgb&w=1200','عصائر ومشروبات تقليدية','Juices and traditional beverages'],
  ['candy','العسل والدبس والحلويات التقليدية','Honey, Molasses & Traditional Sweets','https://images.pexels.com/photos/5634207/pexels-photo-5634207.jpeg?auto=compress&cs=tinysrgb&w=1200','عسل ومنتجات تقليدية مختارة','Selected honey and traditional products'],
  ['snowflake','الألبان والمجمدات والأغذية المجهزة','Dairy, Frozen & Prepared Foods','https://images.pexels.com/photos/10591603/pexels-photo-10591603.jpeg?auto=compress&cs=tinysrgb&w=1200','منتجات ألبان وأغذية مجهزة','Dairy and prepared food products'],
  ['package','الأغذية المعبأة ومنتجات FMCG المختارة','Packaged & Selected Food FMCG','https://images.pexels.com/photos/12081286/pexels-photo-12081286.jpeg?auto=compress&cs=tinysrgb&w=1200','منتجات غذائية معبأة ضمن نطاق الاهتمام','Packaged food products within the current focus'],
];

const reviewSteps = [
  ['file-input','أرسل معلومات المنتج','Share Product Information'],
  ['search-check','نراجع الفئة والفرصة','We Review the Category & Opportunity'],
  ['message-square','نناقش الخطوة التالية','We Discuss the Next Step'],
];
---
<BaseLayout active="portfolio" bodyClass="page-food-portfolio premium-v8-page" title="المنتجات والشركات | TARGET" description="منتجات غذائية مختارة وشركات ومنتجات محل اهتمامنا للسوق القطري.">
  <div class="portfolio-canonical">
    <section class="portfolio-hero-final">
      <div class="container portfolio-hero-grid">
        <div class="portfolio-hero-copy">
          <span class="portfolio-eyebrow"><i data-lucide="package"></i><span data-ar="المنتجات والشركات" data-en="Products & Companies">المنتجات والشركات</span></span>
          <h1 data-ar="منتجات غذائية مختارة وفرص نراجعها للسوق القطري." data-en="Selected food products and opportunities we review for Qatar.">منتجات غذائية مختارة وفرص نراجعها للسوق القطري.</h1>
          <p data-ar="نركز على فئات ومنتجات غذائية مختارة، ونعرض الشركات والمنتجات التي تدخل ضمن نطاق اهتمامنا الحالي، مع مراجعة كل منتج بحسب فئته وفرصته في السوق القطري." data-en="We focus on selected food categories and products, presenting companies and products within our current area of interest while reviewing each product according to its category and opportunity in Qatar.">نركز على فئات ومنتجات غذائية مختارة، ونعرض الشركات والمنتجات التي تدخل ضمن نطاق اهتمامنا الحالي، مع مراجعة كل منتج بحسب فئته وفرصته في السوق القطري.</p>
          <div class="portfolio-hero-actions">
            <a class="portfolio-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
            <a class="portfolio-secondary" href="capabilities.html"><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span><i data-lucide="arrow-left"></i></a>
          </div>
        </div>
        <figure class="portfolio-hero-media" aria-label="Selected food categories">
          <div class="portfolio-mosaic portfolio-mosaic--main"><img src="https://images.pexels.com/photos/12081286/pexels-photo-12081286.jpeg?auto=compress&cs=tinysrgb&w=1400" alt="منتجات غذائية معبأة ضمن نطاق الاهتمام" data-ar-alt="منتجات غذائية معبأة ضمن نطاق الاهتمام" data-en-alt="Packaged food products within the current focus" width="1200" height="900" loading="eager" decoding="async" /></div>
          <div class="portfolio-mosaic portfolio-mosaic--tea"><img src="https://images.pexels.com/photos/8330390/pexels-photo-8330390.jpeg?auto=compress&cs=tinysrgb&w=900" alt="شاي وأعشاب" data-ar-alt="شاي وأعشاب" data-en-alt="Tea and herbs" width="900" height="700" loading="eager" decoding="async" /></div>
          <div class="portfolio-mosaic portfolio-mosaic--juice"><img src="https://images.pexels.com/photos/8679342/pexels-photo-8679342.jpeg?auto=compress&cs=tinysrgb&w=900" alt="عصائر ومشروبات" data-ar-alt="عصائر ومشروبات" data-en-alt="Juices and beverages" width="900" height="700" loading="eager" decoding="async" /></div>
          <figcaption><span><i data-lucide="layers-3"></i><b data-ar="فئات غذائية مختارة" data-en="Selected Food Categories">فئات غذائية مختارة</b></span><span><i data-lucide="search-check"></i><b data-ar="مراجعة منتج بمنتج" data-en="Product-by-Product Review">مراجعة منتج بمنتج</b></span></figcaption>
        </figure>
      </div>
    </section>

    <section class="portfolio-section portfolio-principle">
      <div class="container">
        <header class="portfolio-head"><span class="portfolio-kicker" data-ar="نطاق اهتمامنا" data-en="Our Current Focus">نطاق اهتمامنا</span><h2 data-ar="نركز على المنتج المناسب، لا على زيادة عدد المنتجات." data-en="We focus on product fit, not catalogue size.">نركز على المنتج المناسب، لا على زيادة عدد المنتجات.</h2><p data-ar="اهتمامنا يبدأ بالمنتج والفئة والفرصة في قطر. وجود المنتج ضمن إحدى الفئات لا يعني قبوله تلقائيًا، كما أن المنتجات خارج الفئات الحالية يمكن مناقشتها إذا كانت مناسبة لتوجه تارقت والسوق." data-en="Our focus starts with the product, category and opportunity in Qatar. Being within a listed category does not mean automatic acceptance, and products outside the current categories may still be discussed where they fit TARGET's direction and the market.">اهتمامنا يبدأ بالمنتج والفئة والفرصة في قطر. وجود المنتج ضمن إحدى الفئات لا يعني قبوله تلقائيًا، كما أن المنتجات خارج الفئات الحالية يمكن مناقشتها إذا كانت مناسبة لتوجه تارقت والسوق.</p></header>
        <div class="portfolio-principles">{principles.map(([icon,arTitle,enTitle,arBody,enBody],index)=><article><div class="portfolio-principle-top"><span class="portfolio-icon"><i data-lucide={icon}></i></span><div><span class="portfolio-principle-index">0{index+1}</span><h3 data-ar={arTitle} data-en={enTitle}>{arTitle}</h3></div></div><p data-ar={arBody} data-en={enBody}>{arBody}</p></article>)}</div>
      </div>
    </section>

    <section class="portfolio-section portfolio-categories-section">
      <div class="container">
        <header class="portfolio-head"><span class="portfolio-kicker" data-ar="الفئات الغذائية" data-en="Food Categories">الفئات الغذائية</span><h2 data-ar="الفئات التي نركز عليها حاليًا" data-en="Food categories currently in focus">الفئات التي نركز عليها حاليًا</h2><p data-ar="هذه الفئات تعكس نطاق الاهتمام الحالي، ويمكن تحديثها مع تطور المنتجات والفرص المعتمدة." data-en="These categories reflect the current focus and may evolve as approved products and opportunities change.">هذه الفئات تعكس نطاق الاهتمام الحالي، ويمكن تحديثها مع تطور المنتجات والفرص المعتمدة.</p></header>
        <div class="portfolio-category-grid">{categories.map(([icon,ar,en,image,arAlt,enAlt])=><article><span class="portfolio-category-media"><img src={image} alt={arAlt} data-ar-alt={arAlt} data-en-alt={enAlt} width="1000" height="760" loading="lazy" decoding="async" /></span><div class="portfolio-category-body"><span class="portfolio-icon"><i data-lucide={icon}></i></span><strong data-ar={ar} data-en={en}>{ar}</strong></div></article>)}</div>
      </div>
    </section>

    <section class="portfolio-section portfolio-companies-section">
      <div class="container">
        <header class="portfolio-head portfolio-companies-head"><span class="portfolio-kicker" data-ar="شركات ومنتجات محل اهتمامنا" data-en="Companies & Products in Focus">شركات ومنتجات محل اهتمامنا</span><h2 data-ar="شركات ومنتجات ضمن نطاق الاهتمام الحالي" data-en="Companies and products within the current focus">شركات ومنتجات ضمن نطاق الاهتمام الحالي</h2><p data-ar="نعرض هنا الشركات والمنتجات التي تم تأكيد بياناتها للاستخدام على الموقع. عرض الشركة أو المنتج هنا لا يعني تلقائيًا وكالة أو تمثيلًا أو حصرية أو حق توزيع ما لم يتم توثيق ذلك واعتماده بشكل منفصل." data-en="We present companies and products whose data has been confirmed for website use. Displaying a company or product here does not automatically imply agency, representation, exclusivity or distribution rights unless separately documented and approved.">نعرض هنا الشركات والمنتجات التي تم تأكيد بياناتها للاستخدام على الموقع. عرض الشركة أو المنتج هنا لا يعني تلقائيًا وكالة أو تمثيلًا أو حصرية أو حق توزيع ما لم يتم توثيق ذلك واعتماده بشكل منفصل.</p></header>
        <CompanyPortfolio client:visible />
      </div>
    </section>

    <section class="portfolio-section portfolio-review-section">
      <div class="container portfolio-review-grid">
        <div><span class="portfolio-kicker" data-ar="لديك منتج جديد؟" data-en="Have a New Product?">لديك منتج جديد؟</span><h2 data-ar="يمكننا مناقشة منتجات خارج القائمة الحالية إذا كانت الفرصة مناسبة." data-en="Products outside the current list can still be discussed where the opportunity fits.">يمكننا مناقشة منتجات خارج القائمة الحالية إذا كانت الفرصة مناسبة.</h2><p data-ar="القائمة الحالية توضح نطاق اهتمامنا اليوم، وليست قائمة مغلقة. إذا كان لديك منتج غذائي أو فئة ترى أنها مناسبة لقطر، شاركنا معلومات واضحة عنها لنراجعها." data-en="The current list shows today's focus; it is not a closed list. If you have a food product or category you believe may fit Qatar, share clear information for review.">القائمة الحالية توضح نطاق اهتمامنا اليوم، وليست قائمة مغلقة. إذا كان لديك منتج غذائي أو فئة ترى أنها مناسبة لقطر، شاركنا معلومات واضحة عنها لنراجعها.</p><a class="portfolio-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div>
        <div class="portfolio-review-steps">{reviewSteps.map(([icon,ar,en],index)=><article><span>0{index+1}</span><i data-lucide={icon}></i><b data-ar={ar} data-en={en}>{ar}</b></article>)}</div>
      </div>
    </section>

    <section class="portfolio-section portfolio-clarity-section"><div class="container"><div class="portfolio-clarity-panel"><span class="portfolio-icon portfolio-icon--large"><i data-lucide="shield-check"></i></span><div><span class="portfolio-kicker" data-ar="وضوح العلاقة التجارية" data-en="Commercial Relationship Clarity">وضوح العلاقة التجارية</span><h2 data-ar="العرض على الموقع لا ينشئ وكالة أو حصرية أو تمثيلًا رسميًا." data-en="Website display does not create agency, exclusivity or official representation.">العرض على الموقع لا ينشئ وكالة أو حصرية أو تمثيلًا رسميًا.</h2><p data-ar="إدراج شركة أو منتج هنا للتعريف والمراجعة. أي وكالة أو حصرية أو حقوق توزيع تحتاج اتفاقًا موثقًا ومحددًا بشكل منفصل." data-en="A company or product is listed here for identification and review. Any agency, exclusivity or distribution rights require a separate documented agreement.">إدراج شركة أو منتج هنا للتعريف والمراجعة. أي وكالة أو حصرية أو حقوق توزيع تحتاج اتفاقًا موثقًا ومحددًا بشكل منفصل.</p></div></div></div></section>

    <section class="portfolio-final"><div class="container"><div class="portfolio-final-panel"><div><span class="portfolio-kicker" data-ar="للمصنعين والموردين" data-en="For Manufacturers & Suppliers">للمصنعين والموردين</span><h2 data-ar="هل لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">هل لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2><p data-ar="شاركنا معلومات المنتج والفئة والفرصة لنبدأ المراجعة من نقطة واضحة." data-en="Share the product, category and opportunity information so the review starts from a clear point.">شاركنا معلومات المنتج والفئة والفرصة لنبدأ المراجعة من نقطة واضحة.</p></div><a class="portfolio-sand-button" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div></div></section>
  </div>
</BaseLayout>
