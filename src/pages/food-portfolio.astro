---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyPortfolio from '../components/CompanyPortfolio.vue';
---
<BaseLayout active="portfolio" bodyClass="page-food-portfolio premium-v8-page" title="المنتجات والشركات | TARGET" description="منتجات غذائية مختارة وشركات ومنتجات محل اهتمامنا للسوق القطري.">
  <section class="premium-page-hero portfolio-hero"><div class="premium-page-hero-overlay"></div><div class="container premium-page-hero-content"><div class="hero-kicker"><i data-lucide="package"></i><span data-ar="المنتجات والشركات" data-en="Products & Companies">المنتجات والشركات</span></div><h1 data-ar="منتجات غذائية مختارة وفرص نراجعها للسوق القطري." data-en="Selected food products and opportunities we review for Qatar.">منتجات غذائية مختارة وفرص نراجعها للسوق القطري.</h1><p data-ar="نركز على فئات غذائية واضحة ومنتجات نرى أن من المناسب مناقشة فرصتها في قطر. عرض أي شركة أو منتج هنا لا يعني وكالة أو تمثيلًا أو حصرية ما لم يتم توثيق ذلك صراحة." data-en="We focus on clear food categories and products whose opportunity in Qatar is suitable for discussion. Displaying a company or product here does not imply agency, representation or exclusivity unless expressly documented.">نركز على فئات غذائية واضحة ومنتجات نرى أن من المناسب مناقشة فرصتها في قطر. عرض أي شركة أو منتج هنا لا يعني وكالة أو تمثيلًا أو حصرية ما لم يتم توثيق ذلك صراحة.</p></div></section>

  <section class="target-section target-section--white"><div class="container target-media-split"><div><span class="target-kicker" data-ar="مبدأ المحفظة" data-en="Portfolio Principle">مبدأ المحفظة</span><h2 data-ar="نركز على المنتج المناسب، لا على زيادة عدد المنتجات." data-en="We focus on the right product, not on increasing the number of products.">نركز على المنتج المناسب، لا على زيادة عدد المنتجات.</h2><p data-ar="المنتج والفئة والفرصة في قطر هي نقطة البداية. نفضل محفظة واضحة يمكن فهمها ومراجعتها تجاريًا على قائمة طويلة غير مرتبطة بسياق السوق." data-en="The product, category and Qatar opportunity come first. We prefer a clear portfolio that can be understood and reviewed commercially over a long list without market context.">المنتج والفئة والفرصة في قطر هي نقطة البداية. نفضل محفظة واضحة يمكن فهمها ومراجعتها تجاريًا على قائمة طويلة غير مرتبطة بسياق السوق.</p></div><div class="target-media-frame"><img src="https://images.pexels.com/photos/10907746/pexels-photo-10907746.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="عبوات ومنتجات غذائية متنوعة على أرفف متجر" loading="lazy" width="1200" height="900"></div></div></section>

  <section class="section premium-category-section"><div class="container"><div class="section-head"><div class="kicker" data-ar="الفئات الغذائية" data-en="Food Categories">الفئات الغذائية</div><h2 data-ar="خمس فئات نركز عليها حاليًا" data-en="Five categories currently in focus">خمس فئات نركز عليها حاليًا</h2></div><div class="premium-category-grid">
    <article><span class="premium-category-media media-tea"></span><div><i data-lucide="leaf"></i><strong data-ar="الشاي والمشروبات العشبية" data-en="Tea & Herbal Infusions">الشاي والمشروبات العشبية</strong></div></article>
    <article><span class="premium-category-media media-juice"></span><div><i data-lucide="cup-soda"></i><strong data-ar="العصائر والمشروبات التقليدية" data-en="Juices & Traditional Beverages">العصائر والمشروبات التقليدية</strong></div></article>
    <article><span class="premium-category-media media-honey"></span><div><i data-lucide="jar"></i><strong data-ar="العسل والدبس والحلويات التقليدية" data-en="Honey, Molasses & Traditional Sweets">العسل والدبس والحلويات التقليدية</strong></div></article>
    <article><span class="premium-category-media media-dairy"></span><div><i data-lucide="snowflake"></i><strong data-ar="الألبان والمجمدات والأغذية المجهزة" data-en="Dairy, Frozen & Prepared Foods">الألبان والمجمدات والأغذية المجهزة</strong></div></article>
    <article><span class="premium-category-media media-fmcg"></span><div><i data-lucide="package"></i><strong data-ar="الأغذية المعبأة ومنتجات FMCG المختارة" data-en="Packaged & Selected Food FMCG">الأغذية المعبأة ومنتجات FMCG المختارة</strong></div></article>
  </div></div></section>

  <section class="section portfolio-companies-section"><div class="container"><div class="section-head portfolio-section-head"><div class="kicker" data-ar="شركات ومنتجات محل اهتمامنا" data-en="Companies & Products in Focus">شركات ومنتجات محل اهتمامنا</div><h2 data-ar="شركات ومنتجات نراجع فرصها ضمن المحفظة الحالية" data-en="Companies and products we review within the current portfolio">شركات ومنتجات نراجع فرصها ضمن المحفظة الحالية</h2><p data-ar="البيانات تُدار من مصدر واحد قابل للتحديث. صور المنتجات والشعارات والكتيبات تظهر فقط بعد اعتماد الأصل المناسب، والعرض لا يعني وكالة أو تمثيلًا أو حصرية." data-en="The records are maintained from one updateable source. Product photos, logos and brochures appear only after the relevant assets are approved, and display does not imply agency, representation or exclusivity.">البيانات تُدار من مصدر واحد قابل للتحديث. صور المنتجات والشعارات والكتيبات تظهر فقط بعد اعتماد الأصل المناسب، والعرض لا يعني وكالة أو تمثيلًا أو حصرية.</p></div><CompanyPortfolio client:visible /></div></section>

  <section class="target-section target-section--subtle"><div class="container target-media-split"><div><span class="target-kicker" data-ar="منتج جديد؟" data-en="New Product?">منتج جديد؟</span><h2 data-ar="لديك منتج خارج الفئات الحالية؟ يمكننا مراجعة الفرصة." data-en="Have a product outside the current categories? We can review the opportunity.">لديك منتج خارج الفئات الحالية؟ يمكننا مراجعة الفرصة.</h2><p data-ar="الفئات الحالية توضح نطاق الاهتمام، لكنها ليست وعدًا بقبول كل منتج ولا قائمة مغلقة. إذا كان لديك منتج غذائي مناسب وتريد مناقشة فرصته في قطر، أرسل معلوماته للمراجعة." data-en="The current categories show our areas of focus, but they are not an acceptance promise or a closed list. If you have a relevant food product and want to discuss its Qatar opportunity, submit the information for review.">الفئات الحالية توضح نطاق الاهتمام، لكنها ليست وعدًا بقبول كل منتج ولا قائمة مغلقة. إذا كان لديك منتج غذائي مناسب وتريد مناقشة فرصته في قطر، أرسل معلوماته للمراجعة.</p><a class="btn-premium btn-primary-premium mt-3" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div><div class="target-card"><span class="target-icon-tile"><i data-lucide="search-check"></i></span><h3 data-ar="المراجعة قبل الالتزام" data-en="Review Before Commitment">المراجعة قبل الالتزام</h3><p data-ar="نراجع الشركة والمنتج والفئة والفرصة أولًا. لا يبدأ أي التزام تجاري إلا بعد اتفاق واضح." data-en="We review the company, product, category and opportunity first. Commercial commitment begins only after clear agreement.">نراجع الشركة والمنتج والفئة والفرصة أولًا. لا يبدأ أي التزام تجاري إلا بعد اتفاق واضح.</p></div></div></section>

  <section class="target-section target-section--white"><div class="container"><div class="target-card"><span class="target-icon-tile"><i data-lucide="shield-check"></i></span><h2 data-ar="وضوح العلاقة التجارية" data-en="Commercial Relationship Clarity">وضوح العلاقة التجارية</h2><p data-ar="إدراج شركة أو منتج على الموقع لا يعني تلقائيًا وكالة أو حصرية أو تمثيلًا رسميًا أو حقوق توزيع. أي علاقة من هذا النوع تحتاج اتفاقًا موثقًا ومحددًا." data-en="Listing a company or product on the website does not automatically mean agency, exclusivity, official representation or distribution rights. Any such relationship requires specific documented agreement.">إدراج شركة أو منتج على الموقع لا يعني تلقائيًا وكالة أو حصرية أو تمثيلًا رسميًا أو حقوق توزيع. أي علاقة من هذا النوع تحتاج اتفاقًا موثقًا ومحددًا.</p></div></div></section>

  <section class="target-section target-section--forest"><div class="container d-lg-flex justify-content-between align-items-center gap-4"><div class="target-section-head mb-0"><span class="target-kicker" data-ar="للمصنعين والموردين" data-en="For Manufacturers & Suppliers">للمصنعين والموردين</span><h2 data-ar="هل لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">هل لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2></div><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div></section>
</BaseLayout>