---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyPortfolio from '../components/CompanyPortfolio.vue';

const principles = [
  ['package','فئات مختارة','Selected Categories','نعمل على فئات غذائية محددة وواضحة بدل عرض كتالوج مفتوح وغير مركز.','We work with defined food categories rather than an open, unfocused catalogue.'],
  ['search-check','كل منتج يُراجع على حدة','Product-by-Product Review','نراجع المنتج بحسب فئته ومعلوماته والفرصة المتاحة قبل الانتقال لأي نقاش تجاري أوسع.','Each product is reviewed according to its category, information and opportunity before broader commercial discussion.'],
  ['file-check-2','بيانات دقيقة وواضحة','Accurate Product Information','لا نعرض وكالة أو حصرية أو تمثيلًا أو حقوق توزيع إلا إذا كانت المعلومة موثقة ومصرحًا بعرضها.','Agency, exclusivity, representation or distribution rights are shown only when documented and approved for publication.'],
];
---
<BaseLayout active="portfolio" bodyClass="page-food-portfolio premium-v8-page" title="المنتجات والشركات | TARGET" description="منتجات غذائية مختارة وشركات ومنتجات محل اهتمامنا للسوق القطري.">
  <section class="portfolio-hero-final">
    <div class="container portfolio-hero-grid">
      <div class="portfolio-hero-copy">
        <span class="portfolio-eyebrow"><i data-lucide="package"></i><span data-ar="المنتجات والشركات" data-en="Products & Companies">المنتجات والشركات</span></span>
        <h1 data-ar="منتجات غذائية مختارة وفرص نراجعها للسوق القطري." data-en="Selected food products and opportunities we review for Qatar.">منتجات غذائية مختارة وفرص نراجعها للسوق القطري.</h1>
        <p data-ar="نركز على فئات ومنتجات غذائية مختارة، ونعرض الشركات والمنتجات التي تدخل ضمن نطاق اهتمامنا الحالي، مع مراجعة كل منتج بحسب فئته وفرصته في السوق القطري." data-en="We focus on selected food categories and products, presenting companies and products within our current area of interest while reviewing each product according to its category and opportunity in Qatar.">نركز على فئات ومنتجات غذائية مختارة، ونعرض الشركات والمنتجات التي تدخل ضمن نطاق اهتمامنا الحالي، مع مراجعة كل منتج بحسب فئته وفرصته في السوق القطري.</p>
        <div class="portfolio-hero-actions">
          <a class="btn-premium portfolio-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
          <a class="portfolio-secondary" href="capabilities.html"><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span><i data-lucide="arrow-left"></i></a>
        </div>
      </div>
      <figure class="portfolio-hero-media">
        <img src="/images/hero-food-portfolio-clean2.webp" alt="تكوين تحريري لفئات غذائية مختارة" data-ar-alt="تكوين تحريري لفئات غذائية مختارة" data-en-alt="Editorial composition of selected food categories" width="1200" height="960" loading="eager" decoding="async" />
        <figcaption><span><i data-lucide="leaf"></i><b data-ar="فئات غذائية مختارة" data-en="Selected Food Categories">فئات غذائية مختارة</b></span><span><i data-lucide="search-check"></i><b data-ar="مراجعة منتج بمنتج" data-en="Product-by-Product Review">مراجعة منتج بمنتج</b></span></figcaption>
      </figure>
    </div>
  </section>

  <section class="portfolio-section portfolio-principle">
    <div class="container">
      <header class="portfolio-head portfolio-head--center">
        <span class="portfolio-kicker" data-ar="نطاق اهتمامنا" data-en="Our Current Focus">نطاق اهتمامنا</span>
        <h2 data-ar="نركز على المنتج المناسب، لا على زيادة عدد المنتجات." data-en="We focus on product fit, not catalogue size.">نركز على المنتج المناسب، لا على زيادة عدد المنتجات.</h2>
        <p data-ar="اهتمامنا يبدأ بالمنتج والفئة والفرصة في قطر. وجود المنتج ضمن إحدى الفئات لا يعني قبوله تلقائيًا، كما أن المنتجات خارج الفئات الحالية يمكن مناقشتها إذا كانت مناسبة لتوجه تارقت والسوق." data-en="Our focus starts with the product, category and opportunity in Qatar. Being within a listed category does not mean automatic acceptance, and products outside the current categories may still be discussed where they fit TARGET's direction and the market.">اهتمامنا يبدأ بالمنتج والفئة والفرصة في قطر. وجود المنتج ضمن إحدى الفئات لا يعني قبوله تلقائيًا، كما أن المنتجات خارج الفئات الحالية يمكن مناقشتها إذا كانت مناسبة لتوجه تارقت والسوق.</p>
      </header>
      <div class="portfolio-principles">
        {principles.map(([icon,arTitle,enTitle,arBody,enBody],index) => <article><span class="portfolio-principle-index">0{index+1}</span><span class="portfolio-icon"><i data-lucide={icon}></i></span><h3 data-ar={arTitle} data-en={enTitle}>{arTitle}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></article>)}
      </div>
    </div>
  </section>

  <section class="portfolio-section portfolio-categories-section">
    <div class="container">
      <header class="portfolio-head">
        <span class="portfolio-kicker" data-ar="الفئات الغذائية" data-en="Food Categories">الفئات الغذائية</span>
        <h2 data-ar="الفئات التي نركز عليها حاليًا" data-en="Food categories currently in focus">الفئات التي نركز عليها حاليًا</h2>
        <p data-ar="هذه الفئات تعكس نطاق الاهتمام الحالي، ويمكن تحديثها مع تطور المنتجات والفرص المعتمدة." data-en="These categories reflect the current focus and may evolve as approved products and opportunities change.">هذه الفئات تعكس نطاق الاهتمام الحالي، ويمكن تحديثها مع تطور المنتجات والفرص المعتمدة.</p>
      </header>
      <div class="portfolio-category-grid">
        <article><span class="portfolio-category-media media-tea"></span><div class="portfolio-category-body"><span class="portfolio-icon"><i data-lucide="leaf"></i></span><strong data-ar="الشاي والمشروبات العشبية" data-en="Tea & Herbal Infusions">الشاي والمشروبات العشبية</strong></div></article>
        <article><span class="portfolio-category-media media-juice"></span><div class="portfolio-category-body"><span class="portfolio-icon"><i data-lucide="cup-soda"></i></span><strong data-ar="العصائر والمشروبات التقليدية" data-en="Juices & Traditional Beverages">العصائر والمشروبات التقليدية</strong></div></article>
        <article><span class="portfolio-category-media media-honey"></span><div class="portfolio-category-body"><span class="portfolio-icon"><i data-lucide="jar"></i></span><strong data-ar="العسل والدبس والحلويات التقليدية" data-en="Honey, Molasses & Traditional Sweets">العسل والدبس والحلويات التقليدية</strong></div></article>
        <article><span class="portfolio-category-media media-dairy"></span><div class="portfolio-category-body"><span class="portfolio-icon"><i data-lucide="snowflake"></i></span><strong data-ar="الألبان والمجمدات والأغذية المجهزة" data-en="Dairy, Frozen & Prepared Foods">الألبان والمجمدات والأغذية المجهزة</strong></div></article>
        <article><span class="portfolio-category-media media-fmcg"></span><div class="portfolio-category-body"><span class="portfolio-icon"><i data-lucide="package"></i></span><strong data-ar="الأغذية المعبأة ومنتجات FMCG المختارة" data-en="Packaged & Selected Food FMCG">الأغذية المعبأة ومنتجات FMCG المختارة</strong></div></article>
      </div>
    </div>
  </section>

  <section class="portfolio-section portfolio-companies-section">
    <div class="container">
      <header class="portfolio-head portfolio-companies-head">
        <span class="portfolio-kicker" data-ar="شركات ومنتجات محل اهتمامنا" data-en="Companies & Products in Focus">شركات ومنتجات محل اهتمامنا</span>
        <h2 data-ar="شركات ومنتجات ضمن نطاق الاهتمام الحالي" data-en="Companies and products within the current focus">شركات ومنتجات ضمن نطاق الاهتمام الحالي</h2>
        <p data-ar="نعرض هنا الشركات والمنتجات التي تم تأكيد بياناتها للاستخدام على الموقع. عرض الشركة أو المنتج هنا لا يعني تلقائيًا وكالة أو تمثيلًا أو حصرية أو حق توزيع ما لم يتم توثيق ذلك واعتماده بشكل منفصل." data-en="We present companies and products whose data has been confirmed for website use. Displaying a company or product here does not automatically imply agency, representation, exclusivity or distribution rights unless separately documented and approved.">نعرض هنا الشركات والمنتجات التي تم تأكيد بياناتها للاستخدام على الموقع. عرض الشركة أو المنتج هنا لا يعني تلقائيًا وكالة أو تمثيلًا أو حصرية أو حق توزيع ما لم يتم توثيق ذلك واعتماده بشكل منفصل.</p>
      </header>
      <CompanyPortfolio client:visible />
    </div>
  </section>

  <section class="portfolio-section portfolio-review-section">
    <div class="container portfolio-review-grid">
      <div>
        <span class="portfolio-kicker" data-ar="لديك منتج جديد؟" data-en="Have a New Product?">لديك منتج جديد؟</span>
        <h2 data-ar="يمكننا مناقشة منتجات خارج القائمة الحالية إذا كانت الفرصة مناسبة." data-en="Products outside the current list can still be discussed where the opportunity fits.">يمكننا مناقشة منتجات خارج القائمة الحالية إذا كانت الفرصة مناسبة.</h2>
        <p data-ar="القائمة الحالية توضح نطاق اهتمامنا اليوم، وليست قائمة مغلقة. إذا كان لديك منتج غذائي أو فئة ترى أنها مناسبة لقطر، شاركنا معلومات واضحة عنها لنراجعها." data-en="The current list shows today's focus; it is not a closed list. If you have a food product or category you believe may fit Qatar, share clear information for review.">القائمة الحالية توضح نطاق اهتمامنا اليوم، وليست قائمة مغلقة. إذا كان لديك منتج غذائي أو فئة ترى أنها مناسبة لقطر، شاركنا معلومات واضحة عنها لنراجعها.</p>
        <a class="btn-premium portfolio-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
      </div>
      <div class="portfolio-review-steps">
        <article><span>01</span><i data-lucide="file-input"></i><b data-ar="أرسل معلومات المنتج" data-en="Share Product Information">أرسل معلومات المنتج</b></article>
        <article><span>02</span><i data-lucide="search-check"></i><b data-ar="نراجع الفئة والفرصة" data-en="We Review Category & Opportunity">نراجع الفئة والفرصة</b></article>
        <article><span>03</span><i data-lucide="message-square"></i><b data-ar="نناقش الخطوة التالية" data-en="We Discuss the Next Step">نناقش الخطوة التالية</b></article>
      </div>
    </div>
  </section>

  <section class="portfolio-section portfolio-clarity-section">
    <div class="container portfolio-clarity-panel"><span class="portfolio-icon portfolio-icon--large"><i data-lucide="shield-check"></i></span><div><span class="portfolio-kicker" data-ar="وضوح العلاقة التجارية" data-en="Commercial Relationship Clarity">وضوح العلاقة التجارية</span><h2 data-ar="العرض على الموقع لا ينشئ وكالة أو حصرية أو تمثيلًا رسميًا." data-en="Website display does not create agency, exclusivity or official representation.">العرض على الموقع لا ينشئ وكالة أو حصرية أو تمثيلًا رسميًا.</h2><p data-ar="إدراج شركة أو منتج على الموقع لا يعني تلقائيًا وكالة أو حصرية أو تمثيلًا رسميًا أو حقوق توزيع. أي علاقة من هذا النوع تحتاج اتفاقًا موثقًا ومحددًا." data-en="Listing a company or product on the website does not automatically mean agency, exclusivity, official representation or distribution rights. Any such relationship requires specific documented agreement.">إدراج شركة أو منتج على الموقع لا يعني تلقائيًا وكالة أو حصرية أو تمثيلًا رسميًا أو حقوق توزيع. أي علاقة من هذا النوع تحتاج اتفاقًا موثقًا ومحددًا.</p></div></div>
  </section>

  <section class="portfolio-final">
    <div class="container portfolio-final-panel"><div><span class="portfolio-kicker" data-ar="للمصنعين والموردين" data-en="For Manufacturers & Suppliers">للمصنعين والموردين</span><h2 data-ar="هل لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">هل لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2><p data-ar="شاركنا معلومات المنتج والفئة والفرصة لنبدأ المراجعة من نقطة واضحة." data-en="Share the product, category and opportunity information so the review starts from a clear point.">شاركنا معلومات المنتج والفئة والفرصة لنبدأ المراجعة من نقطة واضحة.</p></div><a class="btn-premium portfolio-sand-button" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div>
  </section>
</BaseLayout>

<style is:global>
.page-food-portfolio{background:var(--target-cream,#F4EDE4)}
.portfolio-hero-final{position:relative;isolation:isolate;padding-block:80px;color:var(--target-cream);background:radial-gradient(circle at 16% 18%,rgba(244,237,228,.08) 0 1.5px,transparent 1.8px) 0 0/30px 30px,linear-gradient(135deg,rgba(244,237,228,.035) 25%,transparent 25%) 0 0/44px 44px,linear-gradient(315deg,rgba(192,149,82,.045) 25%,transparent 25%) 0 0/44px 44px,var(--target-forest)}
.portfolio-hero-final::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(4,44,29,.22),transparent 48%,rgba(4,44,29,.08));pointer-events:none}
.portfolio-hero-grid{display:grid;grid-template-columns:minmax(0,55fr) minmax(0,45fr);gap:48px;align-items:center}
.portfolio-hero-copy{max-width:700px}.portfolio-eyebrow,.portfolio-kicker{display:inline-flex;align-items:center;gap:8px;font-size:.875rem;font-weight:700}.portfolio-eyebrow{padding:8px 12px;border:1px solid rgba(244,237,228,.22);border-radius:999px;background:rgba(244,237,228,.08);color:var(--target-cream)}.portfolio-eyebrow svg{width:18px;height:18px;color:var(--target-sand)}
.portfolio-hero-copy h1{max-width:14ch;margin:14px 0 20px;color:var(--target-cream)!important;font-size:var(--target-h1-internal);font-weight:700;line-height:1.1}.portfolio-hero-copy p{max-width:680px;margin:0;color:rgba(244,237,228,.84)!important;font-size:var(--target-lead);line-height:1.8}
.portfolio-hero-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:28px}.portfolio-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding-inline:26px!important;border:1px solid var(--target-sand)!important;border-radius:12px!important;background:var(--target-sand)!important;color:var(--target-charcoal)!important;font-weight:700;text-decoration:none}.portfolio-primary:hover{background:#d1ae73!important;border-color:#d1ae73!important;transform:translateY(-1px)}.portfolio-secondary{display:inline-flex;align-items:center;gap:8px;min-height:52px;padding-inline:8px;color:var(--target-cream);font-weight:700;text-decoration:none}.portfolio-secondary:hover{text-decoration:underline;text-underline-offset:4px;color:var(--target-cream)}
.portfolio-hero-media{position:relative;margin:0;aspect-ratio:5/4}.portfolio-hero-media>img{display:block;width:100%;height:100%;object-fit:cover;border:1px solid rgba(244,237,228,.20);border-radius:24px;box-shadow:0 26px 54px rgba(2,31,20,.28);filter:saturate(.92) contrast(.99)}.portfolio-hero-media figcaption{position:absolute;inset-inline:20px;inset-block-end:-24px;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:10px;border:1px solid rgba(12,73,49,.14);border-radius:16px;background:rgba(255,254,251,.97);box-shadow:0 18px 38px rgba(2,31,20,.20)}.portfolio-hero-media figcaption span{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:12px;background:rgba(244,237,228,.68);color:var(--target-charcoal)}.portfolio-hero-media figcaption svg{width:20px;height:20px;color:var(--target-forest)}.portfolio-hero-media figcaption b{font-size:.78rem;line-height:1.45}
.portfolio-section{padding-block:96px}.portfolio-head{max-width:780px;margin-bottom:42px}.portfolio-head--center{margin-inline:auto;text-align:center}.portfolio-kicker{color:var(--target-forest)}.portfolio-kicker::before{content:"";width:22px;height:2px;border-radius:999px;background:var(--target-sand)}.portfolio-head h2,.portfolio-review-section h2,.portfolio-clarity-panel h2,.portfolio-final-panel h2{margin:10px 0 16px;color:var(--target-charcoal);font-size:var(--target-h2);font-weight:700;line-height:1.2}.portfolio-head p,.portfolio-review-section p,.portfolio-clarity-panel p,.portfolio-final-panel p{color:rgba(38,38,38,.74);font-size:1.04rem;line-height:1.8}
.portfolio-principle{background:#fff}.portfolio-principles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.portfolio-principles article{position:relative;min-height:240px;padding:28px;border:1px solid rgba(12,73,49,.12);border-radius:16px;background:var(--target-cream);overflow:hidden}.portfolio-principle-index{position:absolute;inset-inline-end:20px;top:18px;color:rgba(12,73,49,.14);font:800 .86rem/1 Manrope,sans-serif}.portfolio-icon{display:grid;place-items:center;width:52px;height:52px;border:1px solid rgba(12,73,49,.12);border-radius:14px;background:#fff;color:var(--target-forest)}.portfolio-icon svg{width:28px;height:28px;stroke-width:1.8}.portfolio-principles h3{margin:18px 0 10px;font-size:1.22rem!important;font-weight:700}.portfolio-principles p{margin:0;color:rgba(38,38,38,.69);font-size:.96rem;line-height:1.72}
.portfolio-categories-section{background:var(--target-cream)}.portfolio-category-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}.portfolio-category-grid article{overflow:hidden;border:1px solid rgba(12,73,49,.12);border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(38,38,38,.045)}.portfolio-category-media{display:block;aspect-ratio:4/3;background-size:cover;background-position:center}.portfolio-category-body{min-height:150px;padding:18px;display:flex;flex-direction:column;gap:14px}.portfolio-category-body .portfolio-icon{width:46px;height:46px;border-radius:13px;background:rgba(12,73,49,.045)}.portfolio-category-body .portfolio-icon svg{width:24px;height:24px}.portfolio-category-body strong{font-size:1rem;line-height:1.55;color:var(--target-charcoal)}
.portfolio-companies-section{background:#fff}.portfolio-companies-head{max-width:860px}.portfolio-companies-section .portfolio-app{margin-top:10px}
.portfolio-review-section{background:var(--target-cream)}.portfolio-review-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:48px;align-items:center}.portfolio-review-steps{display:grid;gap:12px;padding:12px;border:1px solid rgba(12,73,49,.12);border-radius:20px;background:#fff}.portfolio-review-steps article{display:grid;grid-template-columns:42px 48px 1fr;align-items:center;gap:12px;min-height:78px;padding:12px 14px;border-radius:14px;background:rgba(244,237,228,.58)}.portfolio-review-steps span{color:var(--target-sand);font:800 .74rem/1 Manrope,sans-serif}.portfolio-review-steps svg{width:26px;height:26px;color:var(--target-forest)}.portfolio-review-steps b{font-size:.96rem;line-height:1.5}
.portfolio-clarity-section{background:#fff}.portfolio-clarity-panel{display:grid;grid-template-columns:72px 1fr;gap:24px;align-items:start;padding:34px;border:1px solid rgba(12,73,49,.12);border-radius:20px;background:var(--target-cream)}.portfolio-icon--large{width:64px;height:64px;border-radius:17px}.portfolio-icon--large svg{width:32px;height:32px}
.portfolio-final{padding-block:72px;background:var(--target-cream)}.portfolio-final-panel{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:36px;padding:38px 42px;border-radius:22px;background:var(--target-charcoal);color:var(--target-cream)}.portfolio-final-panel::before{content:"";position:absolute;width:230px;height:230px;inset:-120px auto auto -85px;border:1px solid rgba(192,149,82,.24);border-radius:50%}.portfolio-final-panel .portfolio-kicker{color:var(--target-sand)}.portfolio-final-panel h2{color:#fff!important;max-width:760px}.portfolio-final-panel p{color:rgba(244,237,228,.78)!important;margin-bottom:0}.portfolio-sand-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;white-space:nowrap;padding-inline:26px!important;border:1px solid var(--target-sand)!important;border-radius:12px!important;background:var(--target-sand)!important;color:var(--target-charcoal)!important;font-weight:700;text-decoration:none}
@media(max-width:1199.98px){.portfolio-section{padding-block:80px}.portfolio-category-grid{grid-template-columns:repeat(3,1fr)}}
