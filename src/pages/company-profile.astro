---
import BaseLayout from '../layouts/BaseLayout.astro';
const snapshot = [
  ['building-2','شركة تعمل من قطر','Qatar-Based'],
  ['ship','تجارة واستيراد أغذية','Food Trading & Import'],
  ['factory','مصنعون وموردون وعلامات','Manufacturers, Suppliers & Brands'],
  ['map-pinned','تركيز على السوق القطري','Qatar Market Focus'],
];
const explore = [
  ['building-2','عن تارقت','About TARGET','about.html'],
  ['route','كيف نعمل','How We Work','capabilities.html'],
  ['package','المنتجات والشركات','Products & Companies','food-portfolio.html'],
  ['map-pinned','السوق القطري','Qatar Market','qatar-market.html'],
];
---
<BaseLayout active="profile" bodyClass="page-company-profile" title="الملف التعريفي | TARGET" description="نظرة مختصرة على تارقت لتجارة الأغذية وروابط إلى نشاط الشركة ومنتجاتها وطريقة عملها في قطر.">
  <section class="target-hero"><div class="container target-hero__grid"><div class="target-hero__copy"><span class="target-kicker"><i data-lucide="book-open-text"></i><span data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</span></span><h1 data-ar="تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر." data-en="Explore TARGET and its food trading activity in Qatar.">تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر.</h1><p data-ar="هذه الصفحة تعطي نظرة سريعة على الشركة وتربطك بالمعلومات الأساسية على الموقع. النسخة الرسمية القابلة للتحميل تظهر فقط بعد اعتماد ملف الـPDF النهائي ونشره." data-en="This page provides a concise company overview and connects you with the key information across the website. The official downloadable version appears only after the final PDF is approved and published.">هذه الصفحة تعطي نظرة سريعة على الشركة وتربطك بالمعلومات الأساسية على الموقع. النسخة الرسمية القابلة للتحميل تظهر فقط بعد اعتماد ملف الـPDF النهائي ونشره.</p><div class="target-hero__actions"><a class="btn-premium btn-primary-premium" href="about.html"><i data-lucide="building-2"></i><span data-ar="عن تارقت" data-en="About TARGET">عن تارقت</span></a><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div></div><div class="resource-hero-visual"><img src="/assets/brand/target-logo-horizontal-forest.svg" alt="TARGET — تارقت لتجارة الأغذية" width="520" height="160"></div></div></section>

  <section class="target-section target-section--white"><div class="container"><header class="target-section-head"><span class="target-kicker" data-ar="لمحة عن الشركة" data-en="Company Snapshot">لمحة عن الشركة</span><h2 data-ar="نشاط تجاري واضح حول المنتجات الغذائية وفرص السوق القطري." data-en="A clear commercial focus around food products and Qatar market opportunities.">نشاط تجاري واضح حول المنتجات الغذائية وفرص السوق القطري.</h2></header><div class="profile-snapshot">{snapshot.map(([icon,ar,en]) => <article><span class="target-icon-tile"><i data-lucide={icon}></i></span><strong data-ar={ar} data-en={en}>{ar}</strong></article>)}</div></div></section>

  <section class="target-section target-section--subtle"><div class="container"><header class="target-section-head"><span class="target-kicker" data-ar="استكشف تارقت" data-en="Explore TARGET">استكشف تارقت</span><h2 data-ar="المعلومات الأساسية موزعة على صفحات واضحة بدل تكرار الملف كاملًا داخل الموقع." data-en="Key information is organized across clear pages rather than duplicating the full profile on the website.">المعلومات الأساسية موزعة على صفحات واضحة بدل تكرار الملف كاملًا داخل الموقع.</h2></header><div class="target-card-grid">{explore.map(([icon,ar,en,href]) => <a class="target-card text-decoration-none" href={href}><span class="target-icon-tile"><i data-lucide={icon}></i></span><h3 data-ar={ar} data-en={en}>{ar}</h3><i data-lucide="arrow-up-left"></i></a>)}</div></div></section>

  <section class="target-section target-section--white"><div class="container profile-resource"><div class="profile-preview"><img src="/assets/brand/target-logo-horizontal-cream.svg" alt="TARGET"><small data-ar="المعاينة النهائية تستخدم الغلاف الحقيقي للملف التعريفي بعد اعتماده." data-en="The final preview will use the approved Company Profile cover.">المعاينة النهائية تستخدم الغلاف الحقيقي للملف التعريفي بعد اعتماده.</small></div><div class="profile-resource-copy"><span class="profile-resource-status"><i data-lucide="file-text"></i><span data-ar="أصل نهائي مطلوب" data-en="Final Asset Required">أصل نهائي مطلوب</span></span><h2 data-ar="الملف التعريفي الرسمي" data-en="Official Company Profile">الملف التعريفي الرسمي</h2><p data-ar="مساحة التحميل محفوظة داخل النظام، لكن لا نعرض زر تحميل وهميًا أو ملف مصمم غير معتمد. عند استلام النسخة النهائية، تُنشر على المسار الثابت المخصص ويظهر الغلاف الحقيقي وبيانات الملف الموثقة فقط." data-en="The download area is reserved in the system, but no fake download button or unapproved designer draft is published. Once the final version is received, it will use the stable production path with the real cover and verified document metadata only.">مساحة التحميل محفوظة داخل النظام، لكن لا نعرض زر تحميل وهميًا أو ملف مصمم غير معتمد. عند استلام النسخة النهائية، تُنشر على المسار الثابت المخصص ويظهر الغلاف الحقيقي وبيانات الملف الموثقة فقط.</p><div class="mt-4 d-flex flex-wrap gap-2"><a class="btn-premium btn-light-premium" href="about.html"><i data-lucide="book-open-text"></i><span data-ar="اقرأ عن تارقت" data-en="Read About TARGET">اقرأ عن تارقت</span></a><a class="btn-premium btn-light-premium" href="capabilities.html"><i data-lucide="route"></i><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span></a></div></div></div></section>

  <section class="target-section target-section--forest"><div class="container d-lg-flex justify-content-between align-items-center gap-4"><div class="target-section-head mb-0"><span class="target-kicker" data-ar="الخطوة التالية" data-en="Next Commercial Step">الخطوة التالية</span><h2 data-ar="لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2></div><div class="d-flex flex-wrap gap-2"><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a><a class="btn-premium btn-outline-light" href="contact.html"><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span></a></div></div></section>
</BaseLayout>