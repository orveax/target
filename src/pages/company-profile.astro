---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyProfileAsset as profileAsset } from '../data/companyProfile';

const snapshot = [
  ['building-2','قطر','Qatar-Based'],
  ['ship','تجارة واستيراد أغذية','Food Trading & Import'],
  ['factory','مصنعون وموردون وعلامات','Manufacturers, Suppliers & Brands'],
  ['map-pinned','تركيز على السوق القطري','Qatar Market Focus'],
];

const explore = [
  ['building-2','عن تارقت','About TARGET','دور الشركة، الرؤية والرسالة، ووضوح التعامل التجاري.','Company role, vision and mission, and commercial clarity.','about.html'],
  ['route','كيف نعمل','How We Work','مسار مراجعة المنتج والخطوات التجارية من الفرصة إلى السوق.','Product review and the commercial route from opportunity to market.','capabilities.html'],
  ['package','المنتجات والشركات','Products & Companies','الفئات الحالية والشركات والمنتجات الموجودة ضمن نطاق الاهتمام.','Current categories, companies and products within the active focus.','products-companies.html'],
  ['map-pinned','السوق القطري','Qatar Market','كيف ننظر إلى ملاءمة المنتج والقنوات والسياق التجاري داخل قطر.','How product fit, channels and commercial context are considered in Qatar.','qatar-market.html'],
];

const documentMeta = [
  ['file-text','نوع الملف','File Type',profileAsset.type],
  ['files','عدد الصفحات','Page Count',profileAsset.pages],
  ['hard-drive','حجم الملف','File Size',profileAsset.size],
  ['calendar-check-2','الإصدار','Version',profileAsset.version],
];
---
<BaseLayout active="profile" bodyClass="page-company-profile premium-v8-page" title="الملف التعريفي | TARGET For Food Trading" description="تعرف على تارقت ونشاطها في تجارة واستيراد الأغذية داخل قطر، واستعرض أو حمّل الملف التعريفي الرسمي للشركة.">
  <section class="cp-hero" data-profile-download-state="active" data-profile-build="20260818-04">
    <span class="cp-hero-pattern" aria-hidden="true"></span>
    <div class="container cp-hero-grid">
      <div class="cp-hero-copy">
        <span class="cp-eyebrow"><i data-lucide="book-open-text"></i><span data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</span></span>
        <h1 data-ar="تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر." data-en="An overview of TARGET and its food-trading activity in Qatar.">تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر.</h1>
        <p data-ar="يقدم الملف التعريفي نظرة مركزة على تارقت، نشاطها في تجارة واستيراد الأغذية، الفئات والمنتجات محل الاهتمام، وطريقة تعاملها مع المصنعين والموردين والسوق القطري." data-en="The Company Profile provides a focused overview of TARGET, its food trading and import activity, the categories and products in focus, and how it works with manufacturers, suppliers and the Qatar market.">يقدم الملف التعريفي نظرة مركزة على تارقت، نشاطها في تجارة واستيراد الأغذية، الفئات والمنتجات محل الاهتمام، وطريقة تعاملها مع المصنعين والموردين والسوق القطري.</p>

        <div class="cp-actions cp-hero-actions">
          <a class="cp-btn cp-btn-primary cp-btn-download" href={profileAsset.downloadUrl} target="_blank" rel="noopener noreferrer" data-profile-download>
            <i data-lucide="download"></i><span data-ar="تحميل الملف التعريفي" data-en="Download Company Profile">تحميل الملف التعريفي</span>
          </a>
          <a class="cp-btn cp-btn-secondary" href={profileAsset.viewUrl} target="_blank" rel="noopener noreferrer" data-profile-view>
            <i data-lucide="external-link"></i><span data-ar="عرض الملف" data-en="View Profile">عرض الملف</span>
          </a>
          <a class="cp-btn cp-btn-tertiary" href="about.html">
            <span data-ar="عن تارقت" data-en="About TARGET">عن تارقت</span><i data-lucide="arrow-up-left"></i>
          </a>
        </div>

        <div class="cp-hero-meta" aria-label="بيانات سريعة عن الملف" data-ar-aria="بيانات سريعة عن الملف" data-en-aria="Company Profile quick facts">
          <span><i data-lucide="file-text"></i>PDF</span>
          <span><i data-lucide="files"></i><b data-ar="10 صفحات" data-en="10 pages">10 صفحات</b></span>
          <span><i data-lucide="hard-drive"></i>{profileAsset.size}</span>
        </div>
      </div>

      <figure class="cp-profile-preview cp-profile-preview-hero">
        <div class="cp-preview-shell">
          <img src={profileAsset.previewUrl} alt="غلاف الملف التعريفي الرسمي لشركة تارقت" data-ar-alt="غلاف الملف التعريفي الرسمي لشركة تارقت" data-en-alt="Official TARGET Company Profile cover" width="1600" height="900" loading="eager" decoding="async" referrerpolicy="no-referrer" />
        </div>
        <figcaption><i data-lucide="badge-check"></i><span data-ar="معاينة من الملف النهائي الموثق" data-en="Preview from the verified final file">معاينة من الملف النهائي الموثق</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="cp-section cp-snapshot">
    <div class="container cp-snapshot-grid">
      <div class="cp-snapshot-copy">
        <span class="cp-kicker" data-ar="نظرة سريعة" data-en="At a Glance">نظرة سريعة</span>
        <h2 data-ar="شركة قطرية لتجارة واستيراد الأغذية." data-en="A Qatar-based food trading and import company.">شركة قطرية لتجارة واستيراد الأغذية.</h2>
        <p data-ar="تعمل تارقت من قطر مع المصنعين والعلامات الغذائية والموردين لمناقشة المنتجات والفرص المناسبة للسوق القطري، ومراجعة ملاءمة المنتج قبل الانتقال إلى الاستيراد والتجارة وقنوات البيع والتوزيع المناسبة وفق طبيعة الفرصة." data-en="TARGET operates from Qatar and works with food manufacturers, brands and suppliers to discuss suitable products and opportunities for the Qatar market, reviewing product fit before moving into import, trading and appropriate sales and distribution channels according to the opportunity.">تعمل تارقت من قطر مع المصنعين والعلامات الغذائية والموردين لمناقشة المنتجات والفرص المناسبة للسوق القطري، ومراجعة ملاءمة المنتج قبل الانتقال إلى الاستيراد والتجارة وقنوات البيع والتوزيع المناسبة وفق طبيعة الفرصة.</p>
      </div>
      <div class="cp-facts">
        {snapshot.map(([icon,ar,en]) => (
          <article class="cp-fact"><span class="cp-icon"><i data-lucide={icon}></i></span><strong data-ar={ar} data-en={en}>{ar}</strong></article>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-section cp-explore">
    <div class="container">
      <header class="cp-section-head">
        <span class="cp-kicker" data-ar="داخل الموقع" data-en="Explore TARGET">داخل الموقع</span>
        <h2 data-ar="أربع مسارات تكمل الصورة." data-en="Four routes to understand TARGET further.">أربع مسارات تكمل الصورة.</h2>
        <p data-ar="الملف التعريفي يقدم النظرة المركزة، بينما توضح الصفحات التالية دور تارقت وطريقة العمل والمنتجات وسياق السوق القطري بمزيد من التفاصيل." data-en="The Company Profile provides the focused overview, while these routes explain TARGET, how it works, products and the Qatar market in more detail.">الملف التعريفي يقدم النظرة المركزة، بينما توضح الصفحات التالية دور تارقت وطريقة العمل والمنتجات وسياق السوق القطري بمزيد من التفاصيل.</p>
      </header>
      <div class="cp-route-grid">
        {explore.map(([icon,ar,en,arBody,enBody,href],index) => (
          <a class="cp-route" href={href}>
            <span class="cp-route-number">0{index + 1}</span>
            <span class="cp-icon"><i data-lucide={icon}></i></span>
            <div class="cp-route-copy"><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div>
            <span class="cp-route-arrow"><i data-lucide="arrow-up-left"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-section cp-resource" id="profile-resource" data-profile-title={profileAsset.title}>
    <div class="container">
      <div class="cp-resource-panel">
        <figure class="cp-resource-preview cp-profile-preview">
          <div class="cp-preview-shell"><img src={profileAsset.previewUrl} alt="معاينة غلاف الملف التعريفي الرسمي" data-ar-alt="معاينة غلاف الملف التعريفي الرسمي" data-en-alt="Official Company Profile cover preview" width="1600" height="900" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>
        </figure>
        <div class="cp-resource-copy">
          <span class="cp-resource-status"><i data-lucide="badge-check"></i><span data-ar="النسخة النهائية متاحة" data-en="Final profile available">النسخة النهائية متاحة</span></span>
          <span class="cp-kicker" data-ar="الملف الرسمي" data-en="Official Company Profile">الملف الرسمي</span>
          <h2 data-ar="اعرض الملف التعريفي أو حمّله مباشرة." data-en="View or download the official Company Profile.">اعرض الملف التعريفي أو حمّله مباشرة.</h2>
          <p data-ar="نسخة PDF الرسمية جاهزة للمشاركة مع المصنعين والموردين والجهات التجارية، وتتضمن المحتوى التعريفي المعتمد لتارقت." data-en="The official PDF is ready to share with manufacturers, suppliers and commercial stakeholders and contains TARGET's approved corporate profile content.">نسخة PDF الرسمية جاهزة للمشاركة مع المصنعين والموردين والجهات التجارية، وتتضمن المحتوى التعريفي المعتمد لتارقت.</p>

          <div class="cp-resource-actions">
            <a class="cp-btn cp-btn-primary cp-btn-download" href={profileAsset.downloadUrl} target="_blank" rel="noopener noreferrer" data-profile-download>
              <i data-lucide="download"></i><span data-ar="تحميل PDF" data-en="Download PDF">تحميل PDF</span>
            </a>
            <a class="cp-btn cp-btn-secondary" href={profileAsset.viewUrl} target="_blank" rel="noopener noreferrer" data-profile-view>
              <i data-lucide="eye"></i><span data-ar="عرض الملف" data-en="View Profile">عرض الملف</span>
            </a>
          </div>

          <div class="cp-resource-proof"><span class="cp-proof-icon"><i data-lucide="shield-check"></i></span><div><strong data-ar="المعاينة والبيانات مرتبطة بالنسخة النهائية الموثقة." data-en="The preview and metadata are tied to the verified final file.">المعاينة والبيانات مرتبطة بالنسخة النهائية الموثقة.</strong><p data-ar="يمكنك عرض الملف في نافذة مستقلة أو استخدام مسار التنزيل المباشر من زر التحميل." data-en="You can open the profile in a separate tab or use the direct download route from the download button.">يمكنك عرض الملف في نافذة مستقلة أو استخدام مسار التنزيل المباشر من زر التحميل.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="cp-section cp-document-info" aria-labelledby="cp-document-info-title">
    <div class="container cp-document-info-grid">
      <div class="cp-document-info-copy">
        <span class="cp-kicker" data-ar="بيانات المستند" data-en="Document Information">بيانات المستند</span>
        <h2 id="cp-document-info-title" data-ar="بيانات موثقة من النسخة النهائية." data-en="Verified information from the final file.">بيانات موثقة من النسخة النهائية.</h2>
        <p data-ar="نعرض فقط البيانات التي تم التحقق منها مباشرة من ملف PDF النهائي، بدون إضافة حقول افتراضية أو معلومات غير مرتبطة بالمستند." data-en="Only metadata verified directly from the final PDF is shown here, without placeholder fields or unrelated information.">نعرض فقط البيانات التي تم التحقق منها مباشرة من ملف PDF النهائي، بدون إضافة حقول افتراضية أو معلومات غير مرتبطة بالمستند.</p>
      </div>
      <div class="cp-meta-grid">
        {documentMeta.map(([icon,ar,en,value]) => (
          <article class="cp-meta-item"><span class="cp-icon"><i data-lucide={icon}></i></span><div><small data-ar={ar} data-en={en}>{ar}</small><strong dir="ltr">{value}</strong></div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-next">
    <div class="container">
      <div class="cp-next-panel">
        <div><span class="cp-kicker" data-ar="الخطوة التالية" data-en="Next Step">الخطوة التالية</span><h2 data-ar="لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2></div>
        <div class="cp-next-actions">
          <a class="cp-btn cp-next-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
          <a class="cp-btn cp-next-secondary" href="contact.html"><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span><i data-lucide="arrow-up-left"></i></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
