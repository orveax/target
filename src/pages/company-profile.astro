---
import BaseLayout from '../layouts/BaseLayout.astro';
const snapshot = [
  ['building-2','شركة تعمل من قطر','Qatar-Based'],
  ['ship','تجارة واستيراد أغذية','Food Trading & Import'],
  ['factory','مصنعون وموردون وعلامات','Manufacturers, Suppliers & Brands'],
  ['map-pinned','تركيز على السوق القطري','Qatar Market Focus'],
];
const explore = [
  ['building-2','عن تارقت','About TARGET','about.html'],
  ['route','كيف نعمل','How We Work','capabilities.html'],
  ['package','المنتجات والشركات','Products & Companies','food-portfolio.html'],
  ['map-pinned','السوق القطري','Qatar Market','qatar-market.html'],
];
const meta = [
  ['اللغة','Arabic / English','Language','Arabic / English'],
  ['الإصدار','Internal Preview V1','Version','Internal Preview V1'],
  ['الحالة','نسخة داخلية مؤقتة','Status','Temporary Internal Preview'],
  ['التحديث','15 أغسطس 2026','Updated','15 August 2026'],
];
---
<BaseLayout active="profile" bodyClass="page-company-profile" title="الملف التعريفي | TARGET" description="نظرة مختصرة على تارقت لتجارة الأغذية وروابط إلى نشاط الشركة ومنتجاتها وطريقة عملها في قطر.">
  <section class="target-hero"><div class="container target-hero__grid"><div class="target-hero__copy"><span class="target-kicker"><i data-lucide="book-open-text"></i><span data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</span></span><h1 data-ar="تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر." data-en="Explore TARGET and its food trading activity in Qatar.">تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر.</h1><p data-ar="هذه الصفحة تقدم نسخة داخلية مؤقتة من العرض التعريفي حتى استبدالها بالملف الرسمي النهائي، مع الحفاظ على نفس الهيكل ومسار الموارد." data-en="This page provides a temporary internal profile preview until the final official document replaces it, while keeping the same structure and resource path.">هذه الصفحة تقدم نسخة داخلية مؤقتة من العرض التعريفي حتى استبدالها بالملف الرسمي النهائي، مع الحفاظ على نفس الهيكل ومسار الموارد.</p><div class="target-hero__actions"><a class="btn-premium btn-primary-premium" href="about.html"><i data-lucide="building-2"></i><span data-ar="عن تارقت" data-en="About TARGET">عن تارقت</span></a><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div></div><div class="resource-hero-visual"><div class="profile-cover-placeholder"><img src="/assets/brand/target-logo-horizontal-forest.svg" alt="TARGET — تارقت لتجارة الأغذية" width="420" height="130"><span data-ar="COMPANY PROFILE" data-en="COMPANY PROFILE">COMPANY PROFILE</span><strong data-ar="نسخة داخلية مؤقتة" data-en="Temporary Internal Preview">نسخة داخلية مؤقتة</strong><small>2026</small></div></div></div></section>

  <section class="target-section target-section--white"><div class="container"><header class="target-section-head"><span class="target-kicker" data-ar="لمحة عن الشركة" data-en="Company Snapshot">لمحة عن الشركة</span><h2 data-ar="نشاط تجاري واضح حول المنتجات الغذائية وفرص السوق القطري." data-en="A clear commercial focus around food products and Qatar market opportunities.">نشاط تجاري واضح حول المنتجات الغذائية وفرص السوق القطري.</h2></header><div class="profile-snapshot">{snapshot.map(([icon,ar,en]) => <article><span class="target-icon-tile"><i data-lucide={icon}></i></span><strong data-ar={ar} data-en={en}>{ar}</strong></article>)}</div></div></section>

  <section class="target-section target-section--subtle"><div class="container"><header class="target-section-head"><span class="target-kicker" data-ar="استكشف تارقت" data-en="Explore TARGET">استكشف تارقت</span><h2 data-ar="المعلومات الأساسية موزعة على صفحات واضحة بدل تكرار الملف كاملًا داخل الموقع." data-en="Key information is organized across clear pages rather than duplicating the full profile on the website.">المعلومات الأساسية موزعة على صفحات واضحة بدل تكرار الملف كاملًا داخل الموقع.</h2></header><div class="target-card-grid">{explore.map(([icon,ar,en,href]) => <a class="target-card text-decoration-none" href={href}><span class="target-icon-tile"><i data-lucide={icon}></i></span><h3 data-ar={ar} data-en={en}>{ar}</h3><i data-lucide="arrow-up-left"></i></a>)}</div></div></section>

  <section class="target-section target-section--white"><div class="container profile-resource"><div class="profile-preview profile-preview--temporary"><img src="/images/hero-food-portfolio-clean2.webp" alt="عرض بصري مؤقت للملف التعريفي" data-ar-alt="عرض بصري مؤقت للملف التعريفي" data-en-alt="Temporary visual preview for the company profile"><div class="profile-preview-badge" data-ar="TEMPORARY PREVIEW" data-en="TEMPORARY PREVIEW">TEMPORARY PREVIEW</div></div><div class="profile-resource-copy"><span class="profile-resource-status"><i data-lucide="file-text"></i><span data-ar="نسخة داخلية جاهزة للمراجعة" data-en="Internal Preview Ready">نسخة داخلية جاهزة للمراجعة</span></span><h2 data-ar="الملف التعريفي — معاينة مؤقتة" data-en="Company Profile — Temporary Preview">الملف التعريفي — معاينة مؤقتة</h2><p data-ar="نعتمد حاليًا غلافًا وبيانات مؤقتة داخلية حتى يصل الملف الرسمي. هذا لا يوقف البناء أو المراجعة؛ وعند اعتماد الأصل النهائي يتم استبداله داخل نفس المسار والواجهة دون إعادة تصميم الصفحة." data-en="A controlled temporary cover and metadata are being used internally until the final official file arrives. This does not block build or review; the final asset can replace it in the same route and interface without redesigning the page.">نعتمد حاليًا غلافًا وبيانات مؤقتة داخلية حتى يصل الملف الرسمي. هذا لا يوقف البناء أو المراجعة؛ وعند اعتماد الأصل النهائي يتم استبداله داخل نفس المسار والواجهة دون إعادة تصميم الصفحة.</p><div class="profile-meta-grid">{meta.map(([arLabel,arValue,enLabel,enValue]) => <div><small data-ar={arLabel} data-en={enLabel}>{arLabel}</small><strong data-ar={arValue} data-en={enValue}>{arValue}</strong></div>)}</div></div></div></section>

  <section class="target-section target-section--forest"><div class="container d-lg-flex justify-content-between align-items-center gap-4"><div class="target-section-head mb-0"><span class="target-kicker" data-ar="الخطوة التالية" data-en="Next Commercial Step">الخطوة التالية</span><h2 data-ar="لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2></div><div class="d-flex flex-wrap gap-2"><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a><a class="btn-premium btn-outline-light" href="contact.html"><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span></a></div></div></section>
</BaseLayout>
