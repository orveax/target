---
import BaseLayout from '../layouts/BaseLayout.astro';

const snapshot = [
  ['building-2','قطر','Qatar-Based'],
  ['ship','تجارة واستيراد أغذية','Food Trading & Import'],
  ['factory','مصنعون وموردون وعلامات','Manufacturers, Suppliers & Brands'],
  ['map-pinned','تركيز على السوق القطري','Qatar Market Focus'],
];

const explore = [
  ['building-2','عن تارقت','About TARGET','دور الشركة، الرؤية والرسالة، ووضوح التعامل التجاري.','Company role, vision and mission, and commercial clarity.','about.html'],
  ['route','كيف نعمل','How We Work','مسار مراجعة المنتج والخطوات التجارية من الفرصة إلى السوق.','Product review and the commercial route from opportunity to market.','capabilities.html'],
  ['package','المنتجات والشركات','Products & Companies','الفئات الحالية والشركات والمنتجات الموجودة ضمن نطاق الاهتمام.','Current categories, companies and products within the active focus.','food-portfolio.html'],
  ['map-pinned','السوق القطري','Qatar Market','كيف ننظر إلى ملاءمة المنتج والقنوات والسياق التجاري داخل قطر.','How product fit, channels and commercial context are considered in Qatar.','qatar-market.html'],
];

const documentMeta = [
  ['اللغات','العربية / الإنجليزية','Languages','Arabic / English'],
  ['نوع الملف','PDF','File Type','PDF'],
  ['هيكل المحتوى','ملف تعريفي من 10 صفحات','Content Structure','10-page Company Profile'],
];
---
<BaseLayout active="profile" bodyClass="page-company-profile premium-v8-page" title="الملف التعريفي | TARGET For Food Trading" description="تعرف على تارقت ونشاطها في تجارة واستيراد الأغذية داخل قطر، واستكشف الملف التعريفي والمسارات الرئيسية للموقع.">
  <section class="cp-hero">
    <div class="container cp-hero-grid">
      <div class="cp-hero-copy">
        <span class="cp-eyebrow"><i data-lucide="book-open-text"></i><span data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</span></span>
        <h1 data-ar="تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر." data-en="An overview of TARGET and its food-trading activity in Qatar.">تعرف على تارقت ونشاطها التجاري في الأغذية داخل قطر.</h1>
        <p data-ar="يقدم الملف التعريفي نظرة مركزة على تارقت، نشاطها في تجارة واستيراد الأغذية، الفئات والمنتجات محل الاهتمام، وطريقة تعاملها مع المصنعين والموردين والسوق القطري." data-en="The Company Profile provides a focused overview of TARGET, its food trading and import activity, the categories and products in focus, and how it works with manufacturers, suppliers and the Qatar market.">يقدم الملف التعريفي نظرة مركزة على تارقت، نشاطها في تجارة واستيراد الأغذية، الفئات والمنتجات محل الاهتمام، وطريقة تعاملها مع المصنعين والموردين والسوق القطري.</p>
        <div class="cp-actions">
          <span class="cp-btn cp-btn-primary" aria-disabled="true"><i data-lucide="file-down"></i><span data-ar="تحميل الملف التعريفي PDF" data-en="Download Company Profile PDF">تحميل الملف التعريفي PDF</span></span>
          <a class="cp-btn cp-btn-secondary" href="about.html"><i data-lucide="building-2"></i><span data-ar="عن تارقت" data-en="About TARGET">عن تارقت</span></a>
        </div>
      </div>

      <div class="cp-document-stage" aria-label="معاينة داخلية مضبوطة لغلاف الملف التعريفي">
        <article class="cp-document">
          <img class="cp-document-logo" src="/assets/brand/target-logo-horizontal-forest.svg" alt="TARGET — تارقت لتجارة الأغذية" width="420" height="130" />
          <span class="cp-document-stamp" data-ar="INTERNAL PREVIEW" data-en="INTERNAL PREVIEW">INTERNAL<br/>PREVIEW</span>
          <div class="cp-document-main">
            <span class="cp-document-label">TARGET FOR FOOD TRADING</span>
            <strong data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</strong>
            <small data-ar="تجارة واستيراد الأغذية — قطر" data-en="Food Trading & Import — Qatar">تجارة واستيراد الأغذية — قطر</small>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="cp-section cp-snapshot">
    <div class="container cp-snapshot-grid">
      <div class="cp-snapshot-copy">
        <span class="cp-kicker" data-ar="نظرة سريعة" data-en="At a Glance">نظرة سريعة</span>
        <h2 data-ar="شركة قطرية لتجارة واستيراد الأغذية." data-en="A Qatar-based food trading and import company.">شركة قطرية لتجارة واستيراد الأغذية.</h2>
        <p data-ar="تعمل تارقت من قطر مع المصنعين والعلامات الغذائية والموردين لمناقشة المنتجات والفرص المناسبة للسوق القطري، ومراجعة ملاءمة المنتج قبل الانتقال إلى الاستيراد والتجارة وقنوات البيع والتوزيع المناسبة وفق طبيعة الفرصة." data-en="TARGET operates from Qatar and works with food manufacturers, brands and suppliers to discuss suitable products and opportunities for the Qatar market, reviewing product fit before moving into import, trading and appropriate sales and distribution channels according to the opportunity.">تعمل تارقت من قطر مع المصنعين والعلامات الغذائية والموردين لمناقشة المنتجات والفرص المناسبة للسوق القطري، ومراجعة ملاءمة المنتج قبل الانتقال إلى الاستيراد والتجارة وقنوات البيع والتوزيع المناسبة وفق طبيعة الفرصة.</p>
      </div>
      <div class="cp-facts">
        {snapshot.map(([icon,ar,en]) => (
          <article class="cp-fact">
            <span class="cp-icon"><i data-lucide={icon}></i></span>
            <strong data-ar={ar} data-en={en}>{ar}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-section cp-explore">
    <div class="container">
      <header class="cp-section-head">
        <span class="cp-kicker" data-ar="داخل الموقع" data-en="Explore TARGET">داخل الموقع</span>
        <h2 data-ar="أربع مسارات تكمل الصورة." data-en="Four routes to understand TARGET further.">أربع مسارات تكمل الصورة.</h2>
        <p data-ar="الملف التعريفي يقدم النظرة المركزة، بينما توضح الصفحات التالية دور تارقت وطريقة العمل والمنتجات وسياق السوق القطري بمزيد من التفاصيل." data-en="The Company Profile provides the focused overview, while these routes explain TARGET, how it works, products and the Qatar market in more detail.">الملف التعريفي يقدم النظرة المركزة، بينما توضح الصفحات التالية دور تارقت وطريقة العمل والمنتجات وسياق السوق القطري بمزيد من التفاصيل.</p>
      </header>
      <div class="cp-route-grid">
        {explore.map(([icon,ar,en,arBody,enBody,href]) => (
          <a class="cp-route" href={href}>
            <span class="cp-icon"><i data-lucide={icon}></i></span>
            <h3 data-ar={ar} data-en={en}>{ar}</h3>
            <p data-ar={arBody} data-en={enBody}>{arBody}</p>
            <span class="cp-route-arrow"><i data-lucide="arrow-up-left"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cp-section cp-resource" id="profile-resource">
    <div class="container">
      <div class="cp-resource-panel">
        <div class="cp-resource-preview">
          <article class="cp-document">
            <img class="cp-document-logo" src="/assets/brand/target-logo-horizontal-forest.svg" alt="TARGET — تارقت لتجارة الأغذية" width="420" height="130" />
            <span class="cp-document-stamp" data-ar="INTERNAL PREVIEW" data-en="INTERNAL PREVIEW">INTERNAL<br/>PREVIEW</span>
            <div class="cp-document-main">
              <span class="cp-document-label">TARGET FOR FOOD TRADING</span>
              <strong data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</strong>
              <small data-ar="تجارة واستيراد الأغذية — قطر" data-en="Food Trading & Import — Qatar">تجارة واستيراد الأغذية — قطر</small>
            </div>
          </article>
        </div>
        <div class="cp-resource-copy">
          <span class="cp-resource-status"><i data-lucide="file-check-2"></i><span data-ar="مسار المورد جاهز — الأصل النهائي قيد الاستبدال" data-en="Resource route ready — final asset to replace preview">مسار المورد جاهز — الأصل النهائي قيد الاستبدال</span></span>
          <h2 data-ar="حمّل النسخة الرسمية من الملف التعريفي." data-en="Download the official Company Profile.">حمّل النسخة الرسمية من الملف التعريفي.</h2>
          <p data-ar="تتضمن النسخة الرسمية المحتوى المعتمد للملف التعريفي بصيغة مناسبة للمشاركة مع المصنعين والموردين والجهات التجارية." data-en="The official PDF contains the approved Company Profile content in a format suitable for sharing with manufacturers, suppliers and commercial stakeholders.">تتضمن النسخة الرسمية المحتوى المعتمد للملف التعريفي بصيغة مناسبة للمشاركة مع المصنعين والموردين والجهات التجارية.</p>
          <div class="cp-resource-actions">
            <span class="cp-btn cp-btn-primary" aria-disabled="true"><i data-lucide="file-down"></i><span data-ar="تحميل الملف التعريفي PDF" data-en="Download Company Profile PDF">تحميل الملف التعريفي PDF</span></span>
            <a class="cp-btn cp-btn-secondary" href="about.html"><span data-ar="عن تارقت" data-en="About TARGET">عن تارقت</span><i data-lucide="arrow-up-left"></i></a>
          </div>
          <small class="cp-resource-note" data-ar="المعاينة الحالية داخلية ومضبوطة بصريًا. عند استلام الملف النهائي يُستبدل في نفس المسار دون إعادة تصميم الصفحة." data-en="The current preview is a controlled internal visual. The final file can replace it on the same route without redesigning the page.">المعاينة الحالية داخلية ومضبوطة بصريًا. عند استلام الملف النهائي يُستبدل في نفس المسار دون إعادة تصميم الصفحة.</small>

          <div class="cp-meta">
            <span class="cp-kicker" data-ar="معلومات المستند" data-en="Document Information">معلومات المستند</span>
            <div class="cp-meta-grid">
              {documentMeta.map(([arLabel,arValue,enLabel,enValue]) => (
                <div class="cp-meta-item">
                  <small data-ar={arLabel} data-en={enLabel}>{arLabel}</small>
                  <strong data-ar={arValue} data-en={enValue}>{arValue}</strong>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cp-next">
    <div class="container">
      <div class="cp-next-panel">
        <div>
          <span class="cp-kicker" data-ar="الخطوة التالية" data-en="Next Step">الخطوة التالية</span>
          <h2 data-ar="لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2>
        </div>
        <div class="cp-next-actions">
          <a class="cp-btn cp-next-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
          <a class="cp-btn cp-next-secondary" href="contact.html"><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span><i data-lucide="arrow-up-left"></i></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
