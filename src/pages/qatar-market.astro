---
import BaseLayout from '../layouts/BaseLayout.astro';
const reviewInputs = [
  ['building-2','الشركة أو المصنع','Company / Manufacturer'],
  ['package','المنتج والفئة','Product / Category'],
  ['map-pinned','الفرصة التي تريد مناقشتها في قطر','The Qatar Opportunity to Discuss'],
  ['file-text','المعلومات التجارية المتاحة','Available Commercial Information'],
];
const checkpoints = [
  ['search-check','ملاءمة المنتج','Product Fit','نراجع المنتج والفئة في سياق الفرصة المطروحة.','We review the product and category in the context of the opportunity.'],
  ['file-check-2','اتفاق واضح','Clear Agreement','أي التزام يبدأ بعد اتفاق واضح على طريقة العمل.','Commitment starts only after clear agreement on how to work.'],
  ['ship','الاستيراد والتجارة','Import & Trading','تتحرك خطوات التجارة والاستيراد بحسب المنتج والاتفاق.','Trading and import steps move according to the product and agreement.'],
  ['route','البيع والتوزيع','Sales & Distribution','قنوات البيع والتوزيع تُحدد بحسب المنتج والفرصة.','Sales and distribution channels are defined according to the product and opportunity.'],
];
---
<BaseLayout active="market" bodyClass="page-qatar-market premium-v8-page" title="السوق القطري | TARGET" description="كيف تراجع تارقت فرصة المنتج في السوق القطري قبل التحرك التجاري.">
  <section class="target-hero"><div class="container target-hero__grid"><div class="target-hero__copy"><span class="target-kicker"><i data-lucide="map-pinned"></i><span data-ar="السوق القطري" data-en="Qatar Market">السوق القطري</span></span><h1 data-ar="فرصة المنتج في قطر تبدأ بفهم السوق قبل التحرك." data-en="A product opportunity in Qatar starts with understanding the market before moving forward.">فرصة المنتج في قطر تبدأ بفهم السوق قبل التحرك.</h1><p data-ar="ننظر إلى المنتج في سياق فئته وفرصته وطريقة العمل المناسبة في قطر، ثم نحدد الخطوة التالية من خلال نقاش تجاري واضح حول الاستيراد والتجارة وقنوات البيع والتوزيع." data-en="We look at the product in the context of its category, opportunity and an appropriate way of working in Qatar, then define the next step through a clear commercial discussion around import, trading, sales and distribution channels.">ننظر إلى المنتج في سياق فئته وفرصته وطريقة العمل المناسبة في قطر، ثم نحدد الخطوة التالية من خلال نقاش تجاري واضح حول الاستيراد والتجارة وقنوات البيع والتوزيع.</p><div class="target-hero__actions"><a class="btn-premium btn-primary-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a><a class="btn-premium btn-light-premium" href="capabilities.html"><i data-lucide="route"></i><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span></a></div></div><div class="target-hero__media"><img src="https://images.pexels.com/photos/10907746/pexels-photo-10907746.jpeg?auto=compress&cs=tinysrgb&w=1600" alt="منتجات غذائية معبأة على أرفف بيع" width="1600" height="1280"><span class="target-media-caption" data-ar="سياق بيع وتوزيع غذائي — صورة تحريرية توضيحية" data-en="Food retail and distribution context — editorial illustration">سياق بيع وتوزيع غذائي — صورة تحريرية توضيحية</span></div></div></section>

  <section class="target-section target-section--white"><div class="container target-media-split"><div><span class="target-kicker" data-ar="سياق السوق" data-en="Market Context">سياق السوق</span><h2 data-ar="ماذا يعني السوق القطري للمنتج؟" data-en="What does the Qatar market mean for a product?">ماذا يعني السوق القطري للمنتج؟</h2><p><strong data-ar="لا يوجد مسار واحد يناسب كل المنتجات." data-en="There is no single route that fits every product.">لا يوجد مسار واحد يناسب كل المنتجات.</strong></p><p data-ar="الفئة، طبيعة المنتج، المعلومات المتاحة وطريقة العمل المقترحة كلها تؤثر في الخطوة التالية. لذلك نبدأ بالمراجعة قبل افتراض قناة أو نموذج ثابت." data-en="The category, product characteristics, available information and proposed way of working all affect the next step. We therefore start with review rather than assuming a fixed channel or model.">الفئة، طبيعة المنتج، المعلومات المتاحة وطريقة العمل المقترحة كلها تؤثر في الخطوة التالية. لذلك نبدأ بالمراجعة قبل افتراض قناة أو نموذج ثابت.</p></div><div class="target-media-frame"><img src="https://images.pexels.com/photos/11835350/pexels-photo-11835350.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="صناديق كرتونية على أرفف تخزين" loading="lazy" width="1200" height="900"></div></div></section>

  <section class="target-section target-section--subtle"><div class="container"><header class="target-section-head"><span class="target-kicker" data-ar="قبل التحرك" data-en="Before Moving Forward">قبل التحرك</span><h2 data-ar="ما الذي نراجعه أولًا؟" data-en="What do we review first?">ما الذي نراجعه أولًا؟</h2></header><div class="target-card-grid">{reviewInputs.map(([icon,ar,en]) => <article class="target-card"><span class="target-icon-tile"><i data-lucide={icon}></i></span><h3 data-ar={ar} data-en={en}>{ar}</h3></article>)}</div></div></section>

  <section class="target-section target-section--white"><div class="container"><header class="target-section-head"><span class="target-kicker" data-ar="من المنتج إلى السوق" data-en="From Product to Market">من المنتج إلى السوق</span><h2 data-ar="أربع نقاط تجارية تحدد الخطوة التالية" data-en="Four commercial checkpoints define the next step">أربع نقاط تجارية تحدد الخطوة التالية</h2></header><div class="target-card-grid">{checkpoints.map(([icon,ar,en,arBody,enBody],index) => <article class="target-card"><small>0{index+1}</small><span class="target-icon-tile"><i data-lucide={icon}></i></span><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></article>)}</div></div></section>

  <section class="target-section target-section--subtle"><div class="container target-media-split"><div><span class="target-kicker" data-ar="قنوات البيع والتوزيع" data-en="Sales & Distribution Context">قنوات البيع والتوزيع</span><h2 data-ar="قنوات البيع والتوزيع تُحدد بحسب المنتج، لا بقالب ثابت." data-en="Sales and distribution channels are defined by the product, not by a fixed template.">قنوات البيع والتوزيع تُحدد بحسب المنتج، لا بقالب ثابت.</h2><p data-ar="المنتج هو الذي يحدد القناة المناسبة؛ نراجع الفرصة بشكل عملي، ثم يأتي توسيع الوصول بعد بداية لها أساس تجاري واضح." data-en="The product determines the suitable channel. We review the opportunity practically, and wider reach follows only after a commercially grounded start.">المنتج هو الذي يحدد القناة المناسبة؛ نراجع الفرصة بشكل عملي، ثم يأتي توسيع الوصول بعد بداية لها أساس تجاري واضح.</p></div><div class="target-card"><span class="target-icon-tile"><i data-lucide="store"></i></span><h3 data-ar="المنتج أولًا" data-en="Product First">المنتج أولًا</h3><p data-ar="لا نعد بقناة بيع أو تغطية أو حجم مبيعات قبل معرفة المنتج والاتفاق على طريقة العمل." data-en="We do not promise a sales channel, coverage or sales volume before understanding the product and agreeing how to work.">لا نعد بقناة بيع أو تغطية أو حجم مبيعات قبل معرفة المنتج والاتفاق على طريقة العمل.</p></div></div></section>

  <section class="target-section target-section--white"><div class="container"><div class="target-card"><span class="target-icon-tile"><i data-lucide="shield-check"></i></span><h2 data-ar="وضوح تجاري قبل أي التزام" data-en="Commercial clarity before commitment">وضوح تجاري قبل أي التزام</h2><p data-ar="مناقشة المنتج لا تعني قبولًا تلقائيًا، ولا تضمن مبيعات أو إدراجًا أو تغطية أو حجمًا أو نموًا. كما لا تنشئ وكالة أو حصرية أو تمثيلًا رسميًا ما لم يتم توثيق ذلك في اتفاق واضح." data-en="A product discussion does not mean automatic acceptance and does not guarantee sales, listing, coverage, volume or growth. It also does not create agency, exclusivity or official representation unless documented in a clear agreement.">مناقشة المنتج لا تعني قبولًا تلقائيًا، ولا تضمن مبيعات أو إدراجًا أو تغطية أو حجمًا أو نموًا. كما لا تنشئ وكالة أو حصرية أو تمثيلًا رسميًا ما لم يتم توثيق ذلك في اتفاق واضح.</p></div></div></section>

  <section class="target-section target-section--forest"><div class="container d-lg-flex align-items-center justify-content-between gap-4"><div class="target-section-head mb-0"><span class="target-kicker" data-ar="هل لديك منتج؟" data-en="Have a Product?">هل لديك منتج؟</span><h2 data-ar="لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2></div><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a></div></section>
</BaseLayout>