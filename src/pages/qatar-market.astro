---
import BaseLayout from '../layouts/BaseLayout.astro';

const marketContext = [
  ['package','المنتج والفئة','Product & Category','نبدأ بفهم المنتج والفئة وما الذي يقدمه المورد أو المصنع فعلًا.','We start by understanding the product, its category and what the supplier or manufacturer actually offers.'],
  ['file-check-2','معلومات واضحة','Clear Product Information','كلما كانت معلومات المنتج والشركة والتعبئة والمواد المتاحة أوضح، كان النقاش التجاري أكثر دقة.','The clearer the product, company, packaging and available material information is, the more precise the commercial discussion becomes.'],
  ['handshake','طريقة العمل','Commercial Arrangement','طريقة العمل لا تُفترض مسبقًا؛ تُناقش وتُحدد عندما تكون الفرصة مناسبة للطرفين.','The way of working is not assumed in advance; it is discussed and defined when the opportunity fits both sides.'],
  ['route','قنوات الوصول','Sales & Distribution Channels','القناة المناسبة تعتمد على المنتج والفئة والفرصة، ولا نفترض تغطية موحدة لكل المنتجات.','The suitable channel depends on the product, category and opportunity; we do not assume one coverage model for every product.'],
];

const reviewInputs = [
  ['building-2','الشركة أو المصنع','Company / Manufacturer','من هي الجهة؟ وما المنتج أو العلامة التي تريد مناقشتها؟','Who is the manufacturer or supplier, and what product or brand is being discussed?'],
  ['package','المنتج والفئة','Product / Category','ما نوع المنتج؟ وما الفئة التي ينتمي إليها؟ وما المعلومات المتاحة عنه؟','What is the product, category and available product information?'],
  ['map-pinned','الفرصة المطلوبة في قطر','Qatar Opportunity','ما الذي تريد مناقشته تحديدًا: دخول المنتج، الاستيراد والتجارة، البيع والتوزيع، أو فرصة تجارية أخرى مرتبطة بالمنتج؟','What specifically do you want to discuss in Qatar: product entry, import and trading, sales and distribution, or another product-related commercial opportunity?'],
  ['file-text','المعلومات التجارية المتاحة','Available Commercial Information','عندما تصل المناقشة لهذه المرحلة، تساعد معلومات العبوات والكميات المتاحة والأسعار والشروط التجارية على تحديد إمكانية الانتقال للخطوة التالية.','When the discussion reaches this stage, packaging, available quantities, pricing and commercial terms help determine whether the next step is practical.'],
];

const checkpoints = [
  ['search-check','ملاءمة المنتج','Product Fit','نراجع المنتج والفئة والفرصة المطروحة في قطر قبل أي التزام تجاري.','We review the product, category and opportunity in Qatar before any commercial commitment.'],
  ['file-check-2','اتفاق واضح','Clear Agreement','إذا كانت الفرصة مناسبة، نحدد طريقة العمل والشروط الأساسية قبل التنفيذ.','If the opportunity is suitable, we define the way of working and key commercial terms before execution.'],
  ['ship','الاستيراد والتجارة','Import & Trading','تبدأ أنشطة الاستيراد والتجارة فقط وفق الاتفاق وطبيعة المنتج والخطوات المطلوبة.','Import and trading activities begin only according to the agreement, product and required steps.'],
  ['route','البيع والتوزيع','Sales & Distribution','يتم التعامل مع قنوات البيع والتوزيع بحسب المنتج والفئة والفرصة المتاحة داخل قطر.','Sales and distribution channels are addressed according to the product, category and opportunity in Qatar.'],
];

const channelPrinciples = [
  ['package','المنتج يحدد طبيعة القناة','Product Shapes the Channel','نبدأ من طبيعة المنتج والفئة.','We start with the nature of the product and category.'],
  ['route','الفرصة تُراجع عمليًا','Opportunity Is Reviewed Practically','لا نفترض أن كل قناة مناسبة لكل منتج.','We do not assume every channel fits every product.'],
  ['move-up-right','التوسع يأتي بعد البداية','Expansion Comes After the Start','الاستمرار أو توسيع الوصول يُراجع بعد وجود أساس تجاري مناسب.','Continuation or wider reach is reviewed after a suitable commercial foundation exists.'],
];
---
<BaseLayout active="market" bodyClass="page-qatar-market premium-v8-page" title="السوق القطري | TARGET" description="كيف تراجع تارقت فرصة المنتج في السوق القطري قبل التحرك التجاري.">
  <section class="qm-hero">
    <div class="container qm-hero-grid">
      <div class="qm-hero-copy">
        <span class="qm-eyebrow"><i data-lucide="map-pinned"></i><span data-ar="السوق القطري" data-en="Qatar Market">السوق القطري</span></span>
        <h1 data-ar="فرصة المنتج في قطر تبدأ بفهم السوق قبل التحرك." data-en="A product opportunity in Qatar starts with understanding the market before moving forward.">فرصة المنتج في قطر تبدأ بفهم السوق قبل التحرك.</h1>
        <p data-ar="ننظر إلى المنتج في سياق فئته وفرصته وطريقة العمل المناسبة في قطر، ثم نحدد الخطوة التالية من خلال نقاش تجاري واضح حول الاستيراد والتجارة وقنوات البيع والتوزيع." data-en="We look at the product in the context of its category, opportunity and suitable way of working in Qatar, then define the next step through a clear commercial discussion around import, trading and sales and distribution channels.">ننظر إلى المنتج في سياق فئته وفرصته وطريقة العمل المناسبة في قطر، ثم نحدد الخطوة التالية من خلال نقاش تجاري واضح حول الاستيراد والتجارة وقنوات البيع والتوزيع.</p>
        <div class="qm-actions">
          <a class="qm-primary" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
          <a class="qm-secondary" href="capabilities.html"><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span><i data-lucide="arrow-left"></i></a>
        </div>
      </div>
      <figure class="qm-hero-media">
        <img src="/images/home-food-trade-editorial-v1.png" alt="منتجات غذائية وتعبئة في سياق تجاري" data-ar-alt="منتجات غذائية وتعبئة في سياق تجاري" data-en-alt="Packaged food products in a commercial context" width="1400" height="1120" loading="eager" decoding="async" />
        <figcaption>
          <span><i data-lucide="package"></i><b data-ar="منتج وفئة" data-en="Product & Category">منتج وفئة</b></span>
          <span><i data-lucide="store"></i><b data-ar="قنوات السوق" data-en="Market Channels">قنوات السوق</b></span>
          <span><i data-lucide="file-check-2"></i><b data-ar="اتفاق واضح" data-en="Clear Agreement">اتفاق واضح</b></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="qm-section qm-context">
    <div class="container qm-context-grid">
      <div class="qm-context-copy">
        <span class="qm-kicker" data-ar="ماذا يعني السوق القطري للمنتج؟" data-en="Qatar Market Context">ماذا يعني السوق القطري للمنتج؟</span>
        <h2 data-ar="لا يوجد مسار واحد يناسب كل المنتجات." data-en="There is no single route that fits every product.">لا يوجد مسار واحد يناسب كل المنتجات.</h2>
        <p data-ar="اختلاف الفئة والمنتج والمعلومات التجارية وطبيعة الفرصة يعني أن نقطة البداية وقنوات البيع والتوزيع وطريقة العمل قد تختلف من منتج إلى آخر." data-en="Differences in category, product, commercial information and the opportunity mean the starting point, sales and distribution channels, and way of working may vary from one product to another.">اختلاف الفئة والمنتج والمعلومات التجارية وطبيعة الفرصة يعني أن نقطة البداية وقنوات البيع والتوزيع وطريقة العمل قد تختلف من منتج إلى آخر.</p>
        <div class="qm-context-points">
          {marketContext.map(([icon,ar,en,arBody,enBody],index) => <article><span class="qm-point-index">0{index+1}</span><span class="qm-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div></article>)}
        </div>
      </div>
      <figure class="qm-context-media">
        <img src="/images/home-food-trade-hero-v1.png" alt="تعبئة وتجهيز منتجات غذائية" data-ar-alt="تعبئة وتجهيز منتجات غذائية" data-en-alt="Food packaging and product preparation" width="1200" height="960" loading="lazy" decoding="async" />
        <div class="qm-market-note"><i data-lucide="map-pinned"></i><span data-ar="السوق القطري هو سياق المراجعة — وليس وعدًا بقناة أو نتيجة ثابتة." data-en="Qatar is the market context for review — not a promise of a fixed channel or outcome.">السوق القطري هو سياق المراجعة — وليس وعدًا بقناة أو نتيجة ثابتة.</span></div>
      </figure>
    </div>
  </section>

  <section class="qm-section qm-review">
    <div class="container qm-review-grid">
      <header class="qm-section-head">
        <span class="qm-kicker" data-ar="قبل الخطوة التالية" data-en="Before the Next Step">قبل الخطوة التالية</span>
        <h2 data-ar="أربع معلومات تساعدنا على فهم الفرصة بشكل أفضل." data-en="Four areas help us understand the opportunity more clearly.">أربع معلومات تساعدنا على فهم الفرصة بشكل أفضل.</h2>
        <p data-ar="هذه المعلومات تساعد في النقاش التجاري الأولي، وليست معايير قبول آلية أو درجات تقييم." data-en="These are discussion inputs for the initial commercial review, not automatic acceptance criteria or scoring rules.">هذه المعلومات تساعد في النقاش التجاري الأولي، وليست معايير قبول آلية أو درجات تقييم.</p>
      </header>
      <div class="qm-checklist">
        {reviewInputs.map(([icon,ar,en,arBody,enBody],index) => <article><span class="qm-check-number">0{index+1}</span><span class="qm-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div></article>)}
      </div>
    </div>
  </section>

  <section class="qm-section qm-checkpoints">
    <div class="container">
      <header class="qm-section-head qm-head-wide">
        <span class="qm-kicker" data-ar="من المنتج إلى السوق" data-en="From Product to Market">من المنتج إلى السوق</span>
        <h2 data-ar="أربع نقاط تجارية واضحة قبل أن يصبح المنتج جزءًا من فرصة فعلية." data-en="Four clear commercial checkpoints before a product becomes an active opportunity.">أربع نقاط تجارية واضحة قبل أن يصبح المنتج جزءًا من فرصة فعلية.</h2>
      </header>
      <div class="qm-checkpoint-track">
        {checkpoints.map(([icon,ar,en,arBody,enBody],index) => <article class={index === 1 ? 'is-focus' : ''}><span class="qm-track-number">0{index+1}</span><span class="qm-icon"><i data-lucide={icon}></i></span><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></article>)}
      </div>
    </div>
  </section>

  <section class="qm-section qm-channels">
    <div class="container qm-channel-grid">
      <div class="qm-channel-copy">
        <span class="qm-kicker" data-ar="الوصول إلى السوق" data-en="Reaching the Market">الوصول إلى السوق</span>
        <h2 data-ar="قنوات البيع والتوزيع تُحدد بحسب المنتج، لا بقالب ثابت." data-en="Sales and distribution channels are shaped by the product, not a fixed template.">قنوات البيع والتوزيع تُحدد بحسب المنتج، لا بقالب ثابت.</h2>
        <p data-ar="بعض المنتجات تحتاج طريقة وصول مختلفة عن غيرها. لذلك نتعامل مع موضوع البيع والتوزيع كجزء من فرصة المنتج نفسها، وليس كوعْد بتغطية أو عدد منافذ محدد مسبقًا." data-en="Different products may require different routes to market. We therefore treat sales and distribution as part of the product opportunity itself, not as a promise of predefined coverage or outlet numbers.">بعض المنتجات تحتاج طريقة وصول مختلفة عن غيرها. لذلك نتعامل مع موضوع البيع والتوزيع كجزء من فرصة المنتج نفسها، وليس كوعْد بتغطية أو عدد منافذ محدد مسبقًا.</p>
      </div>
      <div class="qm-channel-network" aria-label="قنوات الوصول إلى السوق">
        {channelPrinciples.map(([icon,ar,en,arBody,enBody],index) => <article class={index === 1 ? 'is-center' : ''}><span class="qm-icon"><i data-lucide={icon}></i></span><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></article>)}
      </div>
    </div>
  </section>

  <section class="qm-section qm-clarity">
    <div class="container">
      <div class="qm-clarity-panel">
        <span class="qm-icon qm-icon-large"><i data-lucide="shield-check"></i></span>
        <div>
          <span class="qm-kicker" data-ar="توقعات واضحة" data-en="Clear Expectations">توقعات واضحة</span>
          <h2 data-ar="نناقش الفرصة بوضوح — دون وعود غير موثقة." data-en="We discuss the opportunity clearly — without unsupported promises.">نناقش الفرصة بوضوح — دون وعود غير موثقة.</h2>
          <p data-ar="مناقشة المنتج لا تعني قبولًا تلقائيًا، ولا تضمن مبيعات أو إدراجًا أو تغطية أو حجمًا أو نموًا. كما لا تنشئ وكالة أو حصرية أو تمثيلًا رسميًا ما لم يتم توثيق ذلك في اتفاق واضح." data-en="A product discussion does not mean automatic acceptance and does not guarantee sales, listing, coverage, volume or growth. It also does not create agency, exclusivity or official representation unless documented in a clear agreement.">مناقشة المنتج لا تعني قبولًا تلقائيًا، ولا تضمن مبيعات أو إدراجًا أو تغطية أو حجمًا أو نموًا. كما لا تنشئ وكالة أو حصرية أو تمثيلًا رسميًا ما لم يتم توثيق ذلك في اتفاق واضح.</p>
          <a class="qm-clarity-contact" href="contact.html"><i data-lucide="mail"></i><span data-ar="اتصل بنا" data-en="Contact Us">اتصل بنا</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="qm-final">
    <div class="container">
      <div class="qm-final-panel">
        <div><span class="qm-kicker" data-ar="هل لديك منتج؟" data-en="Have a Product?">هل لديك منتج؟</span><h2 data-ar="لديك منتج غذائي تريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">لديك منتج غذائي تريد مناقشة فرصته في قطر؟</h2><p data-ar="شاركنا معلومات واضحة عن المنتج والفرصة التي تريد مناقشتها، وسنبدأ بالمراجعة قبل أي التزام تجاري." data-en="Share clear information about the product and the opportunity you want to discuss, and we will begin with review before any commercial commitment.">شاركنا معلومات واضحة عن المنتج والفرصة التي تريد مناقشتها، وسنبدأ بالمراجعة قبل أي التزام تجاري.</p></div>
        <a class="qm-final-button" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
.page-qatar-market{background:var(--target-cream,#F4EDE4)}
.qm-hero{position:relative;overflow:hidden;padding-block:88px 96px;background:radial-gradient(circle at 8% 20%,rgba(12,73,49,.055),transparent 24%),linear-gradient(135deg,rgba(192,149,82,.045) 25%,transparent 25%) 0 0/56px 56px,var(--target-cream)}
.qm-hero-grid{display:grid;grid-template-columns:minmax(0,55fr) minmax(0,45fr);gap:50px;align-items:center}.qm-hero-copy{max-width:710px}.qm-eyebrow,.qm-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--target-forest);font-size:.875rem;font-weight:700}.qm-eyebrow{padding:8px 12px;border:1px solid rgba(12,73,49,.12);border-radius:999px;background:rgba(255,255,255,.64)}.qm-eyebrow svg{width:18px;height:18px;color:var(--target-sand)}
.qm-hero h1{max-width:13ch;margin:15px 0 20px;color:var(--target-charcoal)!important;font-size:var(--target-h1-internal);font-weight:700;line-height:1.1}.qm-hero-copy>p{max-width:680px;color:rgba(38,38,38,.74)!important;font-size:var(--target-lead);line-height:1.8}.qm-actions{display:flex;flex-wrap:wrap;align-items:center;gap:13px;margin-top:28px}.qm-primary,.qm-final-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding-inline:26px;border:1px solid var(--target-forest);border-radius:12px;background:var(--target-forest);color:var(--target-cream);font-weight:700;text-decoration:none;transition:.2s}.qm-primary:hover{background:#073b29;color:#fff;transform:translateY(-1px)}.qm-secondary{display:inline-flex;align-items:center;gap:8px;min-height:52px;padding-inline:8px;color:var(--target-forest);font-weight:700;text-decoration:none}.qm-secondary:hover{text-decoration:underline;text-underline-offset:4px;color:var(--target-forest)}
.qm-hero-media{position:relative;margin:0;aspect-ratio:5/4}.qm-hero-media>img{display:block;width:100%;height:100%;object-fit:cover;border:1px solid rgba(12,73,49,.12);border-radius:24px;box-shadow:0 24px 56px rgba(38,38,38,.13);filter:saturate(.88) contrast(.99)}.qm-hero-media::after{content:"";position:absolute;inset:0;border-radius:24px;background:linear-gradient(180deg,transparent 62%,rgba(12,73,49,.22));pointer-events:none}.qm-hero-media figcaption{position:absolute;z-index:2;inset-inline:18px;inset-block-end:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px;border-radius:15px;background:rgba(255,254,251,.95);box-shadow:0 14px 32px rgba(38,38,38,.14)}.qm-hero-media figcaption span{display:flex;align-items:center;gap:7px;padding:9px 10px;border-radius:11px;background:rgba(244,237,228,.7);color:var(--target-charcoal)}.qm-hero-media figcaption svg{width:19px;height:19px;color:var(--target-forest)}.qm-hero-media figcaption b{font-size:.72rem;line-height:1.35}
.qm-section{padding-block:96px}.qm-kicker::before{content:"";width:22px;height:2px;border-radius:999px;background:var(--target-sand)}.qm-section h2,.qm-final h2{margin:10px 0 16px;color:var(--target-charcoal);font-size:var(--target-h2);font-weight:700;line-height:1.2}.qm-section-head{max-width:650px}.qm-section-head>p,.qm-context-copy>p,.qm-channel-copy>p,.qm-clarity-panel p,.qm-final-panel p{color:rgba(38,38,38,.72);font-size:1.04rem;line-height:1.82}.qm-head-wide{max-width:820px;margin-bottom:42px}
.qm-context{background:#fff}.qm-context-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(340px,.88fr);gap:54px;align-items:center}.qm-context-copy>p{max-width:760px}.qm-context-points{display:grid;gap:10px;margin-top:28px}.qm-context-points article{display:grid;grid-template-columns:38px 52px 1fr;gap:13px;align-items:start;padding:15px 16px;border-bottom:1px solid rgba(12,73,49,.10)}.qm-context-points article:last-child{border-bottom:0}.qm-point-index,.qm-check-number,.qm-track-number{color:var(--target-sand);font:800 .72rem/1 Manrope,sans-serif;padding-top:8px}.qm-icon{display:grid;place-items:center;width:50px;height:50px;border:1px solid rgba(12,73,49,.12);border-radius:14px;background:var(--target-cream);color:var(--target-forest)}.qm-icon svg{width:27px;height:27px;stroke-width:1.8}.qm-context-points h3,.qm-checklist h3,.qm-checkpoint-track h3,.qm-channel-network h3{margin:2px 0 5px;color:var(--target-charcoal);font-size:1.08rem!important;font-weight:700}.qm-context-points p,.qm-checklist p,.qm-checkpoint-track p,.qm-channel-network p{margin:0;color:rgba(38,38,38,.68);font-size:.92rem;line-height:1.65}.qm-context-media{position:relative;margin:0;aspect-ratio:4/5}.qm-context-media img{display:block;width:100%;height:100%;object-fit:cover;border-radius:22px;box-shadow:0 18px 44px rgba(38,38,38,.09)}.qm-market-note{position:absolute;inset-inline:18px;inset-block-end:18px;display:flex;gap:10px;align-items:flex-start;padding:14px 15px;border-radius:14px;background:rgba(12,73,49,.94);color:var(--target-cream);font-size:.82rem;line-height:1.55}.qm-market-note svg{flex:0 0 auto;width:20px;height:20px;color:var(--target-sand)}
