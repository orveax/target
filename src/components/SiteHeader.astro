---
const { active = '' } = Astro.props;
const primaryNav = [
  ['index.html','home','الرئيسية','Home'],
  ['about.html','about','عن تارقت','About Target'],
  ['capabilities.html','capabilities','كيف نعمل','How We Work'],
  ['food-portfolio.html','portfolio','المنتجات والشركات','Products & Companies'],
  ['qatar-market.html','market','السوق القطري','Qatar Market'],
];
---
<header class="site-header premium-header">
  <nav class="navbar navbar-expand-xl" aria-label="Main navigation">
    <div class="container premium-header-grid">
      <a class="navbar-brand" href="index.html" aria-label="TARGET home"><img class="brand-logo" src="/assets/brand/target-logo-horizontal-light.svg" alt="TARGET — تارقت"></a>
      <div class="collapse navbar-collapse premium-desktop-nav">
        <ul class="navbar-nav mx-auto">
          {primaryNav.map(([href,key,ar,en]) => (<li><a class:list={['nav-link', active===key && 'active']} href={href} data-ar={ar} data-en={en}>{ar}</a></li>))}
        </ul>
      </div>
      <div class="nav-actions premium-nav-actions">
        <a class="nav-contact-utility d-none d-xl-inline-flex" href="contact.html"><i data-lucide="mail"></i><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span></a>
        <button class="lang-button" type="button" data-lang-toggle>EN</button>
        <a class="btn-premium btn-primary-premium premium-header-cta" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
        <button class="icon-button d-xl-none premium-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Menu"><i data-lucide="menu"></i></button>
      </div>
    </div>
  </nav>
</header>
<div class="offcanvas offcanvas-start premium-mobile-nav" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
  <span id="mobileNavLabel" class="visually-hidden" data-ar="قائمة تارقت" data-en="TARGET navigation">قائمة تارقت</span>
  <div class="offcanvas-header premium-mobile-head">
    <div class="premium-mobile-brand">
      <img class="mobile-brand-logo" src="/assets/brand/target-logo-horizontal-light.svg" alt="TARGET — تارقت">
    </div>
    <button type="button" class="premium-mobile-close" data-bs-dismiss="offcanvas" aria-label="إغلاق القائمة" data-ar-aria="إغلاق القائمة" data-en-aria="Close menu"><i data-lucide="x"></i></button>
  </div>
  <div class="offcanvas-body" data-mobile-nav-scroll>
    <p class="premium-mobile-intro" data-ar="روابط واضحة للوصول السريع إلى ما تحتاجه." data-en="A clear route to the information you need.">روابط واضحة للوصول السريع إلى ما تحتاجه.</p>
    <nav class="premium-mobile-links" aria-label="Mobile navigation">
      <a class:list={['nav-link', active==='home' && 'active']} href="index.html"><span><i data-lucide="house"></i><b data-ar="الرئيسية" data-en="Home">الرئيسية</b></span><i data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='about' && 'active']} href="about.html"><span><i data-lucide="building-2"></i><b data-ar="عن تارقت" data-en="About Target">عن تارقت</b></span><i data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='capabilities' && 'active']} href="capabilities.html"><span><i data-lucide="route"></i><b data-ar="كيف نعمل" data-en="How We Work">كيف نعمل</b></span><i data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='portfolio' && 'active']} href="food-portfolio.html"><span><i data-lucide="package"></i><b data-ar="المنتجات والشركات" data-en="Products & Companies">المنتجات والشركات</b></span><i data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='market' && 'active']} href="qatar-market.html"><span><i data-lucide="map-pinned"></i><b data-ar="السوق القطري" data-en="Qatar Market">السوق القطري</b></span><i data-lucide="arrow-up-left"></i></a>
    </nav>
    <div class="premium-mobile-cta">
      <a class="btn-premium btn-primary-premium w-100" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
    </div>
    <nav class="premium-mobile-secondary" aria-label="Secondary mobile navigation">
      <a href="company-profile.html"><span><i data-lucide="book-open-text"></i><b data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</b></span><i data-lucide="arrow-up-left"></i></a>
      <a href="contact.html"><span><i data-lucide="mail"></i><b data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</b></span><i data-lucide="arrow-up-left"></i></a>
      <a href="faq.html"><span><i data-lucide="circle-help"></i><b data-ar="الأسئلة الشائعة والدعم" data-en="FAQ & Support">الأسئلة الشائعة والدعم</b></span><i data-lucide="arrow-up-left"></i></a>
    </nav>
  </div>
  <div class="premium-mobile-scroll-cue" aria-hidden="true"></div>
</div>
