---
const { active = '' } = Astro.props;
const mainNav = [
  ['index.html','home','الرئيسية','Home'],
  ['about.html','about','عن تارقت','About TARGET'],
  ['capabilities.html','capabilities','كيف نعمل','How We Work'],
  ['products-companies.html','portfolio','المنتجات والشركات','Products & Companies'],
];
const megaActive = ['market','suppliers','contact','profile','faq','privacy','terms'].includes(active);
---
<header class="site-header target-header-v2">
  <nav class="navbar navbar-expand-xl th2-navbar" aria-label="Main navigation">
    <div class="container th2-shell">
      <a class="navbar-brand th2-brand" href="index.html" aria-label="TARGET home">
        <img class="brand-logo" src="/assets/brand/target-logo-horizontal-light.svg" alt="TARGET — تارقت لتجارة الأغذية">
      </a>

      <div class="th2-desktop-nav d-none d-xl-flex" aria-label="Desktop navigation">
        <div class="th2-nav-rail">
          {mainNav.map(([href,key,ar,en]) => (
            <a class:list={['th2-nav-link', active===key && 'active']} aria-current={active===key ? 'page' : undefined} href={href} data-ar={ar} data-en={en}>{ar}</a>
          ))}
          <div class:list={['th2-mega', megaActive && 'has-active']} data-th2-mega>
            <button class="th2-mega-toggle" type="button" data-th2-mega-toggle aria-expanded="false" aria-controls="th2MegaPanel">
              <span data-ar="استكشف" data-en="Explore">استكشف</span>
              <i data-lucide="chevron-down"></i>
            </button>
            <div class="th2-mega-panel" id="th2MegaPanel" data-th2-mega-panel>
              <section class="th2-mega-feature" aria-labelledby="th2MegaFeatureTitle">
                <small data-ar="من المنتج إلى السوق" data-en="From Product to Market">من المنتج إلى السوق</small>
                <h2 id="th2MegaFeatureTitle" data-ar="ابدأ من المسار المناسب" data-en="Start through the right route">ابدأ من المسار المناسب</h2>
                <p data-ar="مسارات واضحة للمصنعين والموردين والمهتمين بالسوق القطري." data-en="Clear routes for manufacturers, suppliers and Qatar-market enquiries.">مسارات واضحة للمصنعين والموردين والمهتمين بالسوق القطري.</p>
                <a href="suppliers.html">
                  <span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span>
                  <i data-lucide="arrow-up-left"></i>
                </a>
              </section>

              <div class="th2-mega-groups">
                <section>
                  <span class="th2-mega-kicker" data-ar="السوق والتوريد" data-en="Market & Supply">السوق والتوريد</span>
                  <a class:list={[active==='market' && 'active']} href="qatar-market.html" aria-current={active==='market' ? 'page' : undefined}>
                    <i data-lucide="map-pinned"></i>
                    <span><b data-ar="السوق القطري" data-en="Qatar Market">السوق القطري</b><small data-ar="فهم السوق ومسار الوصول" data-en="Market context and route-to-market">فهم السوق ومسار الوصول</small></span>
                  </a>
                  <a class:list={[active==='suppliers' && 'active']} href="suppliers.html" aria-current={active==='suppliers' ? 'page' : undefined}>
                    <i data-lucide="factory"></i>
                    <span><b data-ar="للمصنعين والموردين" data-en="For Suppliers">للمصنعين والموردين</b><small data-ar="شارك بيانات منتجك" data-en="Share your product information">شارك بيانات منتجك</small></span>
                  </a>
                </section>

                <section>
                  <span class="th2-mega-kicker" data-ar="الشركة والموارد" data-en="Company & Resources">الشركة والموارد</span>
                  <a class:list={[active==='profile' && 'active']} href="company-profile.html" aria-current={active==='profile' ? 'page' : undefined}>
                    <i data-lucide="book-open-text"></i>
                    <span><b data-ar="الملف التعريفي" data-en="Company Profile">الملف التعريفي</b><small data-ar="مرجع مختصر عن تارقت" data-en="A concise TARGET reference">مرجع مختصر عن تارقت</small></span>
                  </a>
                  <a class:list={[active==='faq' && 'active']} href="faq.html" aria-current={active==='faq' ? 'page' : undefined}>
                    <i data-lucide="circle-help"></i>
                    <span><b data-ar="الأسئلة الشائعة" data-en="FAQ">الأسئلة الشائعة</b><small data-ar="إجابات سريعة وواضحة" data-en="Quick, clear answers">إجابات سريعة وواضحة</small></span>
                  </a>
                </section>

                <section>
                  <span class="th2-mega-kicker" data-ar="التواصل" data-en="Contact">التواصل</span>
                  <a class:list={[active==='contact' && 'active']} href="contact.html" aria-current={active==='contact' ? 'page' : undefined}>
                    <i data-lucide="mail"></i>
                    <span><b data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</b><small data-ar="اختر القسم المناسب" data-en="Reach the right team">اختر القسم المناسب</small></span>
                  </a>
                  <div class="th2-mega-direct">
                    <a href="mailto:sales@targetft.com">sales@targetft.com</a>
                    <a href="mailto:partners@targetft.com">partners@targetft.com</a>
                  </div>
                </section>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="th2-actions">
        <button class="lang-button th2-lang" type="button" data-lang-toggle aria-label="Switch language">EN</button>
        <a class="btn-premium btn-primary-premium th2-cta d-none d-xl-inline-flex" href="suppliers.html">
          <span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span>
          <i data-lucide="arrow-up-left"></i>
        </a>
        <button class="icon-button d-xl-none th2-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Menu">
          <i data-lucide="menu"></i>
        </button>
      </div>
    </div>
  </nav>
</header>

<div class="offcanvas offcanvas-start premium-mobile-nav th2-mobile-nav" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
  <span id="mobileNavLabel" class="visually-hidden" data-ar="قائمة تارقت" data-en="TARGET navigation">قائمة تارقت</span>
  <div class="offcanvas-header th2-mobile-head">
    <a class="th2-mobile-brand" href="index.html" aria-label="TARGET home">
      <img class="mobile-brand-logo" src="/assets/brand/target-logo-horizontal-light.svg" alt="TARGET — تارقت لتجارة الأغذية">
    </a>
    <button type="button" class="th2-mobile-close" data-bs-dismiss="offcanvas" aria-label="إغلاق القائمة" data-ar-aria="إغلاق القائمة" data-en-aria="Close menu"><i data-lucide="x"></i></button>
  </div>

  <div class="offcanvas-body th2-mobile-body" data-mobile-nav-scroll>
    <div class="th2-mobile-intro">
      <small data-ar="TARGET NAVIGATION" data-en="TARGET NAVIGATION">TARGET NAVIGATION</small>
      <p data-ar="انتقل مباشرة إلى المسار الذي تحتاجه." data-en="Go directly to the route you need.">انتقل مباشرة إلى المسار الذي تحتاجه.</p>
    </div>

    <nav class="th2-mobile-primary" aria-label="Mobile navigation">
      <a class:list={['nav-link', active==='home' && 'active']} aria-current={active==='home' ? 'page' : undefined} href="index.html"><small>01</small><span class="th2-mobile-route-icon"><i data-lucide="house"></i></span><b data-ar="الرئيسية" data-en="Home">الرئيسية</b><i class="th2-mobile-route-arrow" data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='about' && 'active']} aria-current={active==='about' ? 'page' : undefined} href="about.html"><small>02</small><span class="th2-mobile-route-icon"><i data-lucide="building-2"></i></span><b data-ar="عن تارقت" data-en="About TARGET">عن تارقت</b><i class="th2-mobile-route-arrow" data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='capabilities' && 'active']} aria-current={active==='capabilities' ? 'page' : undefined} href="capabilities.html"><small>03</small><span class="th2-mobile-route-icon"><i data-lucide="route"></i></span><b data-ar="كيف نعمل" data-en="How We Work">كيف نعمل</b><i class="th2-mobile-route-arrow" data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='portfolio' && 'active']} aria-current={active==='portfolio' ? 'page' : undefined} href="products-companies.html"><small>04</small><span class="th2-mobile-route-icon"><i data-lucide="package"></i></span><b data-ar="المنتجات والشركات" data-en="Products & Companies">المنتجات والشركات</b><i class="th2-mobile-route-arrow" data-lucide="arrow-up-left"></i></a>
      <a class:list={['nav-link', active==='market' && 'active']} aria-current={active==='market' ? 'page' : undefined} href="qatar-market.html"><small>05</small><span class="th2-mobile-route-icon"><i data-lucide="map-pinned"></i></span><b data-ar="السوق القطري" data-en="Qatar Market">السوق القطري</b><i class="th2-mobile-route-arrow" data-lucide="arrow-up-left"></i></a>
    </nav>

    <section class="th2-mobile-commercial" aria-labelledby="th2MobileCommercialTitle">
      <div>
        <small data-ar="للمصنعين والموردين" data-en="For Manufacturers & Suppliers">للمصنعين والموردين</small>
        <h2 id="th2MobileCommercialTitle" data-ar="لديك منتج غذائي؟" data-en="Have a food product?">لديك منتج غذائي؟</h2>
        <p data-ar="ابدأ النقاش التجاري من المسار المخصص للمنتجات." data-en="Start the commercial discussion through the dedicated product route.">ابدأ النقاش التجاري من المسار المخصص للمنتجات.</p>
      </div>
      <a href="suppliers.html"><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span><i data-lucide="arrow-up-left"></i></a>
    </section>

    <div class="th2-mobile-utility-head"><span data-ar="المزيد" data-en="More">المزيد</span></div>
    <nav class="th2-mobile-secondary" aria-label="Secondary mobile navigation">
      <a class="th2-mobile-profile-resource" href="company-profile.html"><span><i data-lucide="file-down"></i><b data-ar="ملف الشركة" data-en="Company Profile">ملف الشركة</b><small data-ar="صفحة التحميل" data-en="Download page">صفحة التحميل</small></span><i data-lucide="arrow-up-left"></i></a>
      <a href="contact.html"><span><i data-lucide="mail"></i><b data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</b></span><i data-lucide="arrow-up-left"></i></a>
      <a href="faq.html"><span><i data-lucide="circle-help"></i><b data-ar="الأسئلة الشائعة" data-en="FAQ">الأسئلة الشائعة</b></span><i data-lucide="arrow-up-left"></i></a>
    </nav>

    <section class="th2-mobile-social" aria-label="TARGET social media" data-ar-aria="حسابات تارقت على وسائل التواصل" data-en-aria="TARGET social media">
      <div class="th2-mobile-social-copy">
        <small data-ar="تابع تارقت" data-en="Follow TARGET">تابع تارقت</small>
        <strong>@targetft</strong>
      </div>
      <div class="th2-mobile-social-links">
        <a href="https://www.instagram.com/targetft/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram" aria-hidden="true"></i></a>
        <a href="https://www.facebook.com/targetft" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
        <a href="https://www.tiktok.com/@targetft" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><i class="bi bi-tiktok" aria-hidden="true"></i></a>
      </div>
    </section>
  </div>
  <div class="premium-mobile-scroll-cue" aria-hidden="true"></div>
</div>
