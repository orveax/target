---
const trust = [
  ['building-2','شركة تعمل من قطر','حضور محلي لفهم ومناقشة فرص السوق.','Qatar-Based','Local market context for commercial discussions.'],
  ['ship','تجارة واستيراد أغذية','منتجات وفئات غذائية مختارة.','Food Trading & Import','Selected food products and categories.'],
  ['factory','مصنعون وموردون وعلامات','نقاش مباشر حول المنتج والفرصة.','Manufacturers, Suppliers & Brands','Direct discussion around the product and opportunity.'],
  ['file-check-2','مراجعة المنتج قبل الالتزام','مناقشة المنتج لا تعني قبولًا تلقائيًا.','Product Fit Before Commitment','A discussion does not mean automatic acceptance.'],
];
const work = [
  ['ship','الاستيراد والتجارة','نتعامل مع المنتجات الغذائية المختارة وندرس فرصة إدخالها إلى قطر ضمن نشاط التجارة والاستيراد.','منتج مناسب · فرصة في قطر · استيراد وتجارة','Import & Trading','We work with selected food products and assess opportunities to bring them into Qatar through our trading and import activity.','Suitable Product · Qatar Opportunity · Import & Trading'],
  ['handshake','العمل مع المصنعين والموردين','نناقش المنتج والفرصة مباشرة مع المصنع أو العلامة أو المورد، ونحدد طريقة العمل المناسبة إذا كانت الفرصة ملائمة.','مصنعون · موردون · علامات غذائية','Working with Manufacturers & Suppliers','We discuss the product and opportunity directly with the manufacturer, brand or supplier and define an appropriate commercial arrangement where there is a fit.','Manufacturers · Suppliers · Food Brands'],
  ['network','قنوات البيع والتوزيع','نعمل على الوصول بالمنتج إلى قنوات البيع والتوزيع المناسبة داخل قطر بحسب طبيعة الفئة والفرصة.','قنوات بيع · توزيع · السوق القطري','Sales & Distribution Channels','We work on connecting the product with suitable sales and distribution channels in Qatar based on the category and opportunity.','Sales Channels · Distribution · Qatar Market'],
  ['route','متابعة فرصة المنتج','بعد دخول المنتج، نراجع إمكانية استمرار الفرصة وتوسيع الوصول عندما يكون ذلك مناسبًا للمنتج والسوق.','استمرار المنتج · توسيع الوصول · مراجعة الفرصة','Product Opportunity Development','After market entry, we review the potential to continue developing the opportunity and expand reach where it makes sense for the product and market.','Product Continuity · Wider Reach · Opportunity Review'],
];
const categories = [
  ['cup-soda','الشاي والمشروبات العشبية','Tea & Herbal Infusions'],
  ['glass-water','العصائر والمشروبات التقليدية','Juices & Traditional Beverages'],
  ['honey','العسل والدبس والحلويات التقليدية','Honey, Molasses & Traditional Sweets'],
  ['snowflake','الألبان والمجمدات والأغذية المجهزة','Dairy, Frozen & Prepared Foods'],
  ['package-check','الأغذية المعبأة ومنتجات FMCG المختارة','Packaged & Selected Food FMCG'],
];
const why = [
  ['map-pinned','تركيز واضح على قطر','نراجع المنتج والفرصة في سياق السوق القطري بدل تقديم وعود عامة عن أسواق متعددة.','Clear Qatar Focus','We review the product and opportunity in the context of Qatar rather than making broad multi-market promises.'],
  ['package-check','ملاءمة المنتج أولًا','لا نتعامل مع كل منتج تلقائيًا؛ نراجع الفئة والمنتج والفرصة قبل تحديد الخطوات التالية.','Product Fit First','Not every product moves forward automatically; we review the category, product and opportunity first.'],
  ['messages-square','نقاش تجاري مباشر','التواصل يدور حول المصنع أو المورد، المنتج، وما الذي يبحث عنه في قطر — دون طبقات استشارية غير ضرورية.','Direct Commercial Discussion','The discussion focuses on the manufacturer or supplier, the product and what they are seeking in Qatar — without unnecessary consulting layers.'],
  ['file-check-2','اتفاق واضح قبل التنفيذ','لا يبدأ التزام تجاري إلا بعد الاتفاق على طريقة العمل المناسبة ونطاق الخطوات التالية.','Clear Agreement Before Execution','Commercial commitment starts only after an appropriate way of working and next-step scope are agreed.'],
];
const steps = [
  ['شاركنا المنتج','أرسل اسم الشركة أو المصنع، المنتج والفئة الأساسية.','Share the Product','Share the company or manufacturer name, product and main category.'],
  ['نراجع الملاءمة','نراجع المنتج والفئة ومدى ارتباط الفرصة بتوجه تارقت والسوق القطري.','We Review the Fit','We review the product, category and whether the opportunity fits TARGET’s direction and the Qatar market.'],
  ['نتفق على طريقة العمل','إذا كانت الفرصة مناسبة، نحدد طريقة التعامل والخطوات التجارية التالية.','Agree How to Work','If there is a fit, we define the commercial arrangement and next steps.'],
  ['نبدأ الخطوات التالية','تبدأ الخطوات المرتبطة بالاستيراد أو دخول السوق أو قنوات البيع بحسب الفرصة المتفق عليها.','Move to the Next Steps','The relevant import, market-entry or sales-channel steps begin according to the agreed opportunity.'],
];
const faqs = [
  ['هل تتعامل تارقت مع جميع المنتجات الغذائية؟','لا. نعمل على فئات ومنتجات غذائية مختارة، ونراجع كل منتج وفرصة بشكل منفصل قبل تحديد ما إذا كان مناسبًا للمناقشة التالية.','Does TARGET work with every food product?','No. We focus on selected food categories and review each product and opportunity individually before deciding whether it fits the next stage of discussion.'],
  ['هل إرسال المنتج يعني قبوله أو الالتزام باستيراده؟','لا. إرسال المنتج أو بدء المناقشة لا يعني قبولًا تلقائيًا أو التزامًا بالاستيراد أو التوزيع. أي التزام يبدأ بعد اتفاق واضح بين الطرفين.','Does submitting a product mean it is accepted or will be imported?','No. Submitting a product or starting a discussion does not mean automatic acceptance or a commitment to import or distribute it. Any commitment begins after clear agreement between both sides.'],
  ['ما المعلومات المطلوبة لبدء مناقشة المنتج؟','نحتاج في البداية اسم الشركة أو المصنع، الدولة، المنتج أو الفئة، بيانات التواصل، وملخصًا قصيرًا لما تبحث عنه في السوق القطري.','What information is needed to start a product discussion?','Start with the company or manufacturer name, country, product or category, contact details and a short summary of what you are seeking in Qatar.'],
];
---
<div class="home-canonical">
  <section class="hc-hero">
    <div class="container hc-hero-grid">
      <div class="hc-hero-copy">
        <span class="hc-eyebrow"><i data-lucide="ship"></i><span data-ar="تجارة واستيراد الأغذية في قطر" data-en="Food Trading & Import in Qatar">تجارة واستيراد الأغذية في قطر</span></span>
        <h1 data-ar="من المصنع إلى السوق القطري." data-en="From Manufacturer to the Qatar Market.">من المصنع إلى السوق القطري.</h1>
        <p data-ar="نعمل مع المصنعين والعلامات والموردين على المنتجات المناسبة للسوق القطري — من مراجعة المنتج والفرصة، إلى الاستيراد، ثم الوصول إلى قنوات البيع والتوزيع المناسبة." data-en="We work with manufacturers, brands and suppliers on products suited to Qatar — from reviewing the product and opportunity, through import and trading, to suitable sales and distribution channels.">نعمل مع المصنعين والعلامات والموردين على المنتجات المناسبة للسوق القطري — من مراجعة المنتج والفرصة، إلى الاستيراد، ثم الوصول إلى قنوات البيع والتوزيع المناسبة.</p>
        <div class="hc-actions">
          <a class="btn-premium btn-primary-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a>
          <a class="hc-button-secondary" href="capabilities.html"><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span><i data-lucide="arrow-up-left"></i></a>
        </div>
      </div>
      <div class="hc-hero-visual">
        <div class="hc-hero-media" aria-hidden="true">
          <span class="hc-hero-orbit hc-hero-orbit--one"></span>
          <span class="hc-hero-orbit hc-hero-orbit--two"></span>
          <span class="hc-hero-gridline hc-hero-gridline--one"></span>
          <span class="hc-hero-gridline hc-hero-gridline--two"></span>
          <span class="hc-hero-market-mark">QATAR</span>
        </div>
        <aside class="hc-route" aria-label="المسار التجاري" data-ar-aria="المسار التجاري" data-en-aria="Commercial route">
        <span class="hc-route-label" data-ar="مسار تجاري واضح" data-en="A Clear Commercial Route">مسار تجاري واضح</span>
        <div class="hc-route-nodes">
          <article><span class="hc-route-icon"><i data-lucide="factory"></i></span><div><strong data-ar="المصنع / العلامة / المورد" data-en="Manufacturer / Brand / Supplier">المصنع / العلامة / المورد</strong><small data-ar="المنتج والفرصة" data-en="Product & Opportunity">المنتج والفرصة</small></div></article>
          <i class="hc-route-link" data-lucide="arrow-left"></i>
          <article class="is-target"><span class="hc-route-icon"><i data-lucide="target"></i></span><div><strong>TARGET</strong><small data-ar="نراجع الملاءمة وطريقة العمل" data-en="Review Fit & Commercial Arrangement">نراجع الملاءمة وطريقة العمل</small></div></article>
          <i class="hc-route-link" data-lucide="arrow-left"></i>
          <article><span class="hc-route-icon"><i data-lucide="map-pinned"></i></span><div><strong data-ar="السوق القطري" data-en="Qatar Market">السوق القطري</strong><small data-ar="الاستيراد · البيع · التوزيع" data-en="Import · Sales · Distribution">الاستيراد · البيع · التوزيع</small></div></article>
        </div>
      </aside>
      </div>
    </div>
  </section>

  <section class="hc-trust"><div class="container"><div class="hc-trust-grid">{trust.map(([icon,ar,arCopy,en,enCopy]) => <article><i data-lucide={icon}></i><div><strong data-ar={ar} data-en={en}>{ar}</strong><small data-ar={arCopy} data-en={enCopy}>{arCopy}</small></div></article>)}</div></div></section>

  <section class="hc-section hc-work"><div class="container">
    <header class="hc-heading"><span class="hc-kicker" data-ar="كيف نعمل" data-en="How We Work">كيف نعمل</span><h2 data-ar="من المنتج إلى قنوات البيع في قطر" data-en="From Product to Sales Channels in Qatar">من المنتج إلى قنوات البيع في قطر</h2><p data-ar="نعمل مع المصنعين والعلامات والموردين على المنتجات المناسبة للسوق القطري — من مراجعة المنتج والفرصة، إلى الاستيراد، ثم الوصول إلى قنوات البيع والتوزيع المناسبة." data-en="We work with manufacturers, brands and suppliers on products suited to Qatar — from reviewing the product and opportunity, through import and trading, to suitable sales and distribution channels.">نعمل مع المصنعين والعلامات والموردين على المنتجات المناسبة للسوق القطري — من مراجعة المنتج والفرصة، إلى الاستيراد، ثم الوصول إلى قنوات البيع والتوزيع المناسبة.</p></header>
    <div class="hc-work-grid">{work.map(([icon,ar,arCopy,arPoints,en,enCopy,enPoints],index) => <article class="hc-feature-card"><span class="hc-card-number">0{index + 1}</span><span class="hc-icon-tile"><i data-lucide={icon}></i></span><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arCopy} data-en={enCopy}>{arCopy}</p><small data-ar={arPoints} data-en={enPoints}>{arPoints}</small></article>)}</div>
    <a class="hc-explore-link" href="capabilities.html"><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span><i data-lucide="arrow-up-left"></i></a>
  </div></section>

  <section class="hc-section hc-categories"><div class="container">
    <header class="hc-heading"><span class="hc-kicker" data-ar="نطاق اهتمامنا" data-en="Our Focus">نطاق اهتمامنا</span><h2 data-ar="فئات ومنتجات نركز عليها" data-en="Products & Categories We Focus On">فئات ومنتجات نركز عليها</h2><p data-ar="نعمل ضمن فئات غذائية مختارة، مع مرونة لتقييم المنتجات التي تتناسب مع توجه تارقت وفرص السوق القطري." data-en="We focus on selected food categories while remaining open to evaluating products that fit TARGET's commercial direction and Qatar-market opportunities.">نعمل ضمن فئات غذائية مختارة، مع مرونة لتقييم المنتجات التي تتناسب مع توجه تارقت وفرص السوق القطري.</p></header>
    <div class="hc-category-grid">{categories.map(([icon,ar,en]) => <a href="food-portfolio.html"><span class="hc-category-media"><span class="hc-icon-tile"><i data-lucide={icon}></i></span></span><strong data-ar={ar} data-en={en}>{ar}</strong><i class="hc-category-arrow" data-lucide="arrow-up-left"></i></a>)}</div>
    <a class="hc-explore-link" href="food-portfolio.html"><span data-ar="استعرض المنتجات والشركات" data-en="Explore Products & Companies">استعرض المنتجات والشركات</span><i data-lucide="arrow-up-left"></i></a>
  </div></section>

  <section class="hc-section hc-why"><div class="container"><div class="hc-why-layout">
    <header class="hc-heading"><span class="hc-kicker" data-ar="لماذا تارقت؟" data-en="Why TARGET?">لماذا تارقت؟</span><h2 data-ar="طريقة عمل واضحة حول المنتج والفرصة" data-en="A Clear Way to Discuss the Product and Opportunity">طريقة عمل واضحة حول المنتج والفرصة</h2><p data-ar="نفضّل أن يعرف المصنع أو المورد منذ البداية ما الذي نراجعه، وما الذي تعنيه المناقشة، ومتى يبدأ الالتزام التجاري." data-en="We want manufacturers and suppliers to understand from the start what is reviewed, what a discussion means, and when a commercial commitment begins.">نفضّل أن يعرف المصنع أو المورد منذ البداية ما الذي نراجعه، وما الذي تعنيه المناقشة، ومتى يبدأ الالتزام التجاري.</p></header>
    <div class="hc-why-grid">{why.map(([icon,ar,arCopy,en,enCopy]) => <article><span class="hc-icon-tile"><i data-lucide={icon}></i></span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arCopy} data-en={enCopy}>{arCopy}</p></div></article>)}</div>
  </div></div></section>

  <section class="hc-section hc-start"><div class="container"><header class="hc-heading"><span class="hc-kicker" data-ar="كيف نبدأ؟" data-en="How to Start">كيف نبدأ؟</span><h2 data-ar="أربع خطوات لبدء مناقشة المنتج" data-en="Four Steps to Start a Product Discussion">أربع خطوات لبدء مناقشة المنتج</h2><p data-ar="البداية لا تحتاج ملفًا معقدًا. نحتاج معلومات واضحة تساعدنا على فهم الشركة والمنتج والفرصة في قطر." data-en="The first step does not require a complicated submission. We need clear information that helps us understand the company, product and Qatar opportunity.">البداية لا تحتاج ملفًا معقدًا. نحتاج معلومات واضحة تساعدنا على فهم الشركة والمنتج والفرصة في قطر.</p></header>
    <ol class="hc-steps">{steps.map(([ar,arCopy,en,enCopy],index) => <li><span>0{index + 1}</span><div><h3 data-ar={ar} data-en={en}>{ar}</h3><p data-ar={arCopy} data-en={enCopy}>{arCopy}</p></div></li>)}</ol>
    <a class="hc-explore-link" href="capabilities.html"><span data-ar="تعرف على طريقة عملنا بالكامل" data-en="See the Full Process">تعرف على طريقة عملنا بالكامل</span><i data-lucide="arrow-up-left"></i></a>
  </div></section>

  <section class="hc-section hc-faq"><div class="container"><header class="hc-heading"><span class="hc-kicker" data-ar="أسئلة قبل أن تبدأ" data-en="Before You Start">أسئلة قبل أن تبدأ</span><h2 data-ar="أسئلة شائعة من المصنعين والموردين" data-en="Common Questions from Manufacturers & Suppliers">أسئلة شائعة من المصنعين والموردين</h2></header>
    <div class="hc-faq-list">{faqs.map(([ar,arAnswer,en,enAnswer],index) => <article class:list={['hc-faq-item',index === 0 && 'is-open']}><button type="button" aria-expanded={index === 0 ? 'true' : 'false'} data-home-faq><span data-ar={ar} data-en={en}>{ar}</span><i data-lucide="plus"></i></button><div class="hc-faq-panel" hidden={index !== 0}><p data-ar={arAnswer} data-en={enAnswer}>{arAnswer}</p></div></article>)}</div>
    <a class="hc-explore-link" href="faq.html"><span data-ar="عرض جميع الأسئلة الشائعة" data-en="View All FAQs">عرض جميع الأسئلة الشائعة</span><i data-lucide="arrow-up-left"></i></a>
  </div></section>

  <section class="hc-final"><div class="container"><div class="hc-final-panel"><div><span class="hc-kicker" data-ar="لديك منتج مناسب؟" data-en="Have a Relevant Product?">لديك منتج مناسب؟</span><h2 data-ar="لديك منتج غذائي وتريد مناقشة فرصته في قطر؟" data-en="Have a Food Product You Want to Discuss for Qatar?">لديك منتج غذائي وتريد مناقشة فرصته في قطر؟</h2><p data-ar="شاركنا نبذة عن شركتك أو المصنع والمنتج، وسنراجع ما إذا كانت الفرصة مناسبة لبدء نقاش مباشر." data-en="Share a brief introduction to your company or manufacturing business and the product, and we will review whether the opportunity is suitable for a direct discussion.">شاركنا نبذة عن شركتك أو المصنع والمنتج، وسنراجع ما إذا كانت الفرصة مناسبة لبدء نقاش مباشر.</p><small data-ar="إرسال الطلب لا يعني قبول المنتج أو إنشاء التزام تجاري." data-en="Submitting an enquiry does not constitute product acceptance or create a commercial commitment.">إرسال الطلب لا يعني قبول المنتج أو إنشاء التزام تجاري.</small></div><div class="hc-final-actions"><a class="btn-premium btn-primary-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a><a class="hc-final-secondary" href="contact.html"><span data-ar="الاتصال بنا" data-en="Contact Us">الاتصال بنا</span><i data-lucide="arrow-up-left"></i></a></div></div></div></section>
</div>
