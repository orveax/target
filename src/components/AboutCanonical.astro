---
const facts = [
  ['map-pin', 'شركة تعمل من قطر', 'Qatar-Based'],
  ['ship-wheel', 'تجارة واستيراد أغذية', 'Food Trading & Import'],
  ['users-round', 'مصنعون وموردون وعلامات', 'Manufacturers, Suppliers & Brands'],
  ['route', 'تركيز على السوق القطري', 'Qatar Market Focus'],
];
const values = [
  {
    icon: 'compass', labelAr: 'رؤيتنا', labelEn: 'Our Vision',
    titleAr: 'شريك تجاري موثوق للمنتجات المناسبة للسوق القطري.',
    titleEn: 'A trusted commercial partner for products suited to the Qatar market.',
    bodyAr: 'أن تبني تارقت علاقات تجارية موثوقة ومستدامة مع المصنعين والعلامات والموردين حول المنتجات التي تتناسب مع السوق القطري وفرصه.',
    bodyEn: 'To build trusted, sustainable commercial relationships with manufacturers, brands and suppliers around products suited to Qatar and its market opportunities.'
  },
  {
    icon: 'file-check-2', labelAr: 'رسالتنا', labelEn: 'Our Mission',
    titleAr: 'نراجع المنتج، نحدد الملاءمة، ثم نتحرك باتفاق واضح.',
    titleEn: 'Review the product, assess the fit, then move forward on clear terms.',
    bodyAr: 'مناقشة منتجات غذائية مختارة، تقييم فرصتها في قطر، والعمل مع الطرف المناسب على الاستيراد والتجارة والوصول إلى قنوات البيع والتوزيع عندما تكون الفرصة ملائمة.',
    bodyEn: 'To discuss selected food products, assess their opportunity in Qatar, and work with the relevant party on import, trading and access to suitable sales and distribution channels where there is a fit.'
  },
];
const trust = [
  ['file-search', 'معلومات واضحة', 'Clear Information', 'نراجع بيانات الشركة والمنتج والفئة والفرصة قبل اتخاذ أي خطوة.', 'We review the company, product, category and opportunity information before taking the next step.'],
  ['handshake', 'لا التزام تلقائي', 'No Automatic Commitment', 'إرسال منتج أو بدء مناقشة لا يعني تلقائيًا استيرادًا أو توزيعًا أو قبولًا للفرصة.', 'Sending a product or starting a discussion does not automatically mean import, distribution or acceptance of the opportunity.'],
  ['clipboard-check', 'نتفق قبل التنفيذ', 'Agree Before Execution', 'الأسعار والكميات ونطاق العمل وأي التزامات تجارية تُحدد في الاتفاق المناسب قبل التنفيذ.', 'Pricing, quantities, scope and other commercial commitments are defined in the appropriate agreement before execution.'],
  ['badge-check', 'لا وكالة أو حصرية دون توثيق', 'No Agency or Exclusivity Without Documentation', 'لا تُفهم أي مناقشة على أنها وكالة أو حصرية أو تمثيل رسمي ما لم يتم الاتفاق عليها وتوثيقها صراحة.', 'No discussion should be understood as agency, exclusivity or official representation unless it is expressly agreed and documented.'],
];
---

<div class="about-canonical">
  <section class="about-hero">
    <div class="container about-hero__grid">
      <div class="about-hero__copy">
        <span class="about-eyebrow"><i data-lucide="building-2"></i><span data-ar="عن تارقت" data-en="About TARGET">عن تارقت</span></span>
        <h1 data-ar="شركة قطرية لتجارة واستيراد الأغذية تربط المنتجات المناسبة بفرص السوق القطري." data-en="A Qatar-based food trading and import company connecting suitable products with opportunities in the Qatar market.">شركة قطرية لتجارة واستيراد الأغذية تربط المنتجات المناسبة بفرص السوق القطري.</h1>
        <p data-ar="تعمل تارقت مع المصنعين والعلامات الغذائية والموردين لمناقشة المنتجات والفرص المناسبة، وتقييم ملاءمتها للسوق القطري، ثم تحديد طريقة العمل المناسبة عندما تكون الفرصة ملائمة للطرفين." data-en="TARGET works with food manufacturers, brands and suppliers to discuss suitable products and opportunities, assess their fit for Qatar, and define an appropriate commercial arrangement where the opportunity fits both sides.">تعمل تارقت مع المصنعين والعلامات الغذائية والموردين لمناقشة المنتجات والفرص المناسبة، وتقييم ملاءمتها للسوق القطري، ثم تحديد طريقة العمل المناسبة عندما تكون الفرصة ملائمة للطرفين.</p>
        <a class="about-resource-link" href="company-profile.html"><i data-lucide="file-text"></i><span data-ar="عرض الملف التعريفي" data-en="View Company Profile">عرض الملف التعريفي</span><i class="about-arrow" data-lucide="arrow-left"></i></a>
      </div>
      <div class="about-hero__cue" aria-hidden="true"><i data-lucide="route"></i><span>01</span><b>TARGET</b></div>
    </div>
  </section>

  <section class="about-section about-who">
    <div class="container about-two-col">
      <div class="about-section-head">
        <span class="about-kicker" data-ar="من نحن" data-en="Who We Are">من نحن</span>
        <h2 data-ar="تجارة أغذية مرتبطة بالمنتج والفرصة والسوق." data-en="Food trading built around the product, the opportunity and the market.">تجارة أغذية مرتبطة بالمنتج والفرصة والسوق.</h2>
        <p data-ar="تارقت شركة تعمل من قطر في تجارة واستيراد الأغذية. نركز على منتجات وفئات مختارة، ونتعامل مباشرة مع المصنعين والعلامات والموردين لمناقشة فرص دخول المنتجات المناسبة إلى السوق القطري والوصول إلى قنوات البيع والتوزيع الملائمة." data-en="TARGET is a Qatar-based food trading and import company focused on selected products and categories. We work directly with manufacturers, brands and suppliers to discuss opportunities for suitable products to enter Qatar and reach appropriate sales and distribution channels.">تارقت شركة تعمل من قطر في تجارة واستيراد الأغذية. نركز على منتجات وفئات مختارة، ونتعامل مباشرة مع المصنعين والعلامات والموردين لمناقشة فرص دخول المنتجات المناسبة إلى السوق القطري والوصول إلى قنوات البيع والتوزيع الملائمة.</p>
        <p data-ar="دورنا تجاري ومرتبط بالمنتج والفرصة الفعلية في السوق؛ لسنا منصة استشارات عامة، ولا يعني بدء النقاش قبول المنتج أو الالتزام باستيراده أو توزيعه." data-en="Our role is commercial and tied to the product and the actual market opportunity. We are not presenting a general consulting service, and starting a discussion does not mean automatic product acceptance, import or distribution commitment.">دورنا تجاري ومرتبط بالمنتج والفرصة الفعلية في السوق؛ لسنا منصة استشارات عامة، ولا يعني بدء النقاش قبول المنتج أو الالتزام باستيراده أو توزيعه.</p>
      </div>
      <ul class="about-facts" aria-label="TARGET facts">
        {facts.map(([icon, ar, en]) => <li><span class="about-icon"><i data-lucide={icon}></i></span><span data-ar={ar} data-en={en}>{ar}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="about-section about-soft">
    <div class="container">
      <div class="about-section-head about-section-head--center">
        <span class="about-kicker" data-ar="رؤيتنا ورسالتنا" data-en="Vision & Mission">رؤيتنا ورسالتنا</span>
        <h2 data-ar="وضوح تجاري يبدأ من المنتج وينتهي بخطوة مناسبة." data-en="Commercial clarity from the product to the appropriate next step.">وضوح تجاري يبدأ من المنتج وينتهي بخطوة مناسبة.</h2>
      </div>
      <div class="about-values">
        {values.map((value) => <article class="about-value-card"><span class="about-icon about-icon--large"><i data-lucide={value.icon}></i></span><span class="about-card-label" data-ar={value.labelAr} data-en={value.labelEn}>{value.labelAr}</span><h3 data-ar={value.titleAr} data-en={value.titleEn}>{value.titleAr}</h3><p data-ar={value.bodyAr} data-en={value.bodyEn}>{value.bodyAr}</p></article>)}
      </div>
    </div>
  </section>

  <section class="about-section about-role">
    <div class="container">
      <div class="about-section-head">
        <span class="about-kicker" data-ar="دورنا التجاري" data-en="Our Commercial Role">دورنا التجاري</span>
        <h2 data-ar="حلقة تجارية محلية بين المنتج والسوق القطري." data-en="A local commercial bridge between the product and the Qatar market.">حلقة تجارية محلية بين المنتج والسوق القطري.</h2>
        <p data-ar="نربط النقاش حول المنتج بواقع السوق: نفهم الشركة والمنتج والفرصة، نراجع الملاءمة، ثم نحدد طريقة العمل والخطوات التجارية المناسبة دون افتراض أن كل منتج مناسب أو أن كل مناقشة ستتحول إلى اتفاق." data-en="We connect the product discussion with market reality: understand the company, product and opportunity, review the fit, then define the appropriate commercial arrangement and next steps without assuming every product is suitable or every discussion becomes an agreement.">نربط النقاش حول المنتج بواقع السوق: نفهم الشركة والمنتج والفرصة، نراجع الملاءمة، ثم نحدد طريقة العمل والخطوات التجارية المناسبة دون افتراض أن كل منتج مناسب أو أن كل مناقشة ستتحول إلى اتفاق.</p>
      </div>
      <div class="about-flow">
        <article class="about-flow-node"><span class="about-icon"><i data-lucide="factory"></i></span><h3 data-ar="المصنع / العلامة / المورد" data-en="Manufacturer / Brand / Supplier">المصنع / العلامة / المورد</h3><p data-ar="شركة · منتج · فئة · فرصة" data-en="Company · Product · Category · Opportunity">شركة · منتج · فئة · فرصة</p></article>
        <span class="about-flow-link" aria-hidden="true"><i data-lucide="arrow-left"></i></span>
        <article class="about-flow-node about-flow-node--target"><span class="about-icon"><i data-lucide="crosshair"></i></span><h3>TARGET</h3><p data-ar="مراجعة الملاءمة · طريقة العمل · الخطوة التالية" data-en="Fit Review · Commercial Arrangement · Next Step">مراجعة الملاءمة · طريقة العمل · الخطوة التالية</p></article>
        <span class="about-flow-link" aria-hidden="true"><i data-lucide="arrow-left"></i></span>
        <article class="about-flow-node"><span class="about-icon"><i data-lucide="map-pinned"></i></span><h3 data-ar="السوق القطري" data-en="Qatar Market">السوق القطري</h3><p data-ar="استيراد · تجارة · قنوات بيع وتوزيع حسب الفرصة" data-en="Import · Trading · Sales & Distribution Channels as Applicable">استيراد · تجارة · قنوات بيع وتوزيع حسب الفرصة</p></article>
      </div>
    </div>
  </section>

  <section class="about-section about-soft about-trust">
    <div class="container">
      <div class="about-section-head">
        <span class="about-kicker" data-ar="وضوح التعامل" data-en="Commercial Clarity">وضوح التعامل</span>
        <h2 data-ar="تعامل واضح يحمي الطرفين" data-en="Clear Terms for Both Sides">تعامل واضح يحمي الطرفين</h2>
        <p data-ar="نبدأ كل نقاش بمعلومات واضحة عن الشركة والمنتج والفرصة، ولا يبدأ أي التزام تجاري إلا بعد اتفاق واضح ومناسب للطرفين." data-en="Every discussion starts with clear information about the company, product and opportunity. Commercial commitments begin only after clear terms are agreed by both sides.">نبدأ كل نقاش بمعلومات واضحة عن الشركة والمنتج والفرصة، ولا يبدأ أي التزام تجاري إلا بعد اتفاق واضح ومناسب للطرفين.</p>
      </div>
      <div class="about-trust-grid">
        {trust.map(([icon, arTitle, enTitle, arBody, enBody], index) => <article class="about-trust-card"><span class="about-trust-index">0{index + 1}</span><span class="about-icon about-icon--large"><i data-lucide={icon}></i></span><h3 data-ar={arTitle} data-en={enTitle}>{arTitle}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></article>)}
      </div>
      <p class="about-boundary" data-ar="هذا توضيح تجاري عام وليس استشارة قانونية أو بديلًا عن اتفاقيات الموردين؛ تخضع المسائل التعاقدية للمراجعة القانونية المناسبة." data-en="This is commercial trust copy, not legal advice or a substitute for supplier agreements; contractual matters remain subject to appropriate legal review.">هذا توضيح تجاري عام وليس استشارة قانونية أو بديلًا عن اتفاقيات الموردين؛ تخضع المسائل التعاقدية للمراجعة القانونية المناسبة.</p>
    </div>
  </section>

  <section class="about-section about-final">
    <div class="container about-final__grid">
      <article class="about-profile-panel"><span class="about-icon about-icon--large"><i data-lucide="file-text"></i></span><span class="about-kicker" data-ar="معلومات الشركة" data-en="Company Information">معلومات الشركة</span><h2 data-ar="تحتاج نظرة رسمية ومختصرة عن تارقت؟" data-en="Need a formal, concise overview of TARGET?">تحتاج نظرة رسمية ومختصرة عن تارقت؟</h2><p data-ar="يحتوي الملف التعريفي على نظرة منظمة عن تارقت، طريقة عملها، المنتجات والشركات، والسوق القطري، مع نسخة PDF مخصصة للتحميل من صفحة الملف التعريفي." data-en="The Company Profile provides a structured overview of TARGET, how we work, products and companies, and the Qatar market, with the controlled PDF available from the dedicated profile page.">يحتوي الملف التعريفي على نظرة منظمة عن تارقت، طريقة عملها، المنتجات والشركات، والسوق القطري، مع نسخة PDF مخصصة للتحميل من صفحة الملف التعريفي.</p><a class="about-resource-link" href="company-profile.html"><span data-ar="عرض الملف التعريفي" data-en="View Company Profile">عرض الملف التعريفي</span><i class="about-arrow" data-lucide="arrow-left"></i></a></article>
      <article class="about-final-cta"><span class="about-kicker" data-ar="الخطوة التالية" data-en="Next Step">الخطوة التالية</span><h2 data-ar="لديك منتج غذائي وتريد مناقشة فرصته في قطر؟" data-en="Have a food product you want to discuss for Qatar?">لديك منتج غذائي وتريد مناقشة فرصته في قطر؟</h2><p data-ar="شاركنا معلومات الشركة والمنتج، وسنراجع ما إذا كانت الفرصة مناسبة لبدء نقاش تجاري." data-en="Share your company and product information, and we will review whether the opportunity is suitable for a commercial discussion.">شاركنا معلومات الشركة والمنتج، وسنراجع ما إذا كانت الفرصة مناسبة لبدء نقاش تجاري.</p><div class="about-final-actions"><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a><a class="about-secondary-link" href="capabilities.html"><span data-ar="تعرف على طريقة عملنا" data-en="See How We Work">تعرف على طريقة عملنا</span><i class="about-arrow" data-lucide="arrow-left"></i></a></div><small data-ar="إرسال الطلب لا يعني قبول المنتج أو إنشاء التزام تجاري." data-en="Submitting an enquiry does not mean product acceptance or establish a commercial commitment.">إرسال الطلب لا يعني قبول المنتج أو إنشاء التزام تجاري.</small></article>
    </div>
  </section>
</div>
