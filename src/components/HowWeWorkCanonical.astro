---
const ways = [
  ['ship','الاستيراد والتجارة','Import & Trading','نعمل على منتجات غذائية مختارة من المصنعين والموردين، ونراجع إمكانية التعامل معها ضمن نشاط تارقت في التجارة والاستيراد إلى قطر.','We work with selected food products from manufacturers and suppliers and review whether they fit TARGET\'s trading and import activity in Qatar.',['منتجات غذائية مختارة.','مراجعة كل منتج حسب فئته وفرصته.','مناقشة المنتج لا تعني التزامًا تلقائيًا بالاستيراد.'],['Selected food products.','Case-by-case review.','No automatic import commitment.']],
  ['handshake','العمل مع المصنعين والموردين','Manufacturers & Suppliers','نناقش المنتج والفرصة مباشرة مع المصنع أو العلامة أو المورد، ونحدد طريقة العمل المناسبة إذا كانت الفرصة ملائمة للطرفين.','We discuss the product and opportunity directly with the manufacturer, brand or supplier and define an appropriate commercial arrangement where the opportunity fits both sides.',['تواصل مباشر حول المنتج.','مصنعون، موردون وعلامات غذائية.','طريقة العمل تُحدد قبل التنفيذ.'],['Direct product discussion.','Manufacturers, suppliers and brands.','Arrangement agreed before execution.']],
  ['route','قنوات البيع والتوزيع','Sales & Distribution Channels','عندما تكون الفرصة مناسبة، نعمل على تحديد قنوات البيع والتوزيع الأنسب للمنتج داخل قطر بحسب طبيعة الفئة والفرصة المتاحة.','Where the opportunity is suitable, we work on identifying appropriate sales and distribution channels in Qatar based on the product category and opportunity.',['قنوات البيع تختلف حسب المنتج.','التوزيع يُبنى على طبيعة الفئة والفرصة.','لا نذكر أعداد منافذ أو تغطية غير موثقة.'],['Channel choice depends on the product.','Distribution depends on category and opportunity.','No unverified coverage claims.']],
  ['refresh-cw','متابعة فرصة المنتج في قطر','Product Opportunity in Qatar','بعد بدء التعامل، نراجع إمكانية استمرار المنتج وتوسيع وصوله عندما تكون النتائج والفرصة والسوق مناسبة لذلك، دون وعود مسبقة بالنمو أو التوسع.','After the relationship starts, we review whether the product can continue and reach further in Qatar where the opportunity and market support it, without advance growth or expansion promises.',['متابعة الفرصة بعد البداية.','التوسع عند وجود أساس تجاري مناسب.','لا وعود بنتائج أو نمو مضمون.'],['Opportunity reviewed after launch.','Expansion only where commercially supported.','No guaranteed growth.']]
];
const steps = [
  ['file-text','شاركنا تفاصيل المنتج','Share the Product','أرسل لنا معلومات واضحة عن الشركة أو العلامة والمنتج والفئة والفرصة التي تريد مناقشتها في قطر.','Send clear information about your company or brand, product, category and the opportunity you want to discuss in Qatar.'],
  ['search-check','نراجع الملاءمة','Review the Fit','نراجع المنتج والفئة ومدى ارتباط الفرصة بتوجه تارقت والسوق القطري قبل الدخول في تفاصيل تجارية أوسع.','We review the product, category and how the opportunity relates to TARGET and the Qatar market before broader commercial details.'],
  ['handshake','نتفق على طريقة العمل','Agree How to Work','إذا كانت الفرصة مناسبة، نناقش طريقة العمل ونطاقها والشروط التجارية الأساسية قبل أي تنفيذ.','If the opportunity is suitable, we discuss the arrangement, its scope and core commercial terms before any execution.'],
  ['ship','نبدأ خطوات دخول السوق','Start Market-Entry Steps','بحسب الاتفاق وطبيعة المنتج، تبدأ الخطوات المرتبطة بالتجارة والاستيراد ودخول المنتج إلى السوق.','According to the agreement and the product, steps related to trading, import and market entry begin.'],
  ['store','نعمل على البيع والتوزيع','Work on Sales & Distribution','نحدد القنوات المناسبة للمنتج ونتعامل مع فرصة البيع والتوزيع وفق الفئة والواقع التجاري في قطر.','We identify suitable channels and work on the sales and distribution opportunity according to the category and commercial reality in Qatar.'],
  ['package-check','نراجع الاستمرار','Review Continuity','بعد البداية، نراجع إمكانية استمرار المنتج أو توسيع وصوله عندما تكون الفرصة والنتائج مناسبة.','After starting, we review whether the product can continue or reach further where the opportunity and results are suitable.']
];
const audiences = [['factory','المصنعون الغذائيون','Food Manufacturers','منتجات قائمة تبحث عن فرصة مناسبة في قطر.','Established products looking for a suitable Qatar opportunity.'],['badge-check','العلامات الغذائية','Food Brands','علامات تريد مناقشة دخول منتجاتها إلى السوق.','Brands looking to discuss bringing their products to market.'],['boxes','الموردون','Suppliers','موردون لديهم منتجات أو فئات مناسبة للنقاش التجاري.','Suppliers with products or categories suitable for commercial discussion.'],['globe-2','فرق التصدير والمبيعات الدولية','Export & International Sales Teams','فرق تبحث عن طرف محلي لمناقشة منتج وفرصة داخل قطر.','Teams looking for a local party to discuss a product and opportunity in Qatar.']];
const startInfo = [['building-2','الشركة أو العلامة','Company / Brand'],['package-open','المنتج والفئة','Product / Category'],['map-pinned','السوق أو الفرصة المقترحة','Proposed Market Opportunity'],['files','المواد أو المعلومات المتاحة عن المنتج','Available Product Information / Materials']];
---
<div class="work-canonical">
  <section class="work-hero"><div class="container work-hero__grid"><div><span class="work-eyebrow"><i data-lucide="route"></i><span data-ar="كيف نعمل مع المصنعين والموردين" data-en="How We Work with Manufacturers & Suppliers">كيف نعمل مع المصنعين والموردين</span></span><h1 data-ar="نأخذ المنتج في خطوات واضحة من الفرصة إلى السوق القطري." data-en="A clear route from product opportunity to the Qatar market.">نأخذ المنتج في خطوات واضحة من الفرصة إلى السوق القطري.</h1><p data-ar="نراجع المنتج والفرصة، نتفق على طريقة العمل المناسبة، ثم نتحرك عبر الاستيراد والتجارة وقنوات البيع والتوزيع داخل قطر — بحسب ملاءمة المنتج وطبيعة الفرصة." data-en="We review the product and opportunity, agree the appropriate commercial arrangement, then move through import, trading and suitable sales and distribution channels in Qatar — according to product fit and the opportunity.">نراجع المنتج والفرصة، نتفق على طريقة العمل المناسبة، ثم نتحرك عبر الاستيراد والتجارة وقنوات البيع والتوزيع داخل قطر — بحسب ملاءمة المنتج وطبيعة الفرصة.</p><div class="work-hero__actions"><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a><a class="work-quiet-link" href="food-portfolio.html"><span data-ar="استعرض المنتجات والشركات" data-en="Explore Products & Companies">استعرض المنتجات والشركات</span><i data-lucide="arrow-left"></i></a></div></div><div class="work-hero__route" aria-hidden="true"><span><i data-lucide="package"></i></span><i data-lucide="arrow-left"></i><strong>TARGET</strong><i data-lucide="arrow-left"></i><span><i data-lucide="map-pinned"></i></span></div></div></section>

  <section class="work-section"><div class="container"><div class="work-head"><span class="work-kicker" data-ar="طريقة عملنا" data-en="How We Work">طريقة عملنا</span><h2 data-ar="أربع نقاط واضحة في التعامل مع المنتج والفرصة" data-en="Four clear parts of working with a product opportunity">أربع نقاط واضحة في التعامل مع المنتج والفرصة</h2><p data-ar="لا نتعامل مع كل المنتجات بالطريقة نفسها. نبدأ بفهم المنتج والفئة والفرصة في قطر، ثم نحدد ما إذا كان هناك مجال عملي للانتقال إلى الخطوة التالية." data-en="We do not handle every product in the same way. We start by understanding the product, category and opportunity in Qatar, then determine whether there is a practical basis to move forward.">لا نتعامل مع كل المنتجات بالطريقة نفسها. نبدأ بفهم المنتج والفئة والفرصة في قطر، ثم نحدد ما إذا كان هناك مجال عملي للانتقال إلى الخطوة التالية.</p></div><div class="work-ways">{ways.map(([icon,arTitle,enTitle,arBody,enBody,arPoints,enPoints], index)=><article class="work-way"><span class="work-number">0{index+1}</span><span class="work-icon"><i data-lucide={icon}></i></span><h3 data-ar={arTitle} data-en={enTitle}>{arTitle}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p><ul>{arPoints.map((point,i)=><li><i data-lucide="check"></i><span data-ar={point} data-en={enPoints[i]}>{point}</span></li>)}</ul></article>)}</div></div></section>

  <section class="work-section work-soft"><div class="container"><div class="work-head"><span class="work-kicker" data-ar="من أين نبدأ؟" data-en="Where Do We Start?">من أين نبدأ؟</span><h2 data-ar="خطوات واضحة من أول مناقشة إلى العمل في السوق" data-en="Clear steps from the first discussion to market activity">خطوات واضحة من أول مناقشة إلى العمل في السوق</h2><p data-ar="الهدف من هذه الخطوات هو أن يعرف المورد أو المصنع ماذا يحدث بعد التواصل، وما الذي يحتاج إلى اتفاق قبل الانتقال من مرحلة إلى أخرى." data-en="These steps show the supplier or manufacturer what happens after contact and what needs to be agreed before moving from one stage to the next.">الهدف من هذه الخطوات هو أن يعرف المورد أو المصنع ماذا يحدث بعد التواصل، وما الذي يحتاج إلى اتفاق قبل الانتقال من مرحلة إلى أخرى.</p></div><ol class="work-steps">{steps.map(([icon,arTitle,enTitle,arBody,enBody],index)=><li><span class="work-step-num">0{index+1}</span><span class="work-icon"><i data-lucide={icon}></i></span><div><h3 data-ar={arTitle} data-en={enTitle}>{arTitle}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></div></li>)}</ol></div></section>

  <section class="work-section"><div class="container"><div class="work-head"><span class="work-kicker" data-ar="لمن نعمل" data-en="Who We Work With">لمن نعمل</span><h2 data-ar="هذه الصفحة موجهة لمن لديه منتج غذائي وفرصة يريد مناقشتها في قطر" data-en="For businesses with a food product and a Qatar opportunity to discuss">هذه الصفحة موجهة لمن لديه منتج غذائي وفرصة يريد مناقشتها في قطر</h2></div><div class="work-audiences">{audiences.map(([icon,arTitle,enTitle,arBody,enBody])=><article><span class="work-icon"><i data-lucide={icon}></i></span><h3 data-ar={arTitle} data-en={enTitle}>{arTitle}</h3><p data-ar={arBody} data-en={enBody}>{arBody}</p></article>)}</div></div></section>

  <section class="work-section work-soft"><div class="container work-info-layout"><div class="work-head"><span class="work-kicker" data-ar="في البداية" data-en="At the Start">في البداية</span><h2 data-ar="كلما كانت معلومات المنتج أوضح، كانت مراجعة الفرصة أسهل" data-en="Clearer product information makes the opportunity easier to review">كلما كانت معلومات المنتج أوضح، كانت مراجعة الفرصة أسهل</h2><p data-ar="في البداية نحتاج صورة واضحة عن الشركة أو العلامة والمنتج والفئة والفرصة المقترحة. التفاصيل التجارية الأوسع تُناقش إذا كان هناك أساس مناسب للاستمرار." data-en="At the start, we need a clear view of the company or brand, the product, category and proposed opportunity. Broader commercial details are discussed where there is a suitable basis to continue.">في البداية نحتاج صورة واضحة عن الشركة أو العلامة والمنتج والفئة والفرصة المقترحة. التفاصيل التجارية الأوسع تُناقش إذا كان هناك أساس مناسب للاستمرار.</p></div><ul class="work-info-cues">{startInfo.map(([icon,ar,en])=><li><span class="work-icon"><i data-lucide={icon}></i></span><span data-ar={ar} data-en={en}>{ar}</span></li>)}</ul></div></section>

  <section class="work-section work-clarity"><div class="container"><div class="work-clarity__panel"><span class="work-icon"><i data-lucide="file-check-2"></i></span><div><span class="work-kicker" data-ar="وضوح التعامل" data-en="Commercial Clarity">وضوح التعامل</span><h2 data-ar="المناقشة تبدأ بفرصة — والالتزام يبدأ باتفاق" data-en="A discussion starts with an opportunity; commitment starts with an agreement">المناقشة تبدأ بفرصة — والالتزام يبدأ باتفاق</h2><p data-ar="إرسال المنتج أو بدء النقاش لا يعني قبول المنتج أو الالتزام باستيراده أو توزيعه. الأسعار والكميات ونطاق العمل وأي تمثيل أو وكالة أو حصرية لا تُعتمد إلا إذا تم الاتفاق عليها وتوثيقها بوضوح." data-en="Submitting a product or starting a discussion does not mean product acceptance or a commitment to import or distribute it. Pricing, quantities, scope, representation, agency or exclusivity apply only where explicitly agreed and documented.">إرسال المنتج أو بدء النقاش لا يعني قبول المنتج أو الالتزام باستيراده أو توزيعه. الأسعار والكميات ونطاق العمل وأي تمثيل أو وكالة أو حصرية لا تُعتمد إلا إذا تم الاتفاق عليها وتوثيقها بوضوح.</p></div></div></div></section>

  <section class="work-final"><div class="container"><span class="work-kicker" data-ar="لديك منتج مناسب؟" data-en="Have a Relevant Product?">لديك منتج مناسب؟</span><h2 data-ar="شاركنا المنتج والفرصة التي تريد مناقشتها في قطر" data-en="Tell us about the product and opportunity you want to discuss in Qatar">شاركنا المنتج والفرصة التي تريد مناقشتها في قطر</h2><p data-ar="أرسل لنا نبذة عن شركتك أو علامتك والمنتج، وسنراجع ما إذا كانت الفرصة مناسبة لبدء نقاش تجاري مباشر." data-en="Tell us about your company or brand and the product, and we will review whether the opportunity is suitable for a direct commercial discussion.">أرسل لنا نبذة عن شركتك أو علامتك والمنتج، وسنراجع ما إذا كانت الفرصة مناسبة لبدء نقاش تجاري مباشر.</p><div class="work-final__actions"><a class="btn-premium btn-light-premium" href="suppliers.html"><i data-lucide="send"></i><span data-ar="ناقش منتجك معنا" data-en="Discuss Your Product">ناقش منتجك معنا</span></a><a class="work-quiet-link" href="qatar-market.html"><span data-ar="استعرض السوق القطري" data-en="Explore Qatar Market">استعرض السوق القطري</span><i data-lucide="arrow-left"></i></a></div><small data-ar="إرسال الاستفسار لا يعني قبول المنتج أو إنشاء التزام تجاري." data-en="Submitting an enquiry does not constitute product acceptance or establish a commercial commitment.">إرسال الاستفسار لا يعني قبول المنتج أو إنشاء التزام تجاري.</small></div></section>
</div>
